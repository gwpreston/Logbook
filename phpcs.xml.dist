<?xml version="1.0"?>
<ruleset name="Logbook">
    <description>PSR-12 for Logbook.</description>

    <arg name="basepath" value="."/>
    <arg name="cache" value=".phpcs-cache"/>
    <arg name="colors"/>
    <arg name="extensions" value="php"/>
    <arg value="sp"/>

    <file>bin</file>
    <file>config</file>
    <file>db</file>
    <file>public</file>
    <file>src</file>
    <file>tests</file>
    <file>phinx.php</file>
    <file>translations</file>

    <rule ref="PSR12"/>

    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="130"/>
            <property name="absoluteLineLimit" value="160"/>
        </properties>
        <exclude-pattern>translations/*</exclude-pattern>
    </rule>

    <!-- Phinx migrations are loaded by file name and are not namespaced. -->
    <rule ref="PSR1.Classes.ClassDeclaration.MissingNamespace">
        <exclude-pattern>db/migrations/*</exclude-pattern>
        <exclude-pattern>db/seeds/*</exclude-pattern>
    </rule>

    <!-- CLI scripts and config files return values / declare closures at top level. -->
    <rule ref="PSR1.Files.SideEffects.FoundWithSymbols">
        <exclude-pattern>bin/*</exclude-pattern>
        <exclude-pattern>config/*</exclude-pattern>
    </rule>
</ruleset>
