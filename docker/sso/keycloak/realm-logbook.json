{
  "realm": "logbook",
  "enabled": true,
  "sslRequired": "none",
  "groups": [
    { "name": "logbook" },
    { "name": "logbook-admins" }
  ],
  "users": [
    {
      "username": "pat",
      "enabled": true,
      "email": "pat@example.test",
      "emailVerified": true,
      "firstName": "Pat",
      "lastName": "Owner",
      "credentials": [{ "type": "password", "value": "pat-password", "temporary": false }],
      "groups": ["/logbook", "/logbook-admins"]
    },
    {
      "username": "sam",
      "enabled": true,
      "email": "sam@example.test",
      "emailVerified": true,
      "firstName": "Sam",
      "lastName": "Partner",
      "credentials": [{ "type": "password", "value": "sam-password", "temporary": false }],
      "groups": ["/logbook"]
    }
  ],
  "clients": [
    {
      "clientId": "logbook",
      "name": "Logbook",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "logbook-test-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8090/auth/oidc/callback",
        "http://localhost:8090/logbook/auth/oidc/callback"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8090/login##http://localhost:8090/logbook/login"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
