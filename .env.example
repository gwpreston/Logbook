# Logbook configuration. Copy to `.env` (git-ignored) and adjust.
# Real environment variables always override values in `.env`.
# Every variable is optional: the defaults below are what you get when unset.
# Reference: spec.md §9.

# --- Application -------------------------------------------------------------
# production | development | testing
APP_ENV=production
# Show detailed error pages. Never enable on a public server. Default: on in development only.
APP_DEBUG=false
# Public URL of the app (used for absolute links, e.g. in emails / iCal feeds). No trailing slash.
APP_URL=http://localhost:8080
# Subpath when served behind a reverse proxy, e.g. /logbook. Empty = served at the domain root.
# Works whether the proxy forwards the prefix or strips it.
APP_BASE_PATH=
# Default display time zone (IANA identifier). Data is always stored in UTC.
APP_TIMEZONE=UTC
# Default locale when the browser's Accept-Language has no match. English is the fallback.
APP_LOCALE=en
# Default currency (ISO 4217 code) offered on first-run setup and used on signed-out pages.
# Each user then picks their own, and each vehicle can override it.
APP_CURRENCY=GBP

# --- Database ----------------------------------------------------------------
# pgsql | mysql (also MariaDB) | sqlite. Default when unset: sqlite (var/logbook.sqlite).
DB_DRIVER=pgsql
DB_HOST=127.0.0.1
# Default: 5432 for pgsql, 3306 for mysql.
DB_PORT=5432
# Database name. For sqlite: path to the database file (relative paths are relative to the project root).
DB_NAME=logbook
DB_USER=logbook
DB_PASSWORD=change-me

# --- Sessions ------------------------------------------------------------------
# Optional key for hashing session ids at rest. Changing it signs everyone out.
# Generate one with e.g. `php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'`
SESSION_SECRET=
# Send the session cookie only over HTTPS. Default: true when APP_URL starts with https://
SESSION_SECURE=

# --- Uploads (vehicle photos; receipts and certificates from Phase 3) -----------
# Directory for photos / receipts / certificates. Must be OUTSIDE public/. Docker: /data/uploads
UPLOAD_PATH=var/uploads
# Largest accepted upload, in megabytes. PHP's upload_max_filesize / post_max_size must allow it.
MAX_UPLOAD_MB=10

# --- Logging -----------------------------------------------------------------
# php://stderr (default; Docker logs) or a file path such as var/log/app.log
LOG_PATH=php://stderr
# debug | info | notice | warning | error | critical | alert | emergency. Default: info (debug in development)
LOG_LEVEL=info

# --- Docker entrypoint only ----------------------------------------------------
# Apply pending migrations when the container starts.
MIGRATE_ON_START=true
# Seconds to wait for the database before giving up.
DB_WAIT_TIMEOUT=60

# --- Notifications (used from Phase 4) -------------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# tls | ssl | none
MAIL_ENCRYPTION=tls
MAIL_FROM=logbook@example.com
# ntfy topic URL, e.g. https://ntfy.sh/my-garage (optional token for protected topics)
NTFY_URL=
NTFY_TOKEN=
# Generic webhook receiving JSON reminder payloads
WEBHOOK_URL=

# --- Feature toggle defaults (used from Phase 6) ---------------------------------
# FEATURES_FUEL=true
# FEATURES_MAINTENANCE=true
# FEATURES_COMPLIANCE=true
# FEATURES_REMINDERS=true
# FEATURES_REPORTS=true

# --- Test suite only -------------------------------------------------------------
# PHPUnit never touches DB_*; it uses TEST_DB_* (default: SQLite at var/testing.sqlite).
# TEST_DB_DRIVER=pgsql
# TEST_DB_HOST=127.0.0.1
# TEST_DB_PORT=5432
# TEST_DB_NAME=logbook_test
# TEST_DB_USER=logbook
# TEST_DB_PASSWORD=change-me
