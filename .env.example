# Logbook configuration. Copy to `.env` (git-ignored) and adjust.
# Real environment variables always override values in `.env`.
# Every variable is optional: the defaults below are what you get when unset.
# Reference: spec.md §9.

# --- Application -------------------------------------------------------------
# production | development | testing
APP_ENV=production
# Show detailed error pages. Never enable on a public server. Default: on in development only.
APP_DEBUG=false
# Public URL of the app (used for absolute links, e.g. in emails / iCal feeds). No trailing slash.
APP_URL=http://localhost:8080
# Subpath when served behind a reverse proxy, e.g. /logbook. Empty = served at the domain root.
# Works whether the proxy forwards the prefix or strips it.
APP_BASE_PATH=
# Default display time zone (IANA identifier). Data is always stored in UTC.
APP_TIMEZONE=UTC
# Default locale when the browser's Accept-Language has no match. English is the fallback.
APP_LOCALE=en
# Default currency (ISO 4217 code) offered on first-run setup and used on signed-out pages.
# Each user then picks their own, and each vehicle can override it.
APP_CURRENCY=GBP

# --- Database ----------------------------------------------------------------
# pgsql | mysql (also MariaDB) | sqlite. Default when unset: sqlite (var/logbook.sqlite).
DB_DRIVER=pgsql
DB_HOST=127.0.0.1
# Default: 5432 for pgsql, 3306 for mysql.
DB_PORT=5432
# Database name. For sqlite: path to the database file (relative paths are relative to the project root).
DB_NAME=logbook
DB_USER=logbook
DB_PASSWORD=change-me

# --- Sessions ------------------------------------------------------------------
# Optional key for hashing session ids, calendar feed links, API keys and
# invitation links at rest. Changing it signs everyone out, disables calendar
# feed links, open invitation and reset links, and every API key (create new
# ones in Settings -> API keys).
# Generate one with e.g. `php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'`
SESSION_SECRET=
# Send the session cookie only over HTTPS. Default: true when APP_URL starts with https://
SESSION_SECURE=

# --- Single sign-on with OpenID Connect (docs/sso.md) ---------------------------
# Sign in with Authelia, Authentik, Keycloak or another OIDC provider. Setting
# OIDC_ISSUER switches it on; the client id and secret are then required.
# Register this redirect URI at the provider: {APP_URL}{APP_BASE_PATH}/auth/oidc/callback
# (Settings -> Users shows it with a copy button).
# The issuer exactly as the provider states it, trailing slash and all.
# OIDC_ISSUER=https://auth.example.com/application/o/logbook/
# OIDC_CLIENT_ID=logbook
# OIDC_CLIENT_SECRET=
# Button text: "Sign in with {name}". Default: SSO
# OIDC_PROVIDER_NAME=Authentik
# Default: openid profile email (must include openid; add groups for Authelia's groups claim)
# OIDC_SCOPES=openid profile email
# Claim holding the username, and the claim holding the groups.
# OIDC_USERNAME_CLAIM=preferred_username
# OIDC_GROUPS_CLAIM=groups
# How an account not linked yet finds its Logbook user:
#   explicit  only by the user linking it in Settings -> Account (default, safest)
#   username  also by an equal username. Only if usernames at the provider are set by admins alone.
# OIDC_LINK=explicit
# Create a member on first sign-in for an account no user has. Default: false
# OIDC_AUTO_CREATE=false
# Comma-separated groups: only members of these may sign in with SSO. Default: everyone
# OIDC_ALLOWED_GROUPS=
# Comma-separated groups whose members are admins, set at every SSO sign-in
# (the last admin is never demoted). Default: none (admin is set in the app)
# OIDC_ADMIN_GROUPS=
# Also sign out at the provider. Register {APP_URL}{APP_BASE_PATH}/login as the
# post-logout redirect URI. Default: false
# OIDC_LOGOUT=false
# Password sign-in. false leaves only SSO; php bin/auth.php login-link <username>
# still gets you in when the provider is down. Default: true
# AUTH_LOCAL_LOGIN=true

# --- Header sign-in behind a forward-auth proxy (docs/sso.md#header-sign-in) ----
# Trust the user Authelia or an Authentik outpost passes on. ONLY safe when the
# app is reachable through the proxy alone and the proxy sets the header on every
# request. Off unless a header is set; the app won't start with a header and no
# trusted proxies.
# The username header (letters, digits, dashes), e.g. Remote-User or X-authentik-username.
# AUTH_PROXY_HEADER=Remote-User
# Comma-separated addresses / CIDR ranges the proxy connects from. Required with
# AUTH_PROXY_HEADER. Never X-Forwarded-For: only the connecting address counts.
# AUTH_PROXY_TRUSTED=172.29.71.10
# Optional: name and email for users it creates, and groups (separated by , or |).
# AUTH_PROXY_NAME_HEADER=Remote-Name
# AUTH_PROXY_EMAIL_HEADER=Remote-Email
# AUTH_PROXY_GROUPS_HEADER=Remote-Groups
# Or, instead of AUTH_PROXY_HEADER: Authentik's signed X-authentik-jwt (HS256 with
# the proxy provider's client secret). AUTH_PROXY_TRUSTED is then optional.
# AUTH_PROXY_JWT_HEADER=X-authentik-jwt
# AUTH_PROXY_JWT_SECRET=
# AUTH_PROXY_JWT_ISSUER=https://authentik.example.com/application/o/logbook/
# AUTH_PROXY_JWT_AUDIENCE=
# How a proxy account finds its user:
#   username  the user with the same username (default)
#   identity  only once that user links it from the banner while signed in
# AUTH_PROXY_LINK=username
# Create a member for a proxy account no user has. Default: false
# AUTH_PROXY_AUTO_CREATE=false
# Comma-separated groups allowed in, and groups whose members are admins.
# AUTH_PROXY_ALLOWED_GROUPS=
# AUTH_PROXY_ADMIN_GROUPS=
# Where Sign out goes for a session from the header, e.g. Authelia's logout page.
# AUTH_PROXY_LOGOUT_URL=https://auth.example.com/logout

# --- REST API (docs/api.md) -----------------------------------------------------
# The JSON API under /api/v1 for Home Assistant, Shortcuts, Grafana and scripts.
# It needs an API key (Settings -> API keys) for everything but its description.
# false makes every /api/v1 address a 404. Default: true
API_ENABLED=true
# Browser dashboards on other origins that may call the API (CORS), comma-separated,
# e.g. https://ha.example.com:8123. Default: none (CORS off; servers need no CORS).
API_CORS_ORIGINS=

# --- MCP server (docs/mcp.md) ---------------------------------------------------
# Claude Desktop and other MCP clients use Logbook's tools at /mcp with an API
# key, and their own model (no Settings -> AI connection is needed). Browser
# clients' origins go in API_CORS_ORIGINS. false, or API_ENABLED=false, makes
# /mcp a 404. Default: true
MCP_ENABLED=true

# --- AI (docs/ai.md) ------------------------------------------------------------
# Connections to models (on this server, your network or the internet), their
# keys and which model does which job are set by an admin on Settings -> AI.
# Nothing is sent to any model until then.
# false removes Settings -> AI and every AI feature, and sends nothing. Default: true
AI_ENABLED=true
# true keeps questions and answers in the usage log (debugging only). Default: false
AI_LOG_CONTENT=false
# false forbids switching off TLS verification on a connection. Default: true
AI_ALLOW_INSECURE_TLS=true
# Keys typed as env:NAME on Settings -> AI are read from that variable, e.g.:
# OPENAI_API_KEY=
# Ghostscript, to read scanned PDFs: a name on PATH or a full path; off turns
# it off (Imagick is used if loaded). The Docker image includes it. Default: gs
GHOSTSCRIPT_BINARY=gs

# --- Uploads (vehicle photos; receipts, invoices and certificates) -------------
# Directory for photos and attachments. Must be OUTSIDE public/. Docker: /data/uploads
UPLOAD_PATH=var/uploads
# Largest accepted upload (photo or attachment), in megabytes.
# PHP's upload_max_filesize / post_max_size must allow it.
MAX_UPLOAD_MB=10

# --- Backups (Settings -> Backup and restore; bin/backup.php) ------------------
# Where safety backups (made before every restore) and `bin/backup.php create`
# write. Keep it OUTSIDE public/. Docker: /data/backups
BACKUP_PATH=var/backups
# Largest backup the restore form accepts, in megabytes (bigger ones: bin/backup.php).
# PHP's upload_max_filesize / post_max_size must allow it.
MAX_RESTORE_MB=256

# --- Logging -----------------------------------------------------------------
# php://stderr (default; Docker logs) or a file path such as var/log/app.log
LOG_PATH=php://stderr
# debug | info | notice | warning | error | critical | alert | emergency. Default: info (debug in development)
LOG_LEVEL=info

# --- Background jobs (Settings → Jobs) -----------------------------------------
# Seconds between scheduler passes: the Docker loop's spacing and, on every
# install, how often Logbook expects cron (or another trigger) to run it. With
# none for twice this long, Settings → Jobs and the dashboard warn admins.
# Minimum 60. Default: 900 (15 minutes).
SCHEDULER_INTERVAL=900
# Seconds a "Run now" from Settings → Jobs may take. Default: 300.
JOB_TIME_LIMIT=300

# --- Update check (Settings → Updates) -----------------------------------------
# Off until an admin switches it on. Once a day it asks api.github.com for the
# latest release of this repository; nothing about your data is sent. Forks set
# their own. Default: gwpreston16/Logbook.
UPDATE_CHECK_REPO=gwpreston16/Logbook
# false removes the update check entirely (the setting, the setup checkbox and
# the job), for installs that must never call out. Default: true.
UPDATE_CHECK_ALLOWED=true

# --- Fuel prices (Phase 30.2, spec §7.34) ----------------------------------------
# Live prices are off until an admin enables a provider on Settings → Fuel
# prices (UK Fuel Finder needs a client ID and secret from its developer
# portal; type them there, or env:NAME to read them from a variable here).
# Days of listed price changes kept for stations someone has used or
# favourited (at least 30). Default: 1095 (three years).
PRICE_HISTORY_DAYS=1095

# --- Docker entrypoint only ----------------------------------------------------
# Apply pending migrations when the container starts.
MIGRATE_ON_START=true
# Seconds to wait for the database before giving up.
DB_WAIT_TIMEOUT=60
# Run scheduler passes (reminders, the digest, cleanup, scheduled backups)
# inside the container, every SCHEDULER_INTERVAL seconds. Set to false if you
# run bin/run-scheduled-tasks.php some other way.
SCHEDULER_ENABLED=true

# --- Notifications -------------------------------------------------------------
# Reminders always show in the app. Each channel below is used once its
# variables are set; each owner then picks which ones to use (Settings → Reminders).
# Test from Settings → Reminders → "Send a test". See docs/notification-channels.md.

# Email (SMTP). Configured when MAIL_HOST is set.
MAIL_HOST=
# Default: 587
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# tls (STARTTLS, required) | ssl (implicit TLS, usually port 465) | none. Default: tls
MAIL_ENCRYPTION=tls
# Sender: an address, or "Name <address>". Default: logbook@localhost
MAIL_FROM=logbook@example.com
# The admins' default recipient; each user sets their own address in Settings →
# Reminders (members get no email without one).
MAIL_TO=

# ntfy (https://ntfy.sh or self-hosted): the topic URL, e.g. https://ntfy.sh/my-garage.
# It receives the admins' reminders; each user can set a topic of their own.
NTFY_URL=
# Access token for a protected topic (optional).
NTFY_TOKEN=

# Gotify (https://gotify.net): the server URL and an application token (the
# admins'; each user can set a token of their own on this server).
GOTIFY_URL=
GOTIFY_TOKEN=
# Message priority 0-10. Default: 5 (overdue reminders are sent at 8 or more).
GOTIFY_PRIORITY=5

# Generic webhook: receives each notification as a JSON POST (Home Assistant, n8n, …).
WEBHOOK_URL=

# --- Feature toggle defaults -------------------------------------------------------
# Modules are on unless switched off here. Settings -> Modules in the app saves
# a choice that wins over these. A switched-off module disappears everywhere
# (menus, pages, dashboard, reports, reminders); its data is kept.
# FEATURES_FUEL=true
# FEATURES_MAINTENANCE=true
# FEATURES_COMPLIANCE=true
# FEATURES_REMINDERS=true
# FEATURES_REPORTS=true
# FEATURES_TYRES=true
# FEATURES_INCIDENTS=true
# FEATURES_FINANCE=true
# Fuel stations (Phase 30.1): part of fuel, so off whenever fuel is off.
# FEATURES_STATIONS=true
# Trips and mileage claims (Phase 22) are the one module that is off unless
# switched on, here or in Settings -> Modules.
# FEATURES_TRIPS=false
# The AI features (docs/ai.md): on, but they do nothing until an admin sets up
# AI, and Settings -> Modules lists them only then.
# FEATURES_AI_ASK=true
# FEATURES_AI_ACTIONS=true
# FEATURES_AI_SCAN=true

# --- Test suite only -------------------------------------------------------------
# PHPUnit never touches DB_*; it uses TEST_DB_* (default: SQLite at var/testing.sqlite).
# TEST_DB_DRIVER=pgsql
# TEST_DB_HOST=127.0.0.1
# TEST_DB_PORT=5432
# TEST_DB_NAME=logbook_test
# TEST_DB_USER=logbook
# TEST_DB_PASSWORD=change-me
