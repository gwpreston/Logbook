#!/bin/sh
# Logbook local development helper: runs the Docker dev stack
# (docker-compose.dev.yml: source bind-mounted, changes apply on reload).
#
#   bin/dev up [engine]          start (engine: pgsql | mysql | mariadb | sqlite)
#   bin/dev down [--volumes]     stop; --volumes also deletes all dev data
#   bin/dev db <engine>          switch database engine (each keeps its own data)
#   bin/dev seed                 add sample data (sign in as demo / logbook-demo)
#   bin/dev reset [--seed] [-y]  empty the current database and its uploads
#   bin/dev status               engine, URL and containers
#   bin/dev logs                 follow the app log
#
# The engine and port are remembered in var/dev.env. Change the port with
# APP_PORT, e.g. `APP_PORT=8081 bin/dev up`. On Windows run it from Git Bash
# (or `sh bin/dev …`).
set -eu

cd "$(dirname "$0")/.."

# Git Bash on Windows rewrites values that look like POSIX paths ("/data/…")
# into Windows paths before handing them to docker.exe; keep ours intact.
export MSYS2_ENV_CONV_EXCL="DEV_${MSYS2_ENV_CONV_EXCL:+;$MSYS2_ENV_CONV_EXCL}"
export MSYS_NO_PATHCONV=1

compose="docker compose -f docker-compose.dev.yml"
state="var/dev.env"
engines="pgsql mysql mariadb sqlite"

# --- Remembered settings ----------------------------------------------------
port_override="${APP_PORT:-}"
DEV_ENGINE=pgsql
APP_PORT=8080
if [ -f "$state" ]; then
    # shellcheck disable=SC1090
    . "./$state"
fi
[ -n "$port_override" ] && APP_PORT="$port_override"
export APP_PORT

save_state() {
    mkdir -p var
    printf 'DEV_ENGINE=%s\nAPP_PORT=%s\n' "$DEV_ENGINE" "$APP_PORT" > "$state"
}

# Export the compose variables for engine $1; sets $db_service ('' for SQLite).
configure() {
    case "$1" in
        pgsql)   DEV_DB_DRIVER=pgsql;  DEV_DB_HOST=pgsql;   DEV_DB_NAME=logbook; db_service=pgsql ;;
        mysql)   DEV_DB_DRIVER=mysql;  DEV_DB_HOST=mysql;   DEV_DB_NAME=logbook; db_service=mysql ;;
        mariadb) DEV_DB_DRIVER=mysql;  DEV_DB_HOST=mariadb; DEV_DB_NAME=logbook; db_service=mariadb ;;
        sqlite)  DEV_DB_DRIVER=sqlite; DEV_DB_HOST=none;    DEV_DB_NAME=/data/logbook.sqlite; db_service= ;;
        *) echo "Unknown engine '$1'. Use one of: $engines" >&2; exit 2 ;;
    esac
    DEV_ENGINE="$1"
    DEV_UPLOAD_PATH="/data/uploads/$1"
    export DEV_DB_DRIVER DEV_DB_HOST DEV_DB_NAME DEV_UPLOAD_PATH
}

url() {
    echo "http://localhost:$APP_PORT"
}

require_running() {
    if [ -z "$($compose ps -q --status running app 2>/dev/null)" ]; then
        echo "The dev stack is not running. Start it with: bin/dev up" >&2
        exit 1
    fi
}

# Apache starts only after the entrypoint has migrated the database, so a
# healthy /health means the app is ready to use.
wait_for_app() {
    printf 'Waiting for the app'
    i=0
    until curl -fsS "$(url)/health" > /dev/null 2>&1; do
        i=$((i + 1))
        if [ "$i" -ge 90 ]; then
            echo
            echo "The app did not become ready; see: bin/dev logs" >&2
            exit 1
        fi
        printf '.'
        sleep 2
    done
    echo
}

up() {
    configure "${1:-$DEV_ENGINE}"
    save_state

    if [ -n "$db_service" ]; then
        $compose up -d --wait "$db_service"
    fi
    # Other engines are not needed; stop them (their data is kept).
    for service in pgsql mysql mariadb; do
        if [ "$service" != "$db_service" ] && [ -n "$($compose ps -q --status running "$service" 2>/dev/null)" ]; then
            $compose stop "$service"
        fi
    done
    
    # Recreates the app container when the engine changed; --build picks up
    # Dockerfile changes (e.g. new PHP extensions) and is cached otherwise.
    $compose up -d --build app
    wait_for_app

    echo "Logbook is running at $(url) (database: $DEV_ENGINE)"
}

seed() {
    require_running
    $compose exec -T app vendor/bin/phinx seed:run -e development -s DemoDataSeeder
}

reset() {
    with_seed=false
    confirmed=false
    for arg in "$@"; do
        case "$arg" in
            --seed) with_seed=true ;;
            -y|--yes) confirmed=true ;;
            *) echo "Unknown option for reset: $arg" >&2; exit 2 ;;
        esac
    done

    configure "$DEV_ENGINE"
    require_running
    if [ "$confirmed" = false ]; then
        printf 'Delete ALL data in the %s dev database and its uploads? [y/N] ' "$DEV_ENGINE"
        read -r answer
        case "$answer" in y|Y|yes|YES) ;; *) echo "Cancelled."; exit 0 ;; esac
    fi

    $compose exec -T app sh -c "
        vendor/bin/phinx rollback -e development -t 0 -q &&
        vendor/bin/phinx migrate -e development -q &&
        rm -rf '$DEV_UPLOAD_PATH'"
    echo "The $DEV_ENGINE database is empty; the app will ask you to create an account."

    if [ "$with_seed" = true ]; then
        seed
    fi
}

command="${1:-help}"
[ $# -gt 0 ] && shift

case "$command" in
    up|start)
        up "$@"
        ;;
    db|switch)
        [ $# -eq 1 ] || { echo "Usage: bin/dev db <$(echo "$engines" | tr ' ' '|')>" >&2; exit 2; }
        up "$1"
        ;;
    down|stop)
        if [ "${1:-}" = "--volumes" ]; then
            $compose --profile all down --volumes
            rm -f "$state"
            echo "Stopped; all dev data (databases, uploads, vendor/) deleted."
        else
            $compose --profile all down
            echo "Stopped. Data is kept; start again with: bin/dev up"
        fi
        ;;
    seed)
        seed
        ;;
    reset)
        reset "$@"
        ;;
    status)
        echo "Database: $DEV_ENGINE"
        echo "URL:      $(url)"
        $compose --profile all ps
        ;;
    logs)
        $compose logs -f app
        ;;
    help|-h|--help)
        sed -n '2,15p' "$0" | sed 's/^# \{0,1\}//'
        ;;
    *)
        echo "Unknown command '$command'. See: bin/dev help" >&2
        exit 2
        ;;
esac
