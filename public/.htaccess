# Logbook — Apache front-controller rules for bare-PHP installs.
# (The Docker image puts the same rules in its vhost and ignores this file.)
# Works at the domain root or in a subdirectory; set APP_BASE_PATH to match.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # API keys arrive as "Authorization: Bearer …" (spec.md §7.20). mod_php
    # passes the header on; PHP-FPM needs it handed over explicitly.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>
