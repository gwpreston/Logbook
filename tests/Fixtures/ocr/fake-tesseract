#!/bin/sh
# A stand-in for Tesseract in the OCR tests (Phase 53.1): no real OCR.
# FAKE_TESSERACT_MODE: ok (default) | sleep | fail | empty
# FAKE_TESSERACT_ARGS: a file each argument is written to, one per line.
if [ -n "$FAKE_TESSERACT_ARGS" ]; then
    : > "$FAKE_TESSERACT_ARGS"
    for arg in "$@"; do printf '%s\n' "$arg" >> "$FAKE_TESSERACT_ARGS"; done
    printf 'OMP_THREAD_LIMIT=%s\n' "$OMP_THREAD_LIMIT" >> "$FAKE_TESSERACT_ARGS"
fi
case "$1" in
    --version) printf 'tesseract 5.3.0\n leptonica-1.82.0\n'; exit 0 ;;
    --list-langs) printf 'List of available languages in "/usr/share/tesseract-ocr/5/tessdata/" (3):\ndeu\neng\nosd\n'; exit 0 ;;
esac
case "${FAKE_TESSERACT_MODE:-ok}" in
    sleep) sleep 5; exit 0 ;;
    fail) echo "Error in pixReadStream" >&2; exit 1 ;;
    empty) exit 0 ;;
esac
cp "$(dirname "$0")/receipt.tsv" "$2.tsv"
