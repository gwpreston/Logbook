{% extends 'layout.twig' %}
{% import 'macros/vehicles.twig' as vehicle_ui %}

{# Which vehicle? One tap to the chosen kind's form (spec.md §7.3). #}
{% set active_nav = 'log' %}
{% set heading = ('log.pick_title.' ~ kind.value)|trans %}

{% block title %}{{ heading }} · {{ parent() }}{% endblock %}

{% block content %}
    <div class="page__stack page__stack--narrow">
        <header class="page-header">
            <div>
                <h1 class="page-header__title">{{ heading }}</h1>
                <p class="page-header__lead">{{ 'log.pick_lead'|trans }}</p>
            </div>
        </header>
        {% block modal_body %}
            {# Trips are kept for offline use, like fill-ups (spec.md §7.15, §7.22). #}
            {{ vehicle_ui.pick_list(vehicles, kind.createRoute(), kind.value == 'trip', kind.createParams()) }}
        {% endblock %}
    </div>
{% endblock %}
