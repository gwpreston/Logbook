{% extends 'layout.twig' %}
{% import 'macros/ui.twig' as ui %}

{#
 # "Log something" (spec.md §7.3). Fill-up goes through /fuel/new (kept for
 # offline use); the rest ask for the vehicle when there are several.
 #}
{% set active_nav = 'log' %}
{% set heading = 'log.title'|trans %}

{% block title %}{{ heading }} · {{ parent() }}{% endblock %}

{% block content %}
    <div class="page__stack page__stack--narrow">
        <header class="page-header">
            <div>
                <h1 class="page-header__title">{{ heading }}</h1>
                <p class="page-header__lead">{{ 'log.lead'|trans }}</p>
            </div>
        </header>
        {% block modal_body %}
            <ul class="log-choices">
                {% for kind in kinds %}
                    <li>
                        <a class="log-choice" data-modal
                           href="{{ kind.value == 'fuel' ? url_for('fuel.quick') : url_for('log.pick', {kind: kind.value}) }}">
                            <span class="log-choice__icon" style="--tone: var(--{{ kind.tone() }})">{{ ui.icon(kind.icon()) }}</span>
                            <span class="log-choice__label">{{ ('log.kind.' ~ kind.value)|trans }}</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endblock %}
    </div>
{% endblock %}
