{% extends 'layout.twig' %}
{% import 'macros/ui.twig' as ui %}

{#
 # *Mark fixed* (spec.md §7.37 *Fixing from the issue*), in this order:
 # *Log the repair* (the service form, prefilled, with the issue ticked
 # under *Fixes*), *Link an existing record*, and *Fixed without a record*.
 # Plain links and forms, so it works without JS.
 #}
{% set active_nav = 'garage' %}
{% set heading = 'issue.mark_fixed'|trans %}

{% block title %}{{ heading }} · {{ issue.data.title }} · {{ parent() }}{% endblock %}

{% block content %}
    <div class="page__stack page__stack--narrow">
        <a class="back-link" href="{{ url_for('issues.show', {id: vehicle.id, issue: issue.id}) }}">{{ ui.icon('chevron_left') }}{{ issue.data.title }}</a>
        <header class="page-header">
            <div>
                <p class="page-header__eyebrow">{{ vehicle.name() }} · {{ issue.data.title }}</p>
                <h1 class="page-header__title">{{ heading }}</h1>
            </div>
        </header>

        {% block modal_body %}
        {% if errors is not empty %}
            <div class="alert alert--error" role="alert">{{ ui.icon('error') }}<span>{{ 'form.has_errors'|trans }}</span></div>
        {% endif %}

        {% if maintenance %}
            <section class="card" aria-labelledby="fix-log">
                <h2 id="fix-log" class="card__title">{{ 'issue.fix.log_title'|trans }}</h2>
                <p class="muted">{{ 'issue.fix.log_body'|trans }}</p>
                <a class="btn btn--primary" href="{{ url_for('maintenance.create', {id: vehicle.id}, {fixes: issue.id}) }}">{{ ui.icon('build') }}{{ 'issue.log_repair'|trans }}</a>
            </section>

            <section class="card" aria-labelledby="fix-link">
                <h2 id="fix-link" class="card__title">{{ 'issue.fix.link_title'|trans }}</h2>
                {% if records is empty %}
                    <p class="muted">{{ 'issue.fix.link_none'|trans }}</p>
                {% else %}
                    <form class="form" method="post" action="{{ url_for('issues.fix', {id: vehicle.id, issue: issue.id}) }}">
                        {{ ui.csrf(csrf) }}
                        {{ ui.return_field(return_to) }}
                        <input type="hidden" name="how" value="link">
                        {% set options = records|map(r => {value: r.id ~ '', label: r.data.performedOn|local_date ~ ' · ' ~ r.data.title}) %}
                        {{ ui.select('record', 'issue.fix.record'|trans, values, errors, options) }}
                        <div class="btn-row"><button type="submit" class="btn">{{ ui.icon('link') }}{{ 'issue.fix.link_submit'|trans }}</button></div>
                    </form>
                {% endif %}
            </section>
        {% endif %}

        <section class="card" aria-labelledby="fix-none">
            <h2 id="fix-none" class="card__title">{{ 'issue.fix.none_title'|trans }}</h2>
            <form class="form" method="post" action="{{ url_for('issues.fix', {id: vehicle.id, issue: issue.id}) }}">
                {{ ui.csrf(csrf) }}
                {{ ui.return_field(return_to) }}
                <input type="hidden" name="how" value="none">
                {{ ui.input('fixed_on', 'issue.field.fixed_on'|trans, values, errors, {type: 'date', required: true, max: 'now'|date('Y-m-d')}) }}
                <div class="field">
                    <label class="field__label" for="f-note">{{ 'issue.field.note'|trans }} <span class="field__optional">{{ 'form.optional'|trans }}</span></label>
                    <textarea class="textarea" id="f-note" name="note" rows="2" maxlength="1000" placeholder="{{ 'issue.fix.none_placeholder'|trans }}"{{ ui.described_by('note', errors, false) }}>{{ values.note ?? '' }}</textarea>
                    {{ ui.field_error(errors, 'note') }}
                </div>
                <div class="btn-row"><button type="submit" class="btn">{{ ui.icon('check_circle') }}{{ 'issue.fix.none_submit'|trans }}</button></div>
            </form>
        </section>
        {% endblock %}
    </div>
{% endblock %}
