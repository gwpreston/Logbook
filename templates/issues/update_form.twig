{% extends 'layout.twig' %}
{% import 'macros/ui.twig' as ui %}

{#
 # *Add update* and a note's edit (spec.md §7.37 *Updates*): a date, the
 # odometer (which joins the mileage log), a note and, on add, an optional
 # change to open or watching. A page and a desktop modal.
 #}
{% set active_nav = 'garage' %}
{% set editing = update is not null %}
{% set heading = (editing ? 'issue.update.edit_title' : 'issue.update.add')|trans %}
{% set distance_symbol = ('units.symbol.' ~ prefs().distanceUnit.value)|trans %}

{% block title %}{{ heading }} · {{ issue.data.title }} · {{ parent() }}{% endblock %}

{% block content %}
    <div class="page__stack page__stack--narrow">
        <a class="back-link" href="{{ url_for('issues.show', {id: vehicle.id, issue: issue.id}) }}">{{ ui.icon('chevron_left') }}{{ issue.data.title }}</a>
        <header class="page-header">
            <div>
                <p class="page-header__eyebrow">{{ vehicle.name() }} · {{ issue.data.title }}</p>
                <h1 class="page-header__title">{{ heading }}</h1>
            </div>
        </header>

        {% block modal_body %}
        {% if errors is not empty %}
            <div class="alert alert--error" role="alert">{{ ui.icon('error') }}<span>{{ 'form.has_errors'|trans }}</span></div>
        {% endif %}
        <form class="form" method="post" action="{{ editing ? url_for('issues.updates.edit', {id: vehicle.id, update: update.id}) : url_for('issues.updates.create', {id: vehicle.id, issue: issue.id}) }}">
            {{ ui.csrf(csrf) }}
            {{ ui.return_field(return_to) }}
            <section class="card">
                <div class="form-row">
                    {{ ui.input('noted_on', 'issue.field.noted_on'|trans, values, errors, {type: 'date', required: true, max: 'now'|date('Y-m-d')}) }}
                    {{ ui.input('odometer', 'issue.field.odometer'|trans, values, errors, {type: 'number', step: 'any', min: 0, inputmode: 'decimal', suffix: distance_symbol, optional: true}) }}
                </div>
                <div class="field">
                    <label class="field__label" for="f-note">{{ 'issue.field.note'|trans }}</label>
                    <textarea class="textarea" id="f-note" name="note" rows="3" maxlength="1000" placeholder="{{ 'issue.update.placeholder'|trans }}"{{ ui.described_by('note', errors, false) }}>{{ values.note ?? '' }}</textarea>
                    {{ ui.field_error(errors, 'note') }}
                </div>
            </section>
            {% if not editing and not issue.isFixed() %}
                <section class="card" aria-labelledby="update-status">
                    <h2 id="update-status" class="card__title">{{ 'issue.field.status'|trans }}</h2>
                    {{ ui.chips('status', 'issue.field.status'|trans, values, errors, [
                        {value: 'open', label: 'issue.status.open'|trans},
                        {value: 'watching', label: 'issue.status.watching'|trans},
                    ]) }}
                    <div class="form-row">
                        {{ ui.input('look_again_on', 'issue.field.look_again_on'|trans, values, errors, {type: 'date', optional: true}) }}
                        {{ ui.input('look_again_odometer', 'issue.field.look_again_odometer'|trans, values, errors, {type: 'number', step: 'any', min: 0, inputmode: 'decimal', suffix: distance_symbol, optional: true}) }}
                    </div>
                    <p class="field__hint">{{ 'issue.hint.watching'|trans }}</p>
                </section>
            {% endif %}
            <div class="btn-row">
                <button type="submit" class="btn btn--primary btn--lg">{{ ui.icon('check_circle') }}{{ (editing ? 'form.save' : 'issue.update.add')|trans }}</button>
                <a data-modal-cancel class="btn btn--lg" href="{{ return_to ?: url_for('issues.show', {id: vehicle.id, issue: issue.id}) }}">{{ 'form.cancel'|trans }}</a>
            </div>
        </form>
        {% endblock %}
    </div>
{% endblock %}
