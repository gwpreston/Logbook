{% extends 'layout.twig' %}
{% import 'macros/ui.twig' as ui %}
{% import 'macros/expenses.twig' as exp %}

{% set active_nav = 'garage' %}
{% set dash = '—' %}
{% set period_query = report.filter.period.toQuery() %}

{% block title %}{{ 'expense.title'|trans }} · {{ vehicle.name() }} · {{ parent() }}{% endblock %}

{% block content %}
    <div class="page__stack">
        {% include 'vehicles/_header.twig' with {active_tab: 'expenses'} %}

        {% include 'vehicles/_list_toolbar.twig' with {title: 'expense.title'|trans, module: 'expenses', add: {route: 'expenses.create', label: 'expense.add'|trans}} %}

        {{ exp.range_chips(ranges, report.filter.period, 'expenses.index', {id: vehicle.id}) }}

        <dl class="stats">
            {{ ui.stat('expense.stat.total'|trans, section.total|money, 'report.period'|trans({from: report.period.from|local_date, to: report.period.to|local_date})) }}
            {{ ui.stat('expense.stat.per_distance'|trans,
                section.costPerKm is not null ? section.costPerKm|per_distance(currency) : dash,
                section.distanceKm is not null ? 'report.over_distance'|trans({distance: section.distanceKm|distance}) : 'report.no_distance'|trans) }}
            {{ ui.stat('expense.stat.per_month'|trans, section.averagePerMonth|money, 'report.months'|trans({count: report.monthCount()})) }}
        </dl>

        <div class="split">
            <section class="card" aria-labelledby="breakdown-heading">
                <div class="card__header">
                    <h2 id="breakdown-heading" class="card__title">{{ 'report.by_group'|trans }}</h2>
                </div>
                {% if section.isEmpty() %}
                    <p class="muted">{{ 'expense.none_in_period'|trans }}</p>
                {% else %}
                    {{ exp.breakdown(section) }}
                {% endif %}
            </section>

            {# Always the last 12 months: the range chips above do not change it. #}
            <section class="card" aria-labelledby="monthly-heading" data-expenses-monthly>
                <div class="card__header">
                    <h2 id="monthly-heading" class="card__title">{{ 'expense.last_twelve_months'|trans }}</h2>
                </div>
                {% if monthly_chart.hasData() %}
                    {{ ui.chart(monthly_chart, 'expense.monthly_chart_label'|trans) }}
                    <table class="table chart-table">
                        <caption class="visually-hidden">{{ 'expense.monthly_chart_label'|trans }}</caption>
                        <tbody>
                            {% for month in last_twelve.months|reverse %}
                                <tr>
                                    <th scope="row">{{ month.month|local_month }}</th>
                                    <td class="table__num tabular">{{ month.total.isZero() ? dash : month.total|money }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% else %}
                    <p class="muted">{{ 'expense.none_last_twelve_months'|trans }}</p>
                {% endif %}
            </section>
        </div>

        {% if finance_overlap|default([]) is not empty %}
            {# Phase 29.1 (spec.md §7.32 *Overlap warning*). #}
            <section class="alert alert--warning" role="status" aria-labelledby="finance-overlap">
                {{ ui.icon('warning') }}
                <div>
                    <p id="finance-overlap">{{ 'finance.overlap'|trans }}</p>
                    <ul>
                        {% for entry in finance_overlap %}
                            <li><a href="{{ url_for('expenses.edit', {id: vehicle.id, entry: entry.id}) }}" data-modal>{{ entry.data.spentOn|local_date }} · {{ entry.data.note ?: ('expense.category.finance'|trans) }}</a> <span class="tabular">{{ entry.data.amount|money(currency) }}</span></li>
                        {% endfor %}
                    </ul>
                    <p class="field__hint">{{ 'finance.overlap_hint'|trans }} <a href="{{ url_for('finance.index', {id: vehicle.id}) }}">{{ 'finance.title'|trans }}</a></p>
                </div>
            </section>
        {% endif %}

        <section class="card" aria-labelledby="costs-heading">
            <div class="card__header">
                <h2 id="costs-heading" class="card__title">{{ 'expense.costs'|trans }}</h2>
            </div>
            {% if rows is empty %}
                <div class="empty">
                    {{ ui.icon('payments') }}
                    <p class="empty__title">{{ 'expense.empty_title'|trans }}</p>
                    <p>{{ 'expense.empty_body'|trans }}</p>
                </div>
            {% else %}
                <ul class="list">
                    {% for item in rows %}
                        {{ exp.cost_row(item, false, attachment_counts.of(item.source.value, item.sourceId)) }}
                    {% endfor %}
                </ul>
                {{ ui.pagination(pagination, 'expenses.index', {id: vehicle.id}, period_query) }}
            {% endif %}
            <p class="field__hint">{{ 'expense.rollup_note'|trans }}</p>
        </section>
    </div>
{% endblock %}
