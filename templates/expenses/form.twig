{% extends 'layout.twig' %}
{% import 'macros/ui.twig' as ui %}
{% import 'macros/attachments.twig' as files %}

{% set active_nav = 'garage' %}
{% set editing = entry is not null %}
{% set heading = (editing ? 'expense.edit_title' : 'expense.add_title')|trans %}

{% block title %}{{ heading }} · {{ vehicle.name() }} · {{ parent() }}{% endblock %}

{% block content %}
    <div class="page__stack page__stack--narrow">
        <a class="back-link" href="{{ url_for('expenses.index', {id: vehicle.id}) }}">{{ ui.icon('chevron_left') }}{{ 'expense.title'|trans }} · {{ vehicle.name() }}</a>

        <header class="page-header">
            <div>
                <p class="page-header__eyebrow">{{ vehicle.name() }}{% if vehicle.data.registration %} · {{ vehicle.data.registration }}{% endif %}</p>
                <h1 class="page-header__title">{{ heading }}</h1>
                <p class="page-header__lead">{{ 'expense.form_lead'|trans }}</p>
            </div>
        </header>

        {% block modal_body %}
        {% if modal %}<p class="modal-fragment__context">{{ vehicle.name() }}{% if vehicle.data.registration %} · {{ vehicle.data.registration }}{% endif %}</p>{% endif %}
        {% if errors is not empty %}
            <div class="alert alert--error" role="alert">{{ ui.icon('error') }}<span>{{ 'form.has_errors'|trans }}</span></div>
        {% endif %}

        <form class="form" method="post" enctype="multipart/form-data"
              action="{{ editing ? url_for('expenses.edit', {id: vehicle.id, entry: entry.id}) : url_for('expenses.create', {id: vehicle.id}) }}">
            {{ ui.csrf(csrf) }}
            {% include 'ask/_draft_notice.twig' %}
            {{ ui.return_field(return_to) }}

            {# The finance hint shows while Finance and lease is picked (always, without JS). #}
            <section class="card" x-data="{ category: '{{ (values.category ?? '')|e('js') }}' }"
                     @change="if ($event.target.name === 'category') category = $event.target.value">
                {{ ui.select('category', 'expense.field.category'|trans, values, errors,
                    categories|map(c => {value: c.value, label: ('expense.category.' ~ c.value)|trans}), {required: true}) }}
                <p class="field__hint" x-show="category === 'finance'">{{ 'expense.hint.finance'|trans }}</p>
                <div class="form-row">
                    {{ ui.input('spent_on', 'expense.field.spent_on'|trans, values, errors, {type: 'date', required: true}) }}
                    {{ ui.input('amount', 'expense.field.amount'|trans, values, errors, {type: 'number', optional: true, step: 'any', min: 0, inputmode: 'decimal', suffix: currency_symbol(currency), hint: 'expense.hint.amount'|trans}) }}
                </div>
                {{ ui.input('note', 'expense.field.note'|trans, values, errors, {optional: true, maxlength: 500, hint: 'expense.hint.note'|trans}) }}
            </section>

            {{ files.card(vehicle, attachments, errors, max_upload_mb, max_upload_files) }}

            <div class="btn-row">
                <button type="submit" class="btn btn--primary btn--lg">{{ ui.icon('check_circle') }}{{ (editing ? 'form.save' : 'expense.add_submit')|trans }}</button>
                <a data-modal-cancel class="btn btn--lg" href="{{ return_to ?: (url_for('expenses.index', {id: vehicle.id})) }}">{{ 'form.cancel'|trans }}</a>
                {% if editing %}
                    <a class="btn btn--lg btn--danger btn--push" href="{{ url_for('expenses.delete', {id: vehicle.id, entry: entry.id}) }}">{{ ui.icon('delete') }}{{ 'form.delete'|trans }}</a>
                {% endif %}
            </div>
        </form>
        {% endblock %}
    </div>
{% endblock %}
