{% extends 'layout.twig' %}
{% import 'macros/ui.twig' as ui %}
{# A file that could not be read, and no form to go back to (spec.md §7.27 *Failures*): which form? The file is attached to it. #}
{% set active_nav = 'log' %}
{% set heading = 'scan.kind_title'|trans %}

{% block title %}{{ heading }} · {{ parent() }}{% endblock %}

{% block content %}
    <div class="page__stack page__stack--narrow">
        <header class="page-header"><h1 class="page-header__title">{{ heading }}</h1></header>
        {% block modal_body %}
            <p class="alert alert--warning" role="status">{{ ui.icon('warning') }}<span>{{ (problem ? problem.messageKey() : 'scan.problem.failed')|trans }} {{ 'scan.notice.attached_anyway'|trans }}</span></p>
            <ul class="log-choices">
                {% for kind in kinds %}
                    <li>
                        <a class="log-choice" href="{{ url_for('scan.result', {token: upload.token}, {as: kind.value}) }}">
                            <span class="log-choice__icon">{{ ui.icon({service_invoice: 'build', fuel_receipt: 'local_gas_station', other: 'description'}[kind.value]) }}</span>
                            <span class="log-choice__label">{{ ('scan.kind_form.' ~ kind.value)|trans }}</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endblock %}
    </div>
{% endblock %}
