{% extends 'layout.twig' %}
{% import 'macros/ui.twig' as ui %}
{# Which vehicle is the document for (spec.md §7.27 *Vehicle*)? Shown when the registration matched none. #}
{% set active_nav = 'log' %}
{% set heading = 'scan.pick_title'|trans %}

{% block title %}{{ heading }} · {{ parent() }}{% endblock %}

{% block content %}
    <div class="page__stack page__stack--narrow">
        <header class="page-header">
            <div>
                <h1 class="page-header__title">{{ heading }}</h1>
                <p class="page-header__lead">{{ registration ? 'scan.pick_lead_registration'|trans({registration: registration}) : 'scan.pick_lead'|trans }}</p>
            </div>
        </header>
        {% block modal_body %}
            <ul class="pick-list">
                {% for vehicle in vehicles %}
                    <li>
                        <a class="pick" href="{{ url_for('scan.result', {token: upload.token}, {vehicle: vehicle.id} + (as ? {as: as.value} : {})) }}">
                            {{ ui.vehicle_photo(vehicle, 'vehicle-photo--thumb') }}
                            <span class="pick__body">
                                <span class="pick__name">{{ vehicle.name() }}</span>
                                <span class="pick__meta">{{ ui.plate(vehicle.data.registration, 'sm', plate_style(vehicle)) }}</span>
                            </span>
                            {{ ui.icon('chevron_right', 'pick__chevron') }}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        {% endblock %}
    </div>
{% endblock %}
