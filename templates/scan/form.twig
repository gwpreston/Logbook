{% extends 'layout.twig' %}
{% import 'macros/ui.twig' as ui %}
{% import 'macros/ai.twig' as ai %}
{#
 # Scan a receipt or document (spec.md §7.27): one photo or PDF, the
 # vehicle (or let the document decide), and where the file is sent.
 # A plain multipart form; with JS it says it is reading while it posts.
 #}
{% set active_nav = 'log' %}
{# *Scan the V5C* (Phase 53.8, #511): started from a vehicle's page. #}
{% set heading = (v5c_vehicle ? 'scan.v5c.title' : 'scan.title')|trans %}

{% block title %}{{ heading }} · {{ parent() }}{% endblock %}

{% block content %}
    <div class="page__stack page__stack--narrow">
        <header class="page-header">
            <div>
                <h1 class="page-header__title">{{ heading }}</h1>
                <p class="page-header__lead">{{ v5c_vehicle ? 'scan.v5c.lead'|trans({vehicle: v5c_vehicle.name()}) : 'scan.lead'|trans }}</p>
            </div>
        </header>

        {% block modal_body %}
        {% if errors is not empty %}
            <div class="alert alert--error" role="alert">{{ ui.icon('error') }}<span>{{ 'form.has_errors'|trans }}</span></div>
        {% endif %}

        {% if rules %}
            {# Phase 53.4 (§7.27 *Reading without AI*): nothing leaves the server. #}
            <p class="ask-where" data-scan-rules>
                {{ ai.location(this_server) }}
                <span>{{ (rules_engine == 'paddleocr' ? 'scan.where.rules_paddleocr' : 'scan.where.rules')|trans }}</span>
            </p>
        {% elseif connection %}
            <p class="ask-where">
                {{ ai.location(connection.location) }}
                <span>{{ ('scan.where.' ~ connection.location.value)|trans({connection: connection.name}) }}</span>
            </p>
            {% if v5c_vehicle %}
                {# #511: such a scan goes to an Internet connection only as text, so the V5C warnings aren't needed. #}
                {% if connection.location.value == 'internet' and (ocr_engine or ocr_checks) %}
                    <p class="ask-where ask-where--note" data-scan-v5c-text>{{ ui.icon('document_scanner') }}<span>{{ 'scan.v5c.internet'|trans({connection: connection.name}) }}</span></p>
                {% elseif connection.location.value == 'internet' %}
                    {# No OCR: a V5C photo can't go to the Internet at all (#511). #}
                    <p class="alert alert--warning" role="note" data-scan-v5c-no-ocr>{{ ui.icon('warning') }}<span>{{ 'scan.problem.registration_text_only'|trans }}</span></p>
                {% endif %}
            {% elseif ocr_engine %}
                {# Photos go as text, with a spotted V5C's reference removed (§7.27 *Where it goes*). #}
                <p class="ask-where ask-where--note" data-scan-ocr>{{ ui.icon('document_scanner') }}<span>{{ ('scan.where.ocr_' ~ ocr_engine)|trans({connection: connection.name}) }}</span></p>
                {% if connection.location.value == 'internet' %}
                    {# #512: a misread or split reference is caught only in a V5C text recognition spots (#510's short warning). #}
                    <p class="alert alert--warning" role="note" data-scan-ocr-registration>{{ ui.icon('warning') }}<span>{{ 'scan.where.registration_warning_ocr'|trans({connection: connection.name}) }}</span></p>
                {% endif %}
            {% elseif ocr_checks %}
                {# Phase 53.3: pictures, checked by OCR; on the Internet a V5C goes as text (#510). #}
                <p class="ask-where ask-where--note" data-scan-ocr-check>{{ ui.icon('document_scanner') }}<span>{{ 'scan.where.ocr_check'|trans({connection: connection.name}) }}</span></p>
                {% if connection.location.value == 'internet' %}
                    {# #510: a V5C text recognition spots goes as text; one it doesn't still goes as a picture (#85, short form). #}
                    <p class="alert alert--warning" role="note">{{ ui.icon('warning') }}<span>{{ 'scan.where.registration_warning_unrecognised'|trans({connection: connection.name}) }}</span></p>
                {% endif %}
            {% elseif connection.location.value == 'internet' %}
                <p class="alert alert--warning" role="note">{{ ui.icon('warning') }}<span>{{ 'scan.where.registration_warning'|trans({connection: connection.name}) }}</span></p>
            {% endif %}
            {% if rules_text %}
                <p class="ask-where ask-where--note" data-scan-rules-text>{{ ui.icon('document_scanner') }}<span>{{ 'scan.where.rules_text'|trans }}</span></p>
            {% endif %}
        {% endif %}

        {% if not has_vehicles %}
            <p class="empty-state">{{ 'log.no_vehicles'|trans }}</p>
        {% else %}
        <form class="form" method="post" enctype="multipart/form-data" action="{{ url_for('scan') }}" data-scan-form>
            {{ ui.csrf(csrf) }}
            <input type="hidden" name="for" value="{{ values.for ?? '' }}">
            {% if values.incident ?? '' %}<input type="hidden" name="incident" value="{{ values.incident }}">{% endif %}
            <section class="card">
                <div class="field">
                    <label class="field__label" for="f-file">{{ 'scan.field.file'|trans }}</label>
                    {% set native %}<input class="input input--file" id="f-file" name="file" type="file" accept="image/jpeg,image/png,image/webp,application/pdf" capture="environment" required{{ ui.described_by('file', errors, true) }}>{% endset %}
                    {{ ui.file_drop(native, {max_mb: max_upload_mb}) }}
                    <p class="field__hint" id="f-file-hint">{{ (reads_pictures ? 'scan.hint.file' : (text_only ? 'scan.hint.file_send_text' : 'scan.hint.file_text_only'))|trans({max: max_upload_mb}) }}</p>
                    {{ ui.field_error(errors, 'file') }}
                </div>
                {% if v5c_vehicle %}
                    <input type="hidden" name="vehicle_id" value="{{ v5c_vehicle.id }}">
                    <p class="field"><span class="field__label">{{ 'scan.v5c.vehicle'|trans }}</span> <span>{{ v5c_vehicle.name() }}</span></p>
                {% else %}
                    {{ ui.select('vehicle_id', 'scan.field.vehicle'|trans, values, errors, vehicle_options, {hint: 'scan.hint.vehicle'|trans}) }}
                {% endif %}
            </section>
            <p class="field__hint">{{ 'scan.hint.check'|trans }}</p>
            <div class="btn-row">
                <button type="submit" class="btn btn--primary btn--lg" data-scan-submit data-scan-reading="{{ 'scan.reading'|trans }}">{{ ui.icon('document_scanner') }}{{ 'scan.submit'|trans }}</button>
                <a data-modal-cancel class="btn btn--lg" href="{{ url_for('log.chooser') }}">{{ 'form.cancel'|trans }}</a>
            </div>
            <p class="scan-reading" data-scan-status role="status" aria-live="polite" hidden></p>
        </form>
        {% endif %}
        {% endblock %}
    </div>
{% endblock %}
