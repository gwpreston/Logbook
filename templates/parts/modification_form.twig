{% extends 'layout.twig' %}
{% import 'macros/ui.twig' as ui %}
{% import 'macros/attachments.twig' as files %}

{#
 # Log or edit a modification (spec.md §7.39 *Add / edit*), as a page and a
 # desktop modal: what was done, then the parts it fitted and what came off,
 # so a one-part modification is one save. Its cost is build spend: in what
 # the car has cost, never in a running cost per mile.
 #}
{% set active_nav = 'garage' %}
{% set editing = modification is not null %}
{% set heading = (editing ? 'modification.edit_title' : 'modification.add_title')|trans %}
{% set distance_symbol = ('units.symbol.' ~ prefs().distanceUnit.value)|trans %}
{% set back = editing ? url_for('modifications.show', {id: vehicle.id, modification: modification.id}) : url_for('parts.index', {id: vehicle.id}) %}

{% block title %}{{ heading }} · {{ vehicle.name() }} · {{ parent() }}{% endblock %}

{% block content %}
    <div class="page__stack page__stack--narrow">
        <a class="back-link" href="{{ back }}">{{ ui.icon('chevron_left') }}{{ 'part.tab_title'|trans }} · {{ vehicle.name() }}</a>

        <header class="page-header">
            <div>
                <p class="page-header__eyebrow">{{ vehicle.name() }}{% if vehicle.data.registration %} · {{ vehicle.data.registration }}{% endif %}</p>
                <h1 class="page-header__title">{{ heading }}</h1>
                <p class="page-header__lead">{{ 'modification.form_lead'|trans }}</p>
            </div>
        </header>

        {% block modal_body %}
        {% if modal %}<p class="modal-fragment__context">{{ vehicle.name() }}{% if vehicle.data.registration %} · {{ vehicle.data.registration }}{% endif %}</p>{% endif %}
        {% if errors is not empty %}
            <div class="alert alert--error" role="alert">{{ ui.icon('error') }}<span>{{ errors.form is defined ? trans(errors.form.key, errors.form.params) : 'form.has_errors'|trans }}</span></div>
        {% endif %}

        <form class="form" method="post" enctype="multipart/form-data"
              action="{{ editing ? url_for('modifications.edit', {id: vehicle.id, modification: modification.id}) : url_for('modifications.create', {id: vehicle.id}) }}">
            {{ ui.csrf(csrf) }}
            {% include 'ask/_draft_notice.twig' %}
            {{ ui.return_field(return_to) }}

            <section class="card">
                {{ ui.input('title', 'modification.field.title'|trans, values, errors, {required: true, maxlength: 120, hint: 'modification.hint.title'|trans}) }}
                {{ ui.select('category', 'modification.field.category'|trans, values, errors,
                    categories|map(c => {value: c.value, label: c.labelKey()|trans})) }}
                <div class="form-row">
                    {{ ui.input('done_on', 'modification.field.done_on'|trans, values, errors, {type: 'date', required: true, max: 'now'|date('Y-m-d')}) }}
                    {% set odometer_hint = latest and (not editing or latest.modificationId != modification.id)
                        ? 'odometer.hint.latest'|trans({reading: latest.readingKm|distance, date: latest.recordedAt|instant_date})
                        : null %}
                    {{ ui.input('odometer', 'modification.field.odometer'|trans, values, errors, {type: 'number', optional: true, step: 'any', min: 0, inputmode: 'decimal', suffix: distance_symbol, hint: odometer_hint}) }}
                </div>
                <div class="form-row">
                    {% if can_see_costs(vehicle) %}
                        {{ ui.input('cost', 'modification.field.cost'|trans, values, errors, {type: 'number', optional: true, step: 'any', min: 0, inputmode: 'decimal', suffix: currency_symbol(currency), hint: 'modification.hint.cost'|trans}) }}
                    {% endif %}
                    {{ ui.input('fitted_by', 'modification.field.fitted_by'|trans, values, errors, {optional: true, maxlength: 120, hint: 'modification.hint.fitted_by'|trans}) }}
                </div>
                <div class="field">
                    <label class="field__label" for="f-notes">{{ 'modification.field.notes'|trans }} <span class="field__optional">{{ 'form.optional'|trans }}</span></label>
                    <textarea class="textarea" id="f-notes" name="notes" rows="3" maxlength="2200"{{ ui.described_by('notes', errors, false) }}>{{ values.notes ?? '' }}</textarea>
                    {{ ui.field_error(errors, 'notes') }}
                </div>
            </section>

            {% include 'parts/_record_parts.twig' %}

            {{ files.card(vehicle, attachments, errors, max_upload_mb, max_upload_files) }}

            <div class="btn-row">
                <button type="submit" class="btn btn--primary btn--lg">{{ ui.icon('check_circle') }}{{ (editing ? 'form.save' : 'modification.add_submit')|trans }}</button>
                <a data-modal-cancel class="btn btn--lg" href="{{ return_to ?: back }}">{{ 'form.cancel'|trans }}</a>
                {% if editing %}
                    <a class="btn btn--lg btn--danger btn--push" href="{{ url_for('modifications.delete', {id: vehicle.id, modification: modification.id}) }}">{{ ui.icon('delete') }}{{ 'form.delete'|trans }}</a>
                {% endif %}
            </div>
        </form>
        {% endblock %}
    </div>
{% endblock %}
