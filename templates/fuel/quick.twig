{% extends 'layout.twig' %}
{% import 'macros/vehicles.twig' as vehicle_ui %}

{% set active_nav = 'log' %}
{% set heading = 'fuel.quick_title'|trans %}

{% block title %}{{ heading }} · {{ parent() }}{% endblock %}

{% block content %}
    <div class="page__stack page__stack--narrow">
        <header class="page-header">
            <div>
                <h1 class="page-header__title">{{ heading }}</h1>
                <p class="page-header__lead">{{ 'fuel.quick_lead'|trans }}</p>
            </div>
        </header>
        {% block modal_body %}
            {# Each vehicle's fill-up form is kept for offline use (js/app.js). #}
            {{ vehicle_ui.pick_list(vehicles, 'fuel.create', true) }}
        {% endblock %}
    </div>
{% endblock %}
