{% extends 'layout.twig' %}
{% import 'macros/ui.twig' as ui %}

{% set active_nav = 'log' %}

{% block title %}{{ 'fuel.quick_title'|trans }} · {{ parent() }}{% endblock %}

{% block content %}
    <div class="page__stack page__stack--narrow">
        <header class="page-header">
            <div>
                <h1 class="page-header__title">{{ 'fuel.quick_title'|trans }}</h1>
                <p class="page-header__lead">{{ 'fuel.quick_lead'|trans }}</p>
            </div>
        </header>

        <ul class="pick-list">
            {% for vehicle in vehicles %}
                <li>
                    <a class="pick" href="{{ url_for('fuel.create', {id: vehicle.id}) }}" data-offline-cache>
                        {{ ui.vehicle_photo(vehicle, 'vehicle-photo--thumb') }}
                        <span class="pick__body">
                            <span class="pick__name">{{ vehicle.name() }}</span>
                            <span class="pick__meta">
                                {% if vehicle.data.registration %}<span class="plate">{{ vehicle.data.registration }}</span>{% endif %}
                                <span>{{ ('vehicle.fuel.' ~ vehicle.data.fuelType.value)|trans }}</span>
                            </span>
                        </span>
                        {{ ui.icon('chevron_right', 'pick__chevron') }}
                    </a>
                </li>
            {% endfor %}
        </ul>
    </div>
{% endblock %}
