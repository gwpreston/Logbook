{% extends 'layout.twig' %}
{% import 'macros/ui.twig' as ui %}
{% import 'macros/attachments.twig' as files %}

{% set active_nav = 'garage' %}
{% set editing = entry is not null %}
{% set heading = (editing ? 'fuel.edit_title' : 'fuel.add_title')|trans %}
{% set fuel = values.fuel ?? 'petrol' %}
{% set volume_symbol = ('units.symbol.' ~ prefs().volumeUnit.value)|trans %}
{% set energy_symbol = 'units.symbol.kwh'|trans %}
{% set distance_symbol = ('units.symbol.' ~ prefs().distanceUnit.value)|trans %}
{% set money_symbol = currency_symbol(currency) %}
{% set money_digits = currency_digits(currency) %}

{% block title %}{{ heading }} · {{ vehicle.name() }} · {{ parent() }}{% endblock %}

{% block content %}
    <div class="page__stack page__stack--narrow">
        <a class="back-link" href="{{ url_for('fuel.index', {id: vehicle.id}) }}">{{ ui.icon('chevron_left') }}{{ 'fuel.title'|trans }} · {{ vehicle.name() }}</a>

        <header class="page-header">
            <div>
                <p class="page-header__eyebrow">{{ vehicle.name() }}{% if vehicle.data.registration %} · {{ vehicle.data.registration }}{% endif %}</p>
                <h1 class="page-header__title">{{ heading }}</h1>
            </div>
        </header>

        {% if errors is not empty %}
            <div class="alert alert--error" role="alert">{{ ui.icon('error') }}<span>{{ 'form.has_errors'|trans }}</span></div>
        {% endif %}

        <form class="form" method="post" enctype="multipart/form-data"
              action="{{ editing ? url_for('fuel.edit', {id: vehicle.id, entry: entry.id}) : url_for('fuel.create', {id: vehicle.id}) }}"
              x-data="{ fuel: '{{ fuel|e('js') }}' }">
            {{ ui.csrf(csrf) }}

            <section class="card">
                <div class="form-row">
                    {% set odometer_hint = latest and (not editing or latest.fuelEntryId != entry.id)
                        ? 'odometer.hint.latest'|trans({reading: latest.readingKm|distance, date: latest.recordedAt|instant_date})
                        : '' %}
                    {{ ui.input('odometer', 'fuel.field.odometer'|trans, values, errors, {type: 'number', required: true, step: 'any', min: 0, inputmode: 'decimal', suffix: distance_symbol, hint: odometer_hint}) }}
                    {{ ui.input('filled_at', 'fuel.field.filled_at'|trans, values, errors, {type: 'datetime-local', required: true}) }}
                </div>
                <div class="field">
                    <label class="field__label" for="f-fuel">{{ 'fuel.field.fuel'|trans }}</label>
                    <select class="select" id="f-fuel" name="fuel" required x-model="fuel"{{ ui.described_by('fuel', errors, false) }}>
                        {% for option in fuels %}
                            <option value="{{ option.value }}"{% if option.value == fuel %} selected{% endif %}>{{ ('fuel.fuel.' ~ option.value)|trans }}</option>
                        {% endfor %}
                    </select>
                    {{ ui.field_error(errors, 'fuel') }}
                </div>
            </section>

            <fieldset class="card fieldset" data-fuel-amounts data-money-digits="{{ money_digits }}" aria-describedby="f-amounts-hint">
                <legend class="card__title fieldset__legend">{{ 'fuel.section.amounts'|trans }}</legend>
                <p class="field__hint" id="f-amounts-hint">{{ 'fuel.hint.any_two'|trans }}</p>
                <div class="form-row form-row--3">
                    <div class="field">
                        <label class="field__label" for="f-volume">
                            <span x-text="fuel === 'ev' ? '{{ 'fuel.field.energy'|trans|e('js') }}' : '{{ 'fuel.field.volume'|trans|e('js') }}'">{{ (fuel == 'ev' ? 'fuel.field.energy' : 'fuel.field.volume')|trans }}</span>
                        </label>
                        <div class="input-group">
                            <input class="input" id="f-volume" name="volume" type="number" step="any" min="0" inputmode="decimal" data-amount="volume" value="{{ values.volume ?? '' }}"{{ ui.described_by('volume', errors, false) }}>
                            <span class="input-group__suffix" aria-hidden="true" x-text="fuel === 'ev' ? '{{ energy_symbol|e('js') }}' : '{{ volume_symbol|e('js') }}'">{{ fuel == 'ev' ? energy_symbol : volume_symbol }}</span>
                        </div>
                        {{ ui.field_error(errors, 'volume') }}
                    </div>
                    <div class="field">
                        <label class="field__label" for="f-price">
                            <span x-text="fuel === 'ev' ? '{{ 'fuel.field.price_per'|trans({unit: energy_symbol})|e('js') }}' : '{{ 'fuel.field.price_per'|trans({unit: volume_symbol})|e('js') }}'">{{ 'fuel.field.price_per'|trans({unit: fuel == 'ev' ? energy_symbol : volume_symbol}) }}</span>
                        </label>
                        <div class="input-group">
                            <input class="input" id="f-price" name="price" type="number" step="any" min="0" inputmode="decimal" data-amount="price" value="{{ values.price ?? '' }}"{{ ui.described_by('price', errors, false) }}>
                            <span class="input-group__suffix" aria-hidden="true">{{ money_symbol }}</span>
                        </div>
                        {{ ui.field_error(errors, 'price') }}
                    </div>
                    <div class="field">
                        <label class="field__label" for="f-total">{{ 'fuel.field.total'|trans }}</label>
                        <div class="input-group">
                            <input class="input" id="f-total" name="total" type="number" step="any" min="0" inputmode="decimal" data-amount="total" value="{{ values.total ?? '' }}"{{ ui.described_by('total', errors, false) }}>
                            <span class="input-group__suffix" aria-hidden="true">{{ money_symbol }}</span>
                        </div>
                        {{ ui.field_error(errors, 'total') }}
                    </div>
                </div>
                <p class="field__hint derived-note" data-derived-note hidden aria-live="polite"></p>
            </fieldset>

            <section class="card">
                <label class="toggle">
                    <input type="checkbox" name="partial" value="1"{% if (values.partial ?? '') == '1' %} checked{% endif %}>
                    <span class="toggle__text">
                        <span class="toggle__title" x-text="fuel === 'ev' ? '{{ 'fuel.field.partial_ev'|trans|e('js') }}' : '{{ 'fuel.field.partial'|trans|e('js') }}'">{{ (fuel == 'ev' ? 'fuel.field.partial_ev' : 'fuel.field.partial')|trans }}</span>
                        <span class="toggle__hint">{{ 'fuel.hint.partial'|trans }}</span>
                    </span>
                </label>
                <label class="toggle">
                    <input type="checkbox" name="missed_previous" value="1"{% if (values.missed_previous ?? '') == '1' %} checked{% endif %}>
                    <span class="toggle__text">
                        <span class="toggle__title">{{ 'fuel.field.missed_previous'|trans }}</span>
                        <span class="toggle__hint">{{ 'fuel.hint.missed_previous'|trans }}</span>
                    </span>
                </label>
            </section>

            {% set has_details = (values.station ?? '') != '' or (values.notes ?? '') != '' or errors.station is defined or errors.notes is defined %}
            <details class="card disclosure"{% if has_details %} open{% endif %}>
                <summary class="disclosure__summary">{{ 'fuel.section.details'|trans }}</summary>
                {{ ui.input('station', 'fuel.field.station'|trans, values, errors, {optional: true, maxlength: 100}) }}
                <div class="field">
                    <label class="field__label" for="f-notes">{{ 'fuel.field.notes'|trans }} <span class="field__optional">{{ 'form.optional'|trans }}</span></label>
                    <textarea class="textarea" id="f-notes" name="notes" rows="3" maxlength="1000"{{ ui.described_by('notes', errors, false) }}>{{ values.notes ?? '' }}</textarea>
                    {{ ui.field_error(errors, 'notes') }}
                </div>
            </details>

            {{ files.card(vehicle, attachments, errors, max_upload_mb) }}

            <div class="btn-row">
                <button type="submit" class="btn btn--primary btn--lg">{{ ui.icon('check_circle') }}{{ (editing ? 'form.save' : 'fuel.add_submit')|trans }}</button>
                <a class="btn btn--lg" href="{{ url_for('fuel.index', {id: vehicle.id}) }}">{{ 'form.cancel'|trans }}</a>
                {% if editing %}
                    <a class="btn btn--lg btn--danger btn--push" href="{{ url_for('fuel.delete', {id: vehicle.id, entry: entry.id}) }}">{{ ui.icon('delete') }}{{ 'form.delete'|trans }}</a>
                {% endif %}
            </div>
        </form>
    </div>
{% endblock %}
