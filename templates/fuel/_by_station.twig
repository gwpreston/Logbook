{#
 # *By station* on the Fuel tab (spec.md §7.33): the top five stations by
 # spend in the last 12 months, with visits, spend and the average paid for
 # the vehicle's main grade, each linking to its station page.
 #}
{% import 'macros/ui.twig' as ui %}
{% import 'macros/stations.twig' as st %}
<section class="card" aria-labelledby="by-station-heading">
    <div class="card__header">
        <h2 id="by-station-heading" class="card__title">{{ 'stations.by_station.title'|trans }}</h2>
        <div class="btn-row">
            {% if fuel_prices_enabled() %}<a class="btn btn--ghost" href="{{ url_for('stations.near', {}, {vehicle: vehicle.id}) }}">{{ ui.icon('near_me') }}{{ 'fuel_prices.near.title'|trans }}</a>{% endif %}
            <a class="btn btn--ghost" href="{{ url_for('stations.index') }}">{{ 'stations.by_station.all'|trans }}</a>
        </div>
    </div>
    <div class="table-wrap">
        <table class="table">
            <caption class="visually-hidden">{{ 'stations.by_station.caption'|trans }}</caption>
            <thead>
                <tr>
                    <th scope="col">{{ 'stations.by_station.station'|trans }}</th>
                    <th scope="col" class="table__num">{{ 'stations.paid.visits'|trans }}</th>
                    <th scope="col" class="table__num">{{ 'stations.paid.spend'|trans }}</th>
                    <th scope="col" class="table__num">{{ 'stations.paid.average'|trans }}</th>
                </tr>
            </thead>
            <tbody>
                {% for row in by_station %}
                    {% set summary = row.summary %}
                    {% set stats = by_station_grade ? summary.grade(by_station_grade) : null %}
                    {% if stats is null %}{% set stats = summary.mainGrade() %}{% endif %}
                    <tr>
                        <th scope="row"><a href="{{ url_for('stations.show', {station: row.station.id}) }}">{{ row.station.data.name }}</a></th>
                        <td class="table__num tabular">{{ summary.visits }}</td>
                        <td class="table__num tabular">{{ summary.spend()|first|money(currency) }}</td>
                        <td class="table__num tabular">
                            {%- if stats and stats.averagePrice -%}
                                {{ stats.averagePrice|unit_price(stats.currency, stats.fuel.isElectric()) }} <span class="muted">{{ st.grade_label(stats) }}</span>
                            {%- else -%}—{%- endif -%}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    <p class="field__hint">{{ 'stations.by_station.hint'|trans }}</p>
    {% if shopping_around ?? null %}
        <p data-shopping-around>{{ ui.icon('savings') }} <strong>{{ 'fuel_prices.shopping.title'|trans }}</strong> {{ shopping_around }} <span class="muted">{{ 'fuel_prices.shopping.estimate'|trans }}</span></p>
    {% endif %}
</section>
