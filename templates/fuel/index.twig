{% extends 'layout.twig' %}
{% import 'macros/ui.twig' as ui %}
{% import 'macros/fuel.twig' as fuel_ui %}
{% import 'macros/expenses.twig' as exp %}

{% set active_nav = 'garage' %}
{% set dash = '—' %}

{% block title %}{{ 'fuel.title'|trans }} · {{ vehicle.name() }} · {{ parent() }}{% endblock %}

{% block content %}
    <div class="page__stack print-report">
        {% include 'print/_header.twig' with {
            title: 'fuel.title'|trans,
            vehicle: vehicle,
            period: history.isEmpty() ? 'print.no_records'|trans : 'report.period'|trans({
                from: (history.fills|first).entry.data.filledAt|instant_date,
                to: history.latest().entry.data.filledAt|instant_date,
            }),
        } %}

        {% include 'vehicles/_header.twig' with {active_tab: 'fuel'} %}

        {% include 'vehicles/_list_toolbar.twig' with {title: 'fuel.title'|trans, module: 'fuel', add: {route: 'fuel.create', label: 'fuel.add'|trans}, print: true} %}

        {% for section in sections %}
            {% set summary = section.summary %}
            {% set electric = section.electric %}
            {% set last = summary.lastSegment %}
            <section class="page__stack" aria-labelledby="summary-{{ section.kind.value }}">
                <h2 id="summary-{{ section.kind.value }}" class="{{ sections|length > 1 ? 'section-title section-title--sm' : 'visually-hidden' }}">{{ ('fuel.kind.' ~ section.kind.value)|trans }}</h2>

                {% set overview %}
                <dl class="stats">
                    {{ ui.stat((electric ? 'fuel.stat.average_ev' : 'fuel.stat.average')|trans,
                        summary.hasEconomy() ? summary.measuredDistanceKm|economy(summary.measuredVolume, electric) : dash,
                        summary.hasEconomy() ? 'fuel.stat.average_over'|trans({distance: summary.measuredDistanceKm|distance}) : 'fuel.stat.need_two_full'|trans,
                        summary.hasEconomy() ? 'good' : '') }}
                    {{ ui.stat('fuel.stat.last'|trans,
                        last ? last.distanceKm|economy(last.volume, electric) : dash,
                        last ? 'fuel.stat.last_over'|trans({distance: last.distanceKm|distance, date: last.endedAt|instant_date}) : '') }}
                    {{ ui.stat('fuel.stat.average_price'|trans,
                        summary.averagePricePerUnit() is null ? dash : summary.averagePricePerUnit()|unit_price(currency, electric),
                        'fuel.stat.bought'|trans({amount: summary.totalVolume|quantity(electric, 0), count: summary.fills})) }}
                    {{ ui.stat((electric ? 'fuel.stat.cost_per_distance_ev' : 'fuel.stat.cost_per_distance')|trans,
                        summary.costPerKm() is null ? dash : summary.costPerKm()|per_distance(currency),
                        (electric ? 'fuel.stat.charging_only' : 'fuel.stat.fuel_only')|trans) }}
                    {{ ui.stat((electric ? 'fuel.stat.spend_ev' : 'fuel.stat.spend')|trans, summary.totalCost|money(currency), 'fuel.stat.all_time'|trans) }}
                </dl>

                {% if section.to_check > 0 %}
                    <p class="economy-check-count">
                        {{ ui.icon('warning') }}<a href="{{ url_for('fuel.index', {id: vehicle.id}, {check: 1}) }}">{{ 'fuel.check.to_check_count'|trans({count: section.to_check}) }}</a>
                    </p>
                {% endif %}

                {% if summary.hasEconomy() and not electric %}
                    <p class="muted economy-units">
                        {{ 'fuel.also_as'|trans }}
                        {% for unit in consumption_units|filter(u => u != prefs().consumptionUnit) %}
                            <span class="tabular">{{ summary.measuredDistanceKm|consumption(summary.measuredVolume, 1, unit) }}</span>{% if not loop.last %} · {% endif %}
                        {% endfor %}
                    </p>
                {% endif %}
                {% endset %}

                {# By grade sits beside the summary on wide screens (spec.md §7.3). #}
                {% if section.grades %}
                    <div class="split">
                        <div class="page__stack">{{ overview }}</div>
                        {{ fuel_ui.grade_card(section.grades, currency, electric, section.verdicts) }}
                    </div>
                {% else %}
                    {{ overview }}
                {% endif %}

                <div class="split">
                    {% set trend_title = (electric ? 'fuel.chart.efficiency_title' : 'fuel.chart.economy_title')|trans %}
                    <section class="card" aria-labelledby="economy-{{ section.kind.value }}">
                        <div class="card__header card__header--wrap">
                            <h3 id="economy-{{ section.kind.value }}" class="card__title">{{ trend_title }}</h3>
                            {# Plain links: work without JS and survive a refresh; js/app.js swaps the charts in place. #}
                            <nav class="segmented" aria-label="{{ 'fuel.trend.label'|trans }}">
                                {% for mode in trend_modes %}
                                    <a class="segmented__option" data-trend-link="{{ mode.value }}"
                                       href="{{ url_for('fuel.index', {id: vehicle.id}, mode.query()|merge(to_check ? {check: 1} : {})) }}"
                                       {%- if mode == trend %} aria-current="true"{% endif %}>
                                        {{- ('fuel.trend.' ~ mode.value ~ (electric and mode.value == 'economy' ? '_ev' : ''))|trans({unit: prefs().distanceUnit.value}) -}}
                                    </a>
                                {% endfor %}
                            </nav>
                        </div>
                        <div data-trend-panel="economy"{% if trend.value != 'economy' %} hidden{% endif %}>
                            {% if section.economy_chart.hasData() %}
                                {{ ui.chart(section.economy_chart, trend_title) }}
                                {{ ui.chart_table(section.economy_chart, trend_title) }}
                                <p class="field__hint">{{ 'fuel.chart.economy_hint'|trans }}</p>
                            {% else %}
                                <p class="muted">{{ 'fuel.chart.need_more'|trans }}</p>
                            {% endif %}
                        </div>
                        <div data-trend-panel="cost"{% if trend.value != 'cost' %} hidden{% endif %}>
                            {% set cost_title = 'fuel.trend.cost_title'|trans({unit: prefs().distanceUnit.value}) %}
                            <h4 class="card__title print-only">{{ cost_title }}</h4>
                            {% if section.cost_chart.hasData() %}
                                {{ ui.chart(section.cost_chart, cost_title) }}
                            {% endif %}
                            {% if section.costs is empty %}
                                <p class="muted">{{ 'fuel.chart.need_more'|trans }}</p>
                            {% else %}
                                <div class="table-wrap">
                                    <table class="table chart-table">
                                        <caption class="visually-hidden">{{ cost_title }}</caption>
                                        <thead>
                                            <tr>
                                                <th scope="col">{{ 'fuel.trend.column.to'|trans }}</th>
                                                <th scope="col" class="table__num">{{ 'fuel.trend.column.distance'|trans }}</th>
                                                <th scope="col" class="table__num">{{ (electric ? 'fuel.trend.column.cost_ev' : 'fuel.trend.column.cost')|trans }}</th>
                                                <th scope="col" class="table__num">{{ 'fuel.trend.column.per_distance'|trans({unit: prefs().distanceUnit.value}) }}</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for cost in section.costs|reverse %}
                                                <tr>
                                                    <th scope="row">{{ cost.endedAt|instant_date }}</th>
                                                    <td class="table__num tabular">{{ cost.distanceKm|distance }}</td>
                                                    <td class="table__num tabular">{{ cost.cost|money(currency) }}</td>
                                                    <td class="table__num tabular">{{ cost.costPerKm|per_distance(currency) }}</td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                                <p class="field__hint">{{ (electric ? 'fuel.trend.cost_hint_ev' : 'fuel.trend.cost_hint')|trans }}</p>
                            {% endif %}
                        </div>
                    </section>
                    <section class="card" aria-labelledby="price-{{ section.kind.value }}">
                        <h3 id="price-{{ section.kind.value }}" class="card__title">{{ 'fuel.chart.price_title'|trans }}</h3>
                        {% if section.price_chart.pointCount() >= 2 %}
                            {{ ui.chart(section.price_chart, 'fuel.chart.price_title'|trans) }}
                            {{ ui.chart_table(section.price_chart, 'fuel.chart.price_title'|trans) }}
                        {% else %}
                            <p class="muted">{{ 'fuel.chart.need_two'|trans }}</p>
                        {% endif %}
                    </section>
                </div>

                {% set monthly = section.monthly %}
                {% if monthly.hasFigures() %}
                    {% set monthly_title = (electric ? 'fuel.monthly.title_ev' : 'fuel.monthly.title')|trans %}
                    <section class="card" aria-labelledby="monthly-{{ section.kind.value }}">
                        <h3 id="monthly-{{ section.kind.value }}" class="card__title">{{ monthly_title }}</h3>
                        {% if section.monthly_chart.hasData() %}
                            {{ ui.chart(section.monthly_chart, monthly_title) }}
                        {% endif %}
                        <div class="table-wrap">
                            <table class="table">
                                <caption class="visually-hidden">{{ monthly_title }}</caption>
                                <thead>
                                    <tr>
                                        <th scope="col">{{ 'fuel.monthly.month'|trans }}</th>
                                        {% for year in monthly.years() %}
                                            <th scope="col" class="table__num">{{ year }}</th>
                                        {% endfor %}
                                        <th scope="col" class="table__num">{{ 'fuel.monthly.average'|trans }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for month in 1..12 %}
                                        <tr>
                                            <th scope="row">{{ month|month_name }}</th>
                                            {% for year in monthly.years() %}
                                                {% set cell = monthly.cell(year, month) %}
                                                <td class="table__num tabular">{{ cell and cell.hasFigure() ? cell.distanceKm|economy(cell.volume, electric) : dash }}</td>
                                            {% endfor %}
                                            {% set average = monthly.average(month) %}
                                            <td class="table__num tabular"><strong>{{ average.hasFigure() ? average.distanceKm|economy(average.volume, electric) : dash }}</strong></td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                        <p class="field__hint">{{ 'fuel.monthly.hint'|trans({distance: constant('Logbook\\Domain\\Fuel\\MonthlyEconomyRow::MIN_DISTANCE_KM')|about_distance}) }}</p>
                    </section>
                {% endif %}
            </section>
        {% endfor %}

        <section class="card" aria-labelledby="fills-heading">
            <div class="card__header">
                <h2 id="fills-heading" class="card__title">{{ (to_check ? 'fuel.check.to_check_title' : 'fuel.fills')|trans }}</h2>
                {% if to_check %}
                    <a class="btn btn--ghost" href="{{ url_for('fuel.index', {id: vehicle.id}) }}">{{ 'fuel.check.show_all'|trans }}</a>
                {% endif %}
            </div>
            {% if to_check and rows is empty %}
                <div class="empty">
                    {{ ui.icon('check_circle') }}
                    <p class="empty__title">{{ 'fuel.check.none_title'|trans }}</p>
                    <p>{{ 'fuel.check.none_body'|trans }}</p>
                </div>
            {% elseif history.isEmpty() %}
                <div class="empty">
                    {{ ui.icon(vehicle.data.fuelType.isElectric() ? 'ev_station' : 'local_gas_station') }}
                    <p class="empty__title">{{ 'fuel.empty_title'|trans }}</p>
                    <p>{{ 'fuel.empty_body'|trans }}</p>
                </div>
            {% else %}
                <ul class="list">
                    {% for fill in rows %}
                        {{ fuel_ui.row(fill, vehicle, currency, attachment_counts.of('fuel', fill.entry.id), {
                            check: checks.for(fill.entry.id),
                            csrf: csrf,
                            return_to: current_path,
                            open: to_check,
                        }) }}
                    {% endfor %}
                </ul>
                {{ ui.pagination(pagination, 'fuel.index', {id: vehicle.id}, trend.query()|merge(to_check ? {check: 1} : {})) }}
                <p class="field__hint">{{ 'fuel.full_to_full_note'|trans }}</p>
            {% endif %}
        </section>
    </div>
{% endblock %}
