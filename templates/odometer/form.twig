{% extends 'layout.twig' %}
{% import 'macros/ui.twig' as ui %}
{% import 'macros/attachments.twig' as files %}

{% set active_nav = 'garage' %}
{% set editing = reading is not null %}
{% set heading = (editing ? 'odometer.edit_title' : 'odometer.add_title')|trans %}
{% set distance_symbol = ('units.symbol.' ~ prefs().distanceUnit.value)|trans %}

{% block title %}{{ heading }} · {{ vehicle.name() }} · {{ parent() }}{% endblock %}

{% block content %}
    <div class="page__stack page__stack--narrow">
        <a class="back-link" href="{{ url_for('odometer.index', {id: vehicle.id}) }}">{{ ui.icon('chevron_left') }}{{ 'odometer.title'|trans }} · {{ vehicle.name() }}</a>

        <header class="page-header">
            <div>
                <p class="page-header__eyebrow">{{ vehicle.name() }}</p>
                <h1 class="page-header__title">{{ heading }}</h1>
            </div>
        </header>

        {% block modal_body %}
        {% if modal %}<p class="modal-fragment__context">{{ vehicle.name() }}{% if vehicle.data.registration %} · {{ vehicle.data.registration }}{% endif %}</p>{% endif %}
        {% if errors is not empty %}
            <div class="alert alert--error" role="alert">{{ ui.icon('error') }}<span>{{ 'form.has_errors'|trans }}</span></div>
        {% endif %}

        <form class="form" method="post" enctype="multipart/form-data" action="{{ editing ? url_for('odometer.edit', {id: vehicle.id, reading: reading.id}) : url_for('odometer.create', {id: vehicle.id}) }}">
            {{ ui.csrf(csrf) }}
            {{ ui.return_field(return_to) }}

            <section class="card">
                {% set latest_hint = latest and (not editing or latest.id != reading.id)
                    ? 'odometer.hint.latest'|trans({reading: latest.readingKm|distance, date: latest.recordedAt|instant_date})
                    : 'odometer.hint.first'|trans %}
                {{ ui.input('reading', 'odometer.field.reading'|trans, values, errors, {type: 'number', required: true, step: 'any', min: 0, inputmode: 'decimal', suffix: distance_symbol, hint: latest_hint}) }}
                {{ ui.input('recorded_at', 'odometer.field.recorded_at'|trans, values, errors, {type: 'datetime-local', required: true, hint: 'form.hint.timezone'|trans({zone: prefs().timezone})}) }}
                {{ ui.input('note', 'odometer.field.note'|trans, values, errors, {optional: true, maxlength: 255, hint: 'odometer.hint.note'|trans}) }}
                <p class="field__hint">{{ 'odometer.hint.warn_not_block'|trans }}</p>
            </section>

            {# Only manual readings take files: a derived reading is edited through its entry. #}
            {{ files.card(vehicle, attachments, errors, max_upload_mb, max_upload_files) }}

            <div class="btn-row">
                <button type="submit" class="btn btn--primary btn--lg">{{ ui.icon('check_circle') }}{{ (editing ? 'form.save' : 'odometer.add_submit')|trans }}</button>
                <a data-modal-cancel class="btn btn--lg" href="{{ return_to ?: (url_for('odometer.index', {id: vehicle.id})) }}">{{ 'form.cancel'|trans }}</a>
                {% if editing %}
                    <a class="btn btn--lg btn--danger btn--push" href="{{ url_for('odometer.delete', {id: vehicle.id, reading: reading.id}) }}">{{ ui.icon('delete') }}{{ 'form.delete'|trans }}</a>
                {% endif %}
            </div>
        </form>
        {% endblock %}
    </div>
{% endblock %}
