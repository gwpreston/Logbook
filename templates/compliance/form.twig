{% extends 'layout.twig' %}
{% import 'macros/ui.twig' as ui %}
{% import 'macros/attachments.twig' as files %}
{#
 # One template for adding and editing a document: the edit form posts every
 # field the create form does, back to the document's own URL.
 #}

{% set active_nav = 'garage' %}
{% set editing = document is not null %}
{% set heading = (editing ? 'compliance.edit_title' : 'compliance.add_title')|trans %}
{% set distance_symbol = ('units.symbol.' ~ prefs().distanceUnit.value)|trans %}

{% block title %}{{ heading }} · {{ vehicle.name() }} · {{ parent() }}{% endblock %}

{% block content %}
    <div class="page__stack page__stack--narrow">
        <a class="back-link" href="{{ url_for('compliance.index', {id: vehicle.id}) }}">{{ ui.icon('chevron_left') }}{{ 'compliance.title'|trans }} · {{ vehicle.name() }}</a>

        <header class="page-header">
            <div>
                <p class="page-header__eyebrow">{{ vehicle.name() }}{% if vehicle.data.registration %} · {{ vehicle.data.registration }}{% endif %}</p>
                <h1 class="page-header__title">{{ heading }}</h1>
            </div>
        </header>

        {% block modal_body %}
        {% if modal %}<p class="modal-fragment__context">{{ vehicle.name() }}{% if vehicle.data.registration %} · {{ vehicle.data.registration }}{% endif %}</p>{% endif %}
        {% if errors is not empty %}
            <div class="alert alert--error" role="alert">{{ ui.icon('error') }}<span>{{ 'form.has_errors'|trans }}</span></div>
        {% endif %}

        <form class="form" method="post" enctype="multipart/form-data"
              action="{{ editing ? url_for('compliance.edit', {id: vehicle.id, document: document.id}) : url_for('compliance.create', {id: vehicle.id}) }}">
            {{ ui.csrf(csrf) }}
            {% include 'ask/_draft_notice.twig' %}
            {{ ui.return_field(return_to) }}

            <section class="card">
                {{ ui.chips('type', 'compliance.field.type'|trans, values, errors,
                    types|map(t => {value: t.value, label: ('compliance.type.' ~ t.value)|trans, icon: t.icon()}), {required: true}) }}
                {{ ui.input('title', 'compliance.field.title'|trans, values, errors, {optional: true, maxlength: 150, hint: 'compliance.hint.title'|trans}) }}
                <div class="form-row">
                    {{ ui.input('provider', 'compliance.field.provider'|trans, values, errors, {optional: true, maxlength: 100, hint: 'compliance.hint.provider'|trans}) }}
                    {{ ui.input('reference', 'compliance.field.reference'|trans, values, errors, {optional: true, maxlength: 100}) }}
                </div>
                <div class="form-row">
                    {{ ui.input('start_on', 'compliance.field.start_on'|trans, values, errors, {type: 'date', optional: true}) }}
                    {{ ui.input('expiry_on', 'compliance.field.expiry_on'|trans, values, errors, {type: 'date', optional: true, hint: 'compliance.hint.expiry_on'|trans}) }}
                </div>
                <div class="form-row">
                    {{ ui.input('cost', 'compliance.field.cost'|trans, values, errors, {type: 'number', optional: true, step: 'any', min: 0, inputmode: 'decimal', suffix: currency_symbol(currency), hint: 'compliance.hint.cost'|trans}) }}
                    {{ ui.input('odometer', 'compliance.field.odometer'|trans, values, errors, {type: 'number', optional: true, step: 'any', min: 0, inputmode: 'decimal', suffix: distance_symbol, hint: 'compliance.hint.odometer'|trans}) }}
                </div>
                <div class="field">
                    <label class="field__label" for="f-notes">{{ 'compliance.field.notes'|trans }} <span class="field__optional">{{ 'form.optional'|trans }}</span></label>
                    <textarea class="textarea" id="f-notes" name="notes" rows="3" maxlength="1000"{{ ui.described_by('notes', errors, false) }}>{{ values.notes ?? '' }}</textarea>
                    {{ ui.field_error(errors, 'notes') }}
                </div>
            </section>

            {{ files.card(vehicle, attachments, errors, max_upload_mb, max_upload_files) }}

            <div class="btn-row">
                <button type="submit" class="btn btn--primary btn--lg">{{ ui.icon('check_circle') }}{{ (editing ? 'form.save' : 'compliance.add_submit')|trans }}</button>
                <a data-modal-cancel class="btn btn--lg" href="{{ return_to ?: (url_for('compliance.index', {id: vehicle.id})) }}">{{ 'form.cancel'|trans }}</a>
                {% if editing %}
                    <a class="btn btn--lg btn--danger btn--push" href="{{ url_for('compliance.delete', {id: vehicle.id, document: document.id}) }}">{{ ui.icon('delete') }}{{ 'form.delete'|trans }}</a>
                {% endif %}
            </div>
        </form>
        {% endblock %}
    </div>
{% endblock %}
