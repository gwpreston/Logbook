{% extends 'layout.twig' %}
{% import 'macros/ui.twig' as ui %}

{% set active_nav = 'home' %}
{% set widget_links = {
    fleet: {route: 'garage', label: 'dashboard.link.garage'},
    reminders: {route: 'reminders.index', label: 'reminders.view_all'},
    calendar: {route: 'reminders.calendar', label: 'dashboard.link.calendar'},
    coming_up: {route: 'upcoming', label: 'coming_up.view_all'},
    spend: {route: 'reports.index', label: 'dashboard.link.reports'},
    expense_breakdown: {route: 'reports.index', label: 'dashboard.link.reports'},
    monthly_expenses: {route: 'reports.index', label: 'dashboard.link.reports'},
    recent_activity: {route: 'history.fleet', label: 'history.view_all'},
    business_mileage: {route: 'trips.claim', label: 'dashboard.link.claim'},
    insights: {route: 'insights', label: 'insights.all'},
} %}
{% set widgets = customise ? dashboard.available : dashboard.visible() %}
{% set selected = dashboard.selected %}

{% block content %}
    <div class="page__stack">
        <header class="page-header">
            <div>
                <p class="page-header__eyebrow">{{ today|local_date(constant('IntlDateFormatter::FULL')) }}</p>
                <h1 class="page-header__title">{{ 'home.greeting'|trans({name: user.displayName}) }}</h1>
                {% if not dashboard.hasVehicles() %}<p class="page-header__lead">{{ 'home.intro'|trans }}</p>{% endif %}
            </div>
            {% if dashboard.hasVehicles() %}
                {% if customise %}
                    <a class="btn btn--primary" href="{{ url_for('home') }}">{{ ui.icon('check') }}{{ 'dashboard.done'|trans }}</a>
                {% else %}
                    <a class="btn" href="{{ url_for('home', {}, {customise: '1'}) }}">{{ ui.icon('tune') }}{{ 'dashboard.customise'|trans }}</a>
                {% endif %}
            {% endif %}
        </header>

        {% if not customise %}
            {% include 'dashboard/_admin_notices.twig' with {notices: admin_notices()} %}
        {% endif %}

        {% if dashboard.hasVehicles() and not customise and ask_available() %}
            {# Ask Logbook (spec.md §7.26). #}
            <p class="dashboard-ask"><a class="btn btn--soft" href="{{ url_for('ask') }}" data-ask-entry>{{ ui.icon('forum') }}{{ 'ask.dashboard_link'|trans }}</a></p>
        {% endif %}

        {# Vehicle filter (spec.md §7.8): plain links, so it works without JS and can be bookmarked. #}
        {% if dashboard.hasFilter() and not customise %}
            <nav class="vehicle-filter" aria-label="{{ 'dashboard.filter.label'|trans }}">
                <ul class="vehicle-filter__list">
                    <li>
                        <a class="chip vehicle-filter__chip" href="{{ url_for('home') }}"{% if not selected %} aria-current="page"{% endif %}>{{ ui.icon('apps') }}<span>{{ 'dashboard.filter.all'|trans }}</span></a>
                    </li>
                    {% for vehicle in dashboard.vehicles %}
                        <li>
                            <a class="chip vehicle-filter__chip" href="{{ url_for('home', {}, {vehicle: vehicle.id}) }}"{% if selected and selected.id == vehicle.id %} aria-current="page"{% endif %}>{{ ui.icon(vehicle.data.type.icon()) }}<span>{{ vehicle.name() }}</span></a>
                        </li>
                    {% endfor %}
                </ul>
            </nav>
        {% endif %}

        {% if dashboard.pinned %}
            {% include 'dashboard/_pinned.twig' with {pinned: dashboard.pinned} %}
        {% endif %}

        {% if review_drafts is not empty and not customise %}
            {# Drafts an MCP client left (spec.md §7.28), above the widgets while there are any. #}
            {% include 'ask/_review_drafts.twig' with {review_drafts: review_drafts, back: 'home'} %}
        {% endif %}

        {% if not dashboard.hasVehicles() %}
            <section class="card" aria-labelledby="garage-heading">
                <div class="card__header">
                    <h2 id="garage-heading" class="card__title">{{ trans('home.vehicle_count', {count: 0}) }}</h2>
                    {% if dashboard.archivedCount > 0 %}
                        <a class="card__link" href="{{ url_for('garage', {}, {archived: '1'}) }}">{{ 'dashboard.fleet.archived'|trans({count: dashboard.archivedCount}) }}</a>
                    {% endif %}
                </div>
                <div class="empty">
                    {{ ui.icon('garage') }}
                    <p class="empty__title">{{ 'garage.empty_title'|trans }}</p>
                    <p>{{ 'garage.empty_body'|trans }}</p>
                    <a class="btn btn--primary" href="{{ url_for('vehicles.create') }}" data-modal>{{ ui.icon('add') }}{{ 'garage.add_vehicle'|trans }}</a>
                </div>
            </section>
        {% else %}
            {% if customise %}
                <div class="alert alert--info customise-bar" role="status">
                    {{ ui.icon('drag_indicator') }}
                    <span>{{ 'dashboard.customise_hint'|trans }}</span>
                    <form method="post" action="{{ url_for('dashboard.layout') }}" class="customise-bar__reset">
                        {{ ui.csrf(csrf) }}
                        <button type="submit" name="reset" value="1" class="btn btn--ghost">{{ ui.icon('restart_alt') }}{{ 'dashboard.reset'|trans }}</button>
                    </form>
                </div>
                {# Drag and drop (js/app.js) posts the new order with this form's token. #}
                <form method="post" action="{{ url_for('dashboard.layout') }}" data-dashboard-order hidden>
                    {{ ui.csrf(csrf) }}
                    <input type="hidden" name="order" value="">
                </form>
            {% endif %}

            {% if widgets is empty %}
                <div class="card empty">
                    {{ ui.icon('space_dashboard') }}
                    <p class="empty__title">{{ 'dashboard.all_hidden_title'|trans }}</p>
                    <p><a href="{{ url_for('home', {}, {customise: '1'}) }}">{{ 'dashboard.all_hidden_body'|trans }}</a></p>
                </div>
            {% endif %}

            <div class="dashboard{{ customise ? ' dashboard--customise' }}"{% if customise %} data-dashboard-sortable{% endif %}>
                {% for widget in widgets %}
                    {% set hidden = dashboard.isHidden(widget) %}
                    {% set title = ('dashboard.widget.' ~ widget.value)|trans %}
                    {% set link = widget_links[widget.value] ?? null %}
                    <section class="widget{{ widget.isWide() ? ' widget--wide' }}{{ hidden ? ' widget--hidden' }}" id="widget-{{ widget.value }}" data-widget="{{ widget.value }}" aria-labelledby="widget-{{ widget.value }}-title">
                        <div class="widget__header">
                            {% if customise %}<span class="widget__handle" data-drag-handle hidden>{{ ui.icon('drag_indicator') }}</span>{% endif %}
                            <span class="widget__icon">{{ ui.icon(widget.icon()) }}</span>
                            <h2 class="widget__title" id="widget-{{ widget.value }}-title">{{ title }}</h2>
                            {% if customise %}
                                <form method="post" action="{{ url_for('dashboard.layout') }}" class="widget__controls">
                                    {{ ui.csrf(csrf) }}
                                    <input type="hidden" name="widget" value="{{ widget.value }}">
                                    <button type="submit" name="move" value="up" class="icon-btn"{% if loop.first %} disabled{% endif %}>{{ ui.icon('arrow_upward') }}<span class="visually-hidden">{{ 'dashboard.move_up'|trans({widget: title}) }}</span></button>
                                    <button type="submit" name="move" value="down" class="icon-btn"{% if loop.last %} disabled{% endif %}>{{ ui.icon('arrow_downward') }}<span class="visually-hidden">{{ 'dashboard.move_down'|trans({widget: title}) }}</span></button>
                                    <button type="submit" name="toggle" value="1" class="icon-btn" aria-pressed="{{ hidden ? 'false' : 'true' }}">{{ ui.icon(hidden ? 'visibility_off' : 'visibility') }}<span class="visually-hidden">{{ (hidden ? 'dashboard.show' : 'dashboard.hide')|trans({widget: title}) }}</span></button>
                                </form>
                            {% elseif link and (widget.value != 'spend' or feature_enabled('reports')) %}
                                {# The fleet history and Coming up keep the chosen vehicle; the spend widgets
                                   open Reports for their vehicles and period (spec.md §7.8). #}
                                {% if widget.value == 'expense_breakdown' and dashboard.expenseBreakdown %}
                                    {% set link_query = dashboard.expenseBreakdown.reportQuery() %}
                                {% elseif widget.value == 'monthly_expenses' and dashboard.monthlySpend %}
                                    {% set link_query = dashboard.monthlySpend.reportQuery() %}
                                {% elseif widget.value == 'calendar' and dashboard.calendar %}
                                    {# The calendar page for the month shown, and the chosen vehicle (spec.md §7.8 *Calendar*). #}
                                    {% set link_query = {month: dashboard.calendar.key()}|merge(selected ? {vehicle: selected.id} : {}) %}
                                {% else %}
                                    {% set link_query = widget.value in ['recent_activity', 'coming_up'] and selected ? {vehicle: selected.id} : {} %}
                                {% endif %}
                                <a class="card__link" href="{{ url_for(link.route, {}, link_query) }}">{{ link.label|trans }}</a>
                            {% endif %}
                        </div>
                        {% if hidden %}
                            <p class="muted widget__hidden-note">{{ 'dashboard.hidden_note'|trans }}</p>
                        {% else %}
                            {% include 'dashboard/_' ~ widget.value ~ '.twig' %}
                        {% endif %}
                    </section>
                {% endfor %}
            </div>
        {% endif %}
    </div>
{% endblock %}
