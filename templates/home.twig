{% extends 'layout.twig' %}
{% import 'macros/ui.twig' as ui %}
{% import 'macros/vehicles.twig' as vehicle_ui %}

{% set active_nav = 'home' %}

{% block content %}
    <div class="page__stack">
        <header class="page-header">
            <div>
                <p class="page-header__eyebrow">{{ today|local_date(constant('IntlDateFormatter::FULL')) }}</p>
                <h1 class="page-header__title">{{ 'home.greeting'|trans({name: user.displayName}) }}</h1>
                <p class="page-header__lead">{{ 'home.intro'|trans }}</p>
            </div>
        </header>

        <section class="card" aria-labelledby="garage-heading">
            <div class="card__header">
                <h2 id="garage-heading" class="card__title">{{ trans('home.vehicle_count', {count: counts.active}) }}</h2>
                {% if counts.active > 0 or counts.archived > 0 %}
                    <a class="card__link" href="{{ url_for('garage') }}">{{ 'home.open_garage'|trans }}</a>
                {% endif %}
            </div>
            {% if vehicles is empty %}
                <div class="empty">
                    {{ ui.icon('garage') }}
                    <p class="empty__title">{{ 'garage.empty_title'|trans }}</p>
                    <p>{{ 'garage.empty_body'|trans }}</p>
                    <a class="btn btn--primary" href="{{ url_for('vehicles.create') }}">{{ ui.icon('add') }}{{ 'garage.add_vehicle'|trans }}</a>
                </div>
            {% else %}
                <div class="vehicle-grid">
                    {% for vehicle in vehicles %}
                        {{ vehicle_ui.card(vehicle) }}
                    {% endfor %}
                </div>
            {% endif %}
        </section>

        {% if counts.active > 0 %}
            <section class="card" aria-labelledby="reminders-heading">
                <div class="card__header">
                    <h2 id="reminders-heading" class="card__title">{{ 'reminders.attention'|trans({count: reminders.attentionCount()}) }}</h2>
                    <a class="card__link" href="{{ url_for('reminders.index') }}">{{ 'reminders.view_all'|trans }}</a>
                </div>
                {% if top_reminders is empty %}
                    <p class="muted">{{ 'reminders.empty_body'|trans }}</p>
                {% else %}
                    <ul class="list">
                        {% for entry in top_reminders %}
                            {% set reminder = entry.reminder %}
                            <li class="list__item">
                                <span class="list__icon">{{ ui.icon(reminder.icon()) }}</span>
                                <span class="list__body">
                                    <a class="list__title" href="{{ url_for('reminders.index') }}">{{ wording.name(reminder) }}</a>
                                    <span class="list__meta">{{ entry.vehicle.name() }}</span>
                                </span>
                                <span class="list__end">
                                    <span class="pill{{ reminder.status.tone() ? ' pill--' ~ reminder.status.tone() }}">{{ wording.when(reminder, reminders.today) }}</span>
                                </span>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </section>
        {% endif %}

        <section class="card" aria-labelledby="coming-heading">
            <div class="card__header">
                <h2 id="coming-heading" class="card__title">{{ 'home.coming_heading'|trans }}</h2>
            </div>
            <p class="muted">{{ 'home.coming_body'|trans }}</p>
        </section>
    </div>
{% endblock %}
