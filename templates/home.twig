{% extends 'layout.twig' %}
{% import 'macros/ui.twig' as ui %}
{% import 'macros/vehicles.twig' as vehicle_ui %}

{% set active_nav = 'home' %}

{% block content %}
    <div class="page__stack">
        <header class="page-header">
            <div>
                <p class="page-header__eyebrow">{{ today|local_date(constant('IntlDateFormatter::FULL')) }}</p>
                <h1 class="page-header__title">{{ 'home.greeting'|trans({name: user.displayName}) }}</h1>
                <p class="page-header__lead">{{ 'home.intro'|trans }}</p>
            </div>
        </header>

        <section class="card" aria-labelledby="garage-heading">
            <div class="card__header">
                <h2 id="garage-heading" class="card__title">{{ trans('home.vehicle_count', {count: counts.active}) }}</h2>
                {% if counts.active > 0 or counts.archived > 0 %}
                    <a class="card__link" href="{{ url_for('garage') }}">{{ 'home.open_garage'|trans }}</a>
                {% endif %}
            </div>
            {% if vehicles is empty %}
                <div class="empty">
                    {{ ui.icon('garage') }}
                    <p class="empty__title">{{ 'garage.empty_title'|trans }}</p>
                    <p>{{ 'garage.empty_body'|trans }}</p>
                    <a class="btn btn--primary" href="{{ url_for('vehicles.create') }}">{{ ui.icon('add') }}{{ 'garage.add_vehicle'|trans }}</a>
                </div>
            {% else %}
                <div class="vehicle-grid">
                    {% for vehicle in vehicles %}
                        {{ vehicle_ui.card(vehicle) }}
                    {% endfor %}
                </div>
            {% endif %}
        </section>

        <section class="card" aria-labelledby="coming-heading">
            <div class="card__header">
                <h2 id="coming-heading" class="card__title">{{ 'home.coming_heading'|trans }}</h2>
            </div>
            <p class="muted">{{ 'home.coming_body'|trans }}</p>
        </section>
    </div>
{% endblock %}
