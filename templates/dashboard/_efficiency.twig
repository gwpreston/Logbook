{# Efficiency trend: each vehicle's 12-month average economy, and per-fill economy over time. #}
{% import 'macros/ui.twig' as ui %}
{% if dashboard.efficiency is empty %}
    <p class="muted">{{ 'dashboard.efficiency.empty'|trans }}</p>
{% else %}
    <ul class="list">
        {% for row in dashboard.efficiency %}
            {% set electric = row.isElectric() %}
            {% set last = row.last() %}
            <li class="list__item">
                <span class="list__icon">{{ ui.icon(electric ? 'ev_station' : row.vehicle.data.type.icon()) }}</span>
                <span class="list__body">
                    <a class="list__title" href="{{ url_for('fuel.index', {id: row.vehicle.id}) }}">{{ row.vehicle.name() }}</a>
                    <span class="list__meta">
                        {%- if last and last.segment -%}
                            {{ 'dashboard.efficiency.last'|trans({economy: last.segment.distanceKm|economy(last.segment.volume, electric)}) }}
                        {%- else -%}
                            {{ 'dashboard.efficiency.not_yet'|trans }}
                        {%- endif -%}
                    </span>
                </span>
                <span class="list__end">
                    <span class="list__amount tabular">{{ row.hasEconomy() ? row.distanceKm()|economy(row.volume(), electric) : '—' }}</span>
                    <span class="list__meta">{{ 'dashboard.efficiency.average'|trans }}</span>
                </span>
            </li>
        {% endfor %}
    </ul>
    {% if efficiency_chart %}
        {{ ui.chart(efficiency_chart, 'dashboard.efficiency.chart_label'|trans) }}
    {% endif %}
{% endif %}
