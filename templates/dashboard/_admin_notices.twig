{#
 # The admin notice area (spec.md §7.30): the scheduler warning and job
 # failure streaks, admins only. Each links to its page and has Dismiss
 # (24 hours, for this admin).
 #}
{% import 'macros/ui.twig' as ui %}
{% if notices is not empty %}
    <section class="admin-notices" aria-label="{{ 'notices.label'|trans }}">
        {% for notice in notices %}
            <div class="alert alert--{{ notice.level == 'error' ? 'error' : 'warning' }} admin-notice" role="status" data-admin-notice="{{ notice.key }}">
                {{ ui.icon(notice.level == 'error' ? 'error' : 'warning') }}
                <span class="admin-notice__text">
                    {%- set params = notice.params|filter(v => v is not null) -%}
                    {%- if params.time ?? null %}{% set params = params|merge({time: params.time|local_datetime}) %}{% endif -%}
                    {%- if params.job ?? null %}{% set params = params|merge({job: ('jobs.job.' ~ params.job ~ '.title')|trans}) %}{% endif -%}
                    {{ trans(notice.messageKey, params) }}
                    <a href="{{ url_for(notice.linkRoute, notice.linkData) }}">{{ notice.linkLabelKey|trans }}</a>
                </span>
                <form method="post" action="{{ url_for('notices.dismiss', {key: notice.key}) }}" class="admin-notice__dismiss">
                    {{ ui.csrf(csrf) }}
                    <button type="submit" class="btn btn--ghost">{{ 'notices.dismiss'|trans }}</button>
                </form>
            </div>
        {% endfor %}
    </section>
{% endif %}
