{# Insights (spec.md §7.8, Phase 33.3): the first two observations worked
   out from figures Logbook already has, each a link to the page that shows
   the figure. The body is clamped to three lines on screen; the whole text
   stays in the page for screen readers. #}
{% import 'macros/ui.twig' as ui %}
{% set insights = dashboard.insights ?? [] %}
{# Today's AI insights join them, from the cache (spec.md §7.26 *AI insights*): up to two, marked as AI. #}
{% set ai_insights = dashboard.aiInsights ? dashboard.aiInsights.insights|slice(0, 2) : [] %}
{% if insights is empty and ai_insights is empty %}
    <p class="muted insights__empty">{{ 'insights.nothing'|trans }}</p>
{% else %}
    <ul class="insights">
        {% for insight in insights %}
            <li>
                <a class="insight" href="{{ url_for(insight.route, insight.routeParams, insight.query) }}" data-insight="{{ insight.kind.value }}">
                    <span class="insight__tile insight__tile--{{ insight.tone.value }}">{{ ui.icon(insight.icon()) }}</span>
                    <span class="insight__text">
                        <span class="insight__title">{{ insight.title|trans(insight.titleParams) }}</span>
                        <span class="insight__body">{{ insight.body|trans(insight.bodyParams) }}</span>
                    </span>
                </a>
            </li>
        {% endfor %}
        {% for insight in ai_insights %}
            <li>
                <a class="insight" href="{{ url_for('insights') }}#ai-insights" data-ai-insight>
                    <span class="insight__tile">{{ ui.icon('auto_awesome') }}</span>
                    <span class="insight__text">
                        <span class="insight__title">{{ insight.title|ask_marked(insight.ungrounded) }} <span class="pill insight-card__ai">{{ 'ai_insights.mark'|trans }}</span></span>
                        <span class="insight__body">{{ insight.body|ask_marked(insight.ungrounded) }}</span>
                    </span>
                </a>
            </li>
        {% endfor %}
    </ul>
{% endif %}
