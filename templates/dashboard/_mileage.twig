{# Mileage: this month, this year and the monthly average, in the owner's distance unit (spec.md §7.8). #}
{% set mileage = dashboard.mileage %}
{% set dash = '—' %}
<dl class="figures">
    <div class="figures__item">
        <dt>{{ 'dashboard.mileage.this_month'|trans }}</dt>
        <dd class="figures__value tabular">{{ mileage and mileage.thisMonthKm is not null ? mileage.thisMonthKm|distance : dash }}</dd>
    </div>
    <div class="figures__item">
        <dt>{{ 'dashboard.mileage.this_year'|trans }}</dt>
        <dd class="figures__value tabular">{{ mileage and mileage.thisYearKm is not null ? mileage.thisYearKm|distance : dash }}</dd>
    </div>
    <div class="figures__item">
        <dt>{{ 'dashboard.mileage.monthly_average'|trans }}</dt>
        <dd class="figures__value tabular">{{ mileage and mileage.monthlyAverageKm is not null ? mileage.monthlyAverageKm|distance : dash }}</dd>
    </div>
</dl>
