{# Your vehicles: a photo tile per active vehicle with its odometer and "N due" (spec.md §7.8). #}
{% import 'macros/vehicles.twig' as vehicle_ui %}
<ul class="vehicle-tiles">
    {% for snapshot in dashboard.fleet %}
        <li>{{ vehicle_ui.tile(snapshot) }}</li>
    {% endfor %}
</ul>
{% if dashboard.archivedCount > 0 %}
    <p class="widget__foot"><a href="{{ url_for('garage', {}, {archived: '1'}) }}">{{ 'dashboard.fleet.archived'|trans({count: dashboard.archivedCount}) }}</a></p>
{% endif %}
