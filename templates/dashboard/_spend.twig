{# Spend this month, per currency and group, against last month. #}
{% import 'macros/expenses.twig' as exp %}
{% set current = dashboard.spendThisMonth %}
{% set previous = dashboard.spendLastMonth %}
{% for section in current ? current.currencies : [] %}
    {% set before = previous ? (previous.currencies|filter(s => s.currency == section.currency)|first) : null %}
    <div class="spend">
        <p class="figure tabular">{{ section.total|money }}</p>
        <p class="muted">
            {{- 'dashboard.spend.so_far'|trans({month: today|local_month(false)}) -}}
            {%- if before %} · {{ 'dashboard.spend.last_month'|trans({amount: before.total|money}) }}{% endif -%}
        </p>
        {% if section.total.isZero() %}
            <p class="muted">{{ 'dashboard.spend.nothing'|trans }}</p>
        {% else %}
            <div class="stack-bar" aria-hidden="true">
                {% for total in section.spentGroups() %}
                    <span class="stack-bar__part" style="--w: {{ total.share|round(1) }}%; --swatch: var(--{{ total.group.color() }})"></span>
                {% endfor %}
            </div>
            <ul class="legend">
                {% for total in section.spentGroups() %}
                    <li class="legend__item">{{ exp.swatch(total.group) }}<span class="legend__label">{{ ('expense.group.' ~ total.group.value)|trans }}</span><span class="legend__value tabular">{{ total.amount|money }}</span></li>
                {% endfor %}
            </ul>
        {% endif %}
    </div>
{% endfor %}
