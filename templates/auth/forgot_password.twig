{% extends 'layout.twig' %}
{% import 'macros/ui.twig' as ui %}

{#
 # Forgotten password (spec.md §7.9): the same answer whatever was typed,
 # so it never shows which accounts exist. *Send it again* posts the same
 # text once more; the newer link replaces the older.
 #}
{% block title %}{{ 'auth.forgot.title'|trans }} · {{ parent() }}{% endblock %}

{% block content %}
    <div class="auth">
        <section class="card auth__card" aria-labelledby="forgot-heading">
            <a class="back-link" href="{{ url_for('login') }}">{{ ui.icon('chevron_left') }}{{ 'auth.forgot.back'|trans }}</a>
            {% if sent %}
                <header class="auth__header">
                    <h1 id="forgot-heading">{{ 'auth.forgot.sent_title'|trans }}</h1>
                    <p role="status">{{ 'auth.forgot.sent'|trans({minutes: 60}) }}</p>
                    <p class="muted">{{ 'auth.forgot.sent_hint'|trans }}</p>
                </header>
                <form class="form" method="post" action="{{ url_for('password.forgot') }}">
                    {{ ui.csrf(csrf) }}
                    <input type="hidden" name="login" value="{{ typed }}">
                    <div class="btn-row">
                        <button type="submit" class="btn">{{ ui.icon('send') }}{{ 'auth.forgot.resend'|trans }}</button>
                        <a class="btn btn--ghost" href="{{ url_for('login') }}">{{ 'auth.forgot.back'|trans }}</a>
                    </div>
                </form>
            {% else %}
                <header class="auth__header">
                    <h1 id="forgot-heading">{{ 'auth.forgot.title'|trans }}</h1>
                    <p class="muted">{{ 'auth.forgot.lead'|trans }}</p>
                </header>
                <form class="form" method="post" action="{{ url_for('password.forgot') }}">
                    {{ ui.csrf(csrf) }}
                    {{ ui.input('login', 'auth.username_or_email'|trans, {}, {}, {required: true, autocomplete: 'username', maxlength: 254}) }}
                    <button type="submit" class="btn btn--primary btn--lg btn--block">{{ ui.icon('send') }}{{ 'auth.forgot.submit'|trans }}</button>
                </form>
            {% endif %}
        </section>
    </div>
{% endblock %}
