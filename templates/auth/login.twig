{% extends 'layout.twig' %}
{% import 'macros/ui.twig' as ui %}

{#
 # Sign-in (spec.md §7.9). With single sign-on configured, *Sign in with
 # {name}* comes first; with AUTH_LOCAL_LOGIN=false it is all there is.
 # Header sign-in leaves a notice when the proxy sent no usable user.
 #}
{% block title %}{{ 'auth.sign_in'|trans }} · {{ parent() }}{% endblock %}

{% block content %}
    <div class="auth">
        <section class="card auth__card" aria-labelledby="login-heading">
            <header class="auth__header">
                <h1 id="login-heading">{{ 'auth.sign_in'|trans }}</h1>
                <p class="muted">{{ (local_login ? 'auth.sign_in_lead' : 'auth.sign_in_lead_sso')|trans }}</p>
            </header>

            {% if error ?? null %}
                <div class="alert alert--error" role="alert">{{ ui.icon('error') }}<span>{{ error|trans }}</span></div>
            {% endif %}

            {% if proxy and proxy.kind in ['missing', 'not_linked', 'refused'] %}
                {# Header sign-in (spec.md §7.9 *Sign-in page*). #}
                <div class="alert {{ proxy.kind == 'missing' ? 'alert--warning' : 'alert--error' }}" role="{{ proxy.kind == 'missing' ? 'status' : 'alert' }}" data-proxy-notice="{{ proxy.kind }}">{{ ui.icon(proxy.kind == 'missing' ? 'warning' : 'error') }}<span>{{ ('proxy.' ~ proxy.kind)|trans({name: proxy.name}) }}</span></div>
            {% endif %}

            {% if sso %}
                <a class="btn btn--primary btn--lg btn--block" href="{{ url_for('oidc.start', {}, next ? {next: next} : {}) }}" data-sso-start>{{ ui.icon('verified_user') }}{{ 'sso.sign_in_with'|trans({name: sso.name}) }}</a>
            {% endif %}

            {% if local_login %}
                {% if sso %}
                    <p class="auth__or muted">{{ 'sso.or_password'|trans }}</p>
                {% endif %}
                <form class="form" method="post" action="{{ url_for('login') }}">
                    {{ ui.csrf(csrf) }}
                    {% if next %}<input type="hidden" name="next" value="{{ next }}">{% endif %}

                    {{ ui.input('username', 'auth.username'|trans, {username: username}, {}, {required: true, autocomplete: 'username', maxlength: 64}) }}
                    {{ ui.input('password', 'auth.password'|trans, {}, {}, {type: 'password', required: true, autocomplete: 'current-password'}) }}

                    <button type="submit" class="btn {{ sso ? 'btn--soft' : 'btn--primary' }} btn--lg btn--block">{{ ui.icon('login') }}{{ 'auth.sign_in'|trans }}</button>
                </form>
            {% elseif not sso %}
                <div class="alert alert--info" role="status">{{ ui.icon('info') }}<span>{{ 'auth.no_sign_in_method'|trans }}</span></div>
            {% endif %}
        </section>
    </div>
{% endblock %}
