{% extends 'layout.twig' %}
{% import 'macros/ui.twig' as ui %}

{#
 # The user's own places (spec.md §7.33 *Places*): straight-line distances
 # to stations are measured from them. Shown only to their user.
 #}
{% set active_nav = 'settings' %}

{% block title %}{{ 'places.title'|trans }} · {{ parent() }}{% endblock %}

{% block content %}
    <div class="page__stack page__stack--narrow">
        <a class="back-link" href="{{ url_for('settings') }}">{{ ui.icon('chevron_left') }}{{ 'settings.title'|trans }}</a>
        <header class="page-header">
            <div>
                <h1 class="page-header__title">{{ 'places.title'|trans }}</h1>
                <p class="page-header__lead">{{ 'places.lead'|trans }}</p>
            </div>
            <div class="btn-row">
                <a class="btn btn--primary" href="{{ url_for('settings.places.create') }}">{{ ui.icon('add') }}{{ 'places.add'|trans }}</a>
            </div>
        </header>

        <section class="card">
            {% if places is empty %}
                <div class="empty">
                    {{ ui.icon('home_pin') }}
                    <p class="empty__title">{{ 'places.empty_title'|trans }}</p>
                    <p>{{ 'places.empty_body'|trans }}</p>
                </div>
            {% else %}
                <ul class="list">
                    {% for place in places %}
                        <li class="list__item">
                            <span class="list__icon">{{ ui.icon('location_on') }}</span>
                            <span class="list__body">
                                <span class="list__title">{{ place.data.name }}</span>
                                <span class="list__meta tabular">{{ place.data.latitude }}, {{ place.data.longitude }}</span>
                            </span>
                            <span class="list__end btn-row">
                                <a class="btn" href="{{ url_for('settings.places.edit', {place: place.id}) }}">{{ ui.icon('edit') }}<span class="visually-hidden">{{ 'places.edit_named'|trans({name: place.data.name}) }}</span></a>
                                <form method="post" action="{{ url_for('settings.places.delete', {place: place.id}) }}">
                                    {{ ui.csrf(csrf) }}
                                    <button type="submit" class="btn btn--danger">{{ ui.icon('delete') }}<span class="visually-hidden">{{ 'places.delete_named'|trans({name: place.data.name}) }}</span></button>
                                </form>
                            </span>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>
        <p class="muted">{{ 'places.private'|trans }}</p>
    </div>
{% endblock %}
