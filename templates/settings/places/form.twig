{% extends 'layout.twig' %}
{% import 'macros/ui.twig' as ui %}
{% import 'macros/stations.twig' as st %}

{#
 # Add or edit a place (spec.md §7.33 *Places*): typed coordinates, a
 # station's position, or the browser's current location.
 #}
{% set active_nav = 'settings' %}
{% set editing = place is not null %}
{% set heading = (editing ? 'places.edit_title' : 'places.add_title')|trans %}
{% set suggest = values._suggest ?? '' %}

{% block title %}{{ heading }} · {{ parent() }}{% endblock %}

{% block content %}
    <div class="page__stack page__stack--narrow">
        <a class="back-link" href="{{ url_for('settings.places') }}">{{ ui.icon('chevron_left') }}{{ 'places.title'|trans }}</a>
        <header class="page-header">
            <div>
                <h1 class="page-header__title">{{ heading }}</h1>
            </div>
        </header>

        {% if not editing and stations is not empty %}
            <form class="form card" method="get" action="{{ url_for('settings.places.create') }}">
                <div class="field">
                    <label class="field__label" for="f-station">{{ 'places.from_station'|trans }}</label>
                    <select class="select" id="f-station" name="station">
                        {% for row in stations %}
                            <option value="{{ row.station.id }}">{{ row.station.data.name }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="btn-row"><button type="submit" class="btn">{{ ui.icon('content_copy') }}{{ 'places.copy_position'|trans }}</button></div>
            </form>
        {% endif %}

        {% if errors is not empty %}
            <div class="alert alert--error" role="alert">{{ ui.icon('error') }}<span>{{ 'form.has_errors'|trans }}</span></div>
        {% endif %}
        <form class="form" method="post" action="{{ editing ? url_for('settings.places.edit', {place: place.id}) : url_for('settings.places.create') }}">
            {{ ui.csrf(csrf) }}
            <section class="card">
                {{ ui.input('name', 'places.field.name'|trans, values, errors, {required: true, maxlength: 50, placeholder: suggest ? ('places.suggest.' ~ suggest)|trans : ''}) }}
                <div class="form-row">
                    {{ ui.input('latitude', 'stations.field.latitude'|trans, values, errors, {required: true, inputmode: 'decimal', placeholder: '54.7154', autocomplete: 'off'}) }}
                    {{ ui.input('longitude', 'stations.field.longitude'|trans, values, errors, {required: true, inputmode: 'decimal', placeholder: '-6.2164', autocomplete: 'off'}) }}
                </div>
                {{ st.locate_button('f-latitude', 'f-longitude') }}
                <p class="field__hint">{{ 'places.private'|trans }}</p>
            </section>
            <div class="btn-row">
                <button type="submit" class="btn btn--primary btn--lg">{{ ui.icon('check_circle') }}{{ 'form.save'|trans }}</button>
                <a class="btn btn--lg" href="{{ url_for('settings.places') }}">{{ 'form.cancel'|trans }}</a>
            </div>
        </form>
    </div>
{% endblock %}
