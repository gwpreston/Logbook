{% extends 'layout.twig' %}
{% import 'macros/ui.twig' as ui %}

{#
 # One job run (spec.md §7.30): who, when, how it went and its output.
 # While it runs, assets/js/jobs.js polls its status every 2 seconds.
 #}
{% set active_nav = 'settings' %}
{% set job_title = ('jobs.job.' ~ run.job ~ '.title')|trans %}

{% block title %}{{ 'jobs.run.title'|trans({job: job_title}) }} · {{ parent() }}{% endblock %}
{% block head %}<script defer src="{{ asset('js/jobs.js') }}"></script>{% endblock %}

{% block content %}
    <div class="page__stack page__stack--narrow"{% if not run.status.isFinished() %} data-run-poll="{{ url_for('settings.jobs.run.status', {run: run.id}) }}"{% endif %}>
        <a class="back-link" href="{{ url_for('settings.jobs') }}">{{ ui.icon('chevron_left') }}{{ 'jobs.title'|trans }}</a>

        <header class="page-header">
            <div>
                <h1 class="page-header__title">{{ 'jobs.run.title'|trans({job: job_title}) }}</h1>
                {% if run.summary %}<p class="page-header__lead">{{ run.summary }}</p>{% endif %}
            </div>
        </header>

        {% if run.status.value == 'skipped_locked' %}
            <div class="alert alert--info" role="status">
                {{ ui.icon('info') }}
                <span>
                    {%- if holder -%}
                        {{ 'jobs.run.locked'|trans({time: holder.startedAt|local_datetime, trigger: holder.trigger.labelKey()|trans}) }}
                        <a href="{{ url_for('settings.jobs.run', {run: holder.id}) }}">{{ 'jobs.run.locked_link'|trans }}</a>
                    {%- else -%}
                        {{ 'jobs.run.locked_unknown'|trans }}
                    {%- endif -%}
                </span>
            </div>
        {% endif %}

        <section class="card" aria-labelledby="run-heading">
            <h2 id="run-heading" class="card__title">{{ ui.icon('info') }}{{ 'jobs.run.details'|trans }}</h2>
            <dl class="details">
                <div><dt>{{ 'jobs.run.job'|trans }}</dt><dd>{{ job_title }}</dd></div>
                <div><dt>{{ 'jobs.run.trigger'|trans }}</dt><dd>{{ run.trigger.labelKey()|trans }}</dd></div>
                {% if run.trigger.value == 'manual' %}
                    <div><dt>{{ 'jobs.run.by'|trans }}</dt><dd>{{ run.userName ?? 'jobs.run.by_cli'|trans }}</dd></div>
                {% endif %}
                <div><dt>{{ 'jobs.run.started'|trans }}</dt><dd>{{ run.startedAt|local_datetime }}</dd></div>
                <div><dt>{{ 'jobs.run.finished'|trans }}</dt><dd>{{ run.finishedAt ? run.finishedAt|local_datetime : '—' }}</dd></div>
                {% if run.finishedAt %}
                    <div><dt>{{ 'jobs.run.duration'|trans }}</dt><dd>{{ 'jobs.run.seconds'|trans({count: run.seconds(run.finishedAt)}) }}</dd></div>
                {% endif %}
                <div><dt>{{ 'jobs.run.status'|trans }}</dt><dd data-run-status>{% include 'settings/jobs/_status.twig' with {run: run} only %}</dd></div>
            </dl>
            {% if not run.status.isFinished() %}
                <p class="muted" role="status" data-run-running>{{ 'jobs.run.still_running'|trans }}</p>
            {% endif %}
        </section>

        <section class="card" aria-labelledby="output-heading">
            <div class="card__header">
                <h2 id="output-heading" class="card__title">{{ ui.icon('description') }}{{ 'jobs.run.output'|trans }}</h2>
                <button type="button" class="btn btn--ghost" data-copy-output hidden data-text-copied="{{ 'jobs.run.copied'|trans }}">{{ ui.icon('content_copy') }}<span>{{ 'jobs.run.copy'|trans }}</span></button>
            </div>
            <pre class="code-block job-output" tabindex="0" aria-label="{{ 'jobs.run.output'|trans }}"><code data-run-output>{{ run.output ?: 'jobs.run.no_output'|trans }}</code></pre>
        </section>
    </div>
{% endblock %}
