{% extends 'layout.twig' %}
{% import 'macros/ui.twig' as ui %}

{#
 # Settings → API keys (spec.md §7.20): create a key (a name and a scope),
 # see its token once, list and revoke keys. The token is only ever in the
 # response to the create, which is not cached.
 #}
{% set active_nav = 'settings' %}

{% block title %}{{ 'api_keys.title'|trans }} · {{ parent() }}{% endblock %}

{% block content %}
    <div class="page__stack page__stack--narrow">
        <a class="back-link" href="{{ url_for('settings') }}#developers">{{ ui.icon('chevron_left') }}{{ 'settings.title'|trans }}</a>

        <header class="page-header">
            <div>
                <h1 class="page-header__title">{{ 'api_keys.title'|trans }}</h1>
                <p class="page-header__lead">{{ 'api_keys.lead'|trans }}</p>
            </div>
        </header>

        {% if not api_enabled %}
            <div class="alert alert--warning" role="note">{{ ui.icon('warning') }}<span>{{ 'api_keys.disabled'|trans }}</span></div>
        {% endif %}

        {% if created %}
            <section class="card" aria-labelledby="created-heading" data-api-key-created>
                <h2 id="created-heading" class="card__title">{{ ui.icon('key') }}{{ 'api_keys.created_heading'|trans({name: created.key.name}) }}</h2>
                <div class="alert alert--info" role="status">{{ ui.icon('info') }}<span>{{ 'api_keys.copy_now'|trans }}</span></div>
                <div class="field">
                    <label class="field__label" for="f-api-token">{{ 'api_keys.token_label'|trans }}</label>
                    <div class="input-group">
                        <input class="input tabular" id="f-api-token" type="text" readonly value="{{ created.token }}" autocomplete="off" spellcheck="false">
                        <button type="button" class="btn btn--soft" data-copy="#f-api-token" data-copied-label="{{ 'api_keys.copied'|trans }}" hidden>{{ ui.icon('content_copy') }}<span>{{ 'api_keys.copy'|trans }}</span></button>
                    </div>
                    <p class="field__hint">{{ 'api_keys.token_hint'|trans({scope: created.key.scope.labelKey()|trans}) }}</p>
                </div>
            </section>
        {% endif %}

        <section class="card" aria-labelledby="create-heading">
            <h2 id="create-heading" class="card__title">{{ 'api_keys.create_heading'|trans }}</h2>
            <form class="form" method="post" action="{{ url_for('settings.api_keys') }}">
                {{ ui.csrf(csrf) }}
                {{ ui.input('name', 'api_keys.name'|trans, values, errors, {required: true, maxlength: 100, placeholder: 'api_keys.name_placeholder'|trans, autocomplete: 'off'}) }}
                {{ ui.chips('scope', 'api_keys.scope_label'|trans, values, errors, scopes|map(s => {value: s.value, label: s.labelKey()|trans}), {required: true, hint: 'api_keys.scope_hint'|trans}) }}
                <div class="btn-row">
                    <button type="submit" class="btn btn--primary">{{ ui.icon('key') }}{{ 'api_keys.create'|trans }}</button>
                </div>
            </form>
        </section>

        <section class="card" aria-labelledby="keys-heading">
            <h2 id="keys-heading" class="card__title">{{ 'api_keys.list_heading'|trans }}</h2>
            {% if keys is empty %}
                <p class="field__hint">{{ 'api_keys.none'|trans }}</p>
            {% else %}
                <ul class="list">
                    {% for key in keys %}
                        <li>
                            <div class="list__item">
                                <span class="list__icon">{{ ui.icon(key.isRevoked() ? 'key_off' : 'key') }}</span>
                                <span class="list__body">
                                    <span class="list__title">{{ key.name }}</span>
                                    <span class="list__meta">{{ key.scope.labelKey()|trans }} · {{ 'api_keys.created_on'|trans({date: key.createdAt|instant_date}) }}</span>
                                    <span class="list__meta">
                                        {%- if key.isRevoked() -%}
                                            {{ 'api_keys.revoked_on'|trans({date: key.revokedAt|instant_date}) }}
                                        {%- elseif key.lastUsedAt -%}
                                            {{ 'api_keys.last_used'|trans({when: key.lastUsedAt|local_datetime}) }}
                                        {%- else -%}
                                            {{ 'api_keys.never_used'|trans }}
                                        {%- endif -%}
                                    </span>
                                </span>
                                {% if not key.isRevoked() %}
                                    <span class="list__end">
                                        <a class="btn btn--ghost" href="{{ url_for('settings.api_keys.revoke', {key: key.id}) }}">{{ ui.icon('block') }}{{ 'api_keys.revoke'|trans }}<span class="visually-hidden">: {{ key.name }}</span></a>
                                    </span>
                                {% endif %}
                            </div>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
        </section>

        <section class="card card--quiet" aria-labelledby="using-heading">
            <h2 id="using-heading" class="card__title">{{ 'api_keys.using_heading'|trans }}</h2>
            <p>{{ 'api_keys.using_intro'|trans }}</p>
            <div class="field">
                <label class="field__label" for="f-api-base">{{ 'api_keys.base_label'|trans }}</label>
                <input class="input tabular" id="f-api-base" type="text" readonly value="{{ api_base }}">
            </div>
            <p class="field__hint">{{ 'api_keys.header_hint'|trans }}</p>
            {% if openapi_url %}
                <p><a href="{{ openapi_url }}">{{ 'api_keys.openapi'|trans }}</a></p>
            {% endif %}
            <p class="field__hint">{{ 'api_keys.secret_hint'|trans }}</p>
            {# Phase 39.3: entry webhooks live under API keys (spec.md §7.20 *Webhooks*). #}
            <p><a href="{{ url_for('settings.webhooks') }}">{{ 'webhooks.from_api_keys'|trans }}</a></p>
            {% if mcp_url %}
                {# The MCP server (spec.md §7.28) takes the same keys. #}
                <div class="field">
                    <label class="field__label" for="f-mcp-url">{{ 'api_keys.mcp_label'|trans }}</label>
                    <input class="input tabular" id="f-mcp-url" type="text" readonly value="{{ mcp_url }}" aria-describedby="f-mcp-url-hint">
                    <p class="field__hint" id="f-mcp-url-hint">{{ 'api_keys.mcp_hint'|trans }}</p>
                </div>
            {% endif %}
        </section>
    </div>
{% endblock %}
