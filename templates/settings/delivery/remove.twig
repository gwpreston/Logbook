{% extends 'layout.twig' %}
{% import 'macros/ui.twig' as ui %}

{# Confirm removing the email server and its password (spec.md §7.11). #}
{% set active_nav = 'settings' %}

{% block title %}{{ 'delivery.email.remove_title'|trans }} · {{ parent() }}{% endblock %}

{% block content %}
    <div class="page__stack page__stack--narrow">
        <a class="back-link" href="{{ url_for('settings.delivery') }}">{{ ui.icon('chevron_left') }}{{ 'delivery.title'|trans }}</a>
        <header class="page-header">
            <div><h1 class="page-header__title">{{ 'delivery.email.remove_title'|trans }}</h1></div>
        </header>
        <form class="form" method="post" action="{{ url_for('settings.delivery.remove') }}">
            {{ ui.csrf(csrf) }}
            <section class="card">
                <p>{{ 'delivery.email.remove_confirm'|trans({host: server.host}) }}</p>
                <p class="muted">{{ 'delivery.email.remove_effects'|trans }}</p>
            </section>
            <div class="btn-row">
                <button type="submit" class="btn btn--danger btn--lg">{{ ui.icon('delete') }}{{ 'delivery.email.remove'|trans }}</button>
                <a class="btn btn--lg" href="{{ url_for('settings.delivery') }}">{{ 'form.cancel'|trans }}</a>
            </div>
        </form>
    </div>
{% endblock %}
