{% extends 'layout.twig' %}
{% import 'macros/ui.twig' as ui %}

{# Confirmation before revoking an API key (works without JS). #}
{% set active_nav = 'settings' %}
{% set heading = 'api_keys.revoke_title'|trans({name: key.name}) %}

{% block title %}{{ heading }} · {{ parent() }}{% endblock %}

{% block content %}
    <div class="page__stack page__stack--narrow">
        <a class="back-link" href="{{ url_for('settings.api_keys') }}">{{ ui.icon('chevron_left') }}{{ 'api_keys.title'|trans }}</a>

        <section class="card" aria-labelledby="revoke-heading">
            <h1 id="revoke-heading" class="card__title card__title--lg">{{ heading }}</h1>
            <p>{{ 'api_keys.revoke_body'|trans({name: key.name}) }}</p>
            <div class="btn-row">
                <form method="post" action="{{ url_for('settings.api_keys.revoke', {key: key.id}) }}">
                    {{ ui.csrf(csrf) }}
                    <button type="submit" class="btn btn--danger-solid">{{ ui.icon('block') }}{{ 'api_keys.revoke_confirm'|trans }}</button>
                </form>
                <a class="btn btn--ghost" href="{{ url_for('settings.api_keys') }}">{{ 'form.cancel'|trans }}</a>
            </div>
        </section>
    </div>
{% endblock %}
