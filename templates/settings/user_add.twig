{% extends 'layout.twig' %}
{% import 'macros/ui.twig' as ui %}

{#
 # *Add user* (spec.md §7.9 *Admin controls*): the account exists at once,
 # and a set-password link goes to their address. Needs email.
 #}
{% set active_nav = 'settings' %}

{% block title %}{{ 'users.add.title'|trans }} · {{ parent() }}{% endblock %}

{% block content %}
    <div class="page__stack page__stack--narrow">
        <a class="back-link" href="{{ url_for('settings.users') }}">{{ ui.icon('chevron_left') }}{{ 'users.title'|trans }}</a>

        <section class="card" aria-labelledby="add-heading">
            <h1 id="add-heading" class="card__title card__title--lg">{{ ui.icon('person_add') }}{{ 'users.add.title'|trans }}</h1>
            {% if not mail_configured %}
                <p>{{ 'users.add.needs_email'|trans }}</p>
                <div class="btn-row">
                    <a class="btn" href="{{ url_for('settings.users') }}#invite-heading">{{ ui.icon('link') }}{{ 'users.invite'|trans }}</a>
                </div>
            {% else %}
                <p class="muted">{{ 'users.add.lead'|trans }}</p>
                {% if errors is not empty %}
                    <div class="alert alert--error" role="alert">{{ ui.icon('error') }}<span>{{ 'form.has_errors'|trans }}</span></div>
                {% endif %}
                <form class="form" method="post" action="{{ url_for('settings.users.add') }}">
                    {{ ui.csrf(csrf) }}
                    {{ ui.input('username', 'auth.username'|trans, values, errors, {required: true, maxlength: 64, autocomplete: 'off', hint: 'auth.username_hint'|trans({min: 3, max: 64})}) }}
                    {{ ui.input('display_name', 'prefs.display_name'|trans, values, errors, {optional: true, maxlength: 100, autocomplete: 'off'}) }}
                    {{ ui.input('email', 'account.email.label'|trans, values, errors, {required: true, type: 'email', maxlength: 254, autocomplete: 'off', hint: 'users.add.email_hint'|trans}) }}
                    <label class="toggle">
                        <input type="checkbox" name="is_admin" value="1"{% if (values.is_admin ?? '') == '1' %} checked{% endif %}>
                        <span class="toggle__text">
                            <span class="toggle__title">{{ 'users.role.admin'|trans }}</span>
                            <span class="toggle__hint">{{ 'users.admin_hint'|trans }}</span>
                        </span>
                    </label>
                    <div class="btn-row">
                        <button type="submit" class="btn btn--primary">{{ ui.icon('send') }}{{ 'users.add.submit'|trans }}</button>
                    </div>
                </form>
            {% endif %}
        </section>
    </div>
{% endblock %}
