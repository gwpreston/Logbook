{% extends 'layout.twig' %}
{% import 'macros/ui.twig' as ui %}
{% import 'macros/vehicles.twig' as vehicle_ui %}

{% set active_nav = 'garage' %}

{% block title %}{{ 'garage.title'|trans }} · {{ parent() }}{% endblock %}

{% block content %}
    <div class="page__stack">
        <header class="page-header">
            <div>
                <h1 class="page-header__title">{{ 'garage.title'|trans }}</h1>
                <p class="page-header__lead">{{ trans('garage.summary', {active: counts.active, archived: counts.archived}) }}</p>
            </div>
            <a class="btn btn--primary" href="{{ url_for('vehicles.create') }}" data-modal>{{ ui.icon('add') }}{{ 'garage.add_vehicle'|trans }}</a>
        </header>

        {% if vehicles is empty and shared is not empty %}
        {% elseif vehicles is empty %}
            <div class="empty">
                {{ ui.icon('garage') }}
                <p class="empty__title">{{ (counts.archived > 0 ? 'garage.empty_active_title' : 'garage.empty_title')|trans }}</p>
                <p>{{ 'garage.empty_body'|trans }}</p>
            </div>
        {% else %}
            {% if shared is not empty %}<h2 class="section-title">{{ 'sharing.your_vehicles'|trans }}</h2>{% endif %}
            <div class="vehicle-grid">
                {% for snapshot in vehicles %}
                    {{ vehicle_ui.card(snapshot) }}
                {% endfor %}
            </div>
        {% endif %}

        {% if shared is not empty %}
            <h2 class="section-title">{{ 'sharing.shared_with_you'|trans }}</h2>
            <div class="vehicle-grid">
                {% for item in shared %}
                    {{ vehicle_ui.card(item.snapshot, {owner: item.owner, level: item.level}) }}
                {% endfor %}
            </div>
        {% endif %}

        {% if counts.archived > 0 %}
            <div>
                {% if show_archived %}
                    <a class="btn" href="{{ url_for('garage') }}">{{ ui.icon('inventory_2') }}{{ 'garage.hide_archived'|trans }}</a>
                {% else %}
                    <a class="btn" href="{{ url_for('garage', {}, {archived: '1'}) }}">{{ ui.icon('inventory_2') }}{{ trans('garage.show_archived', {count: counts.archived}) }}</a>
                {% endif %}
            </div>
        {% endif %}
    </div>
{% endblock %}
