{% extends 'layout.twig' %}
{% import 'macros/ui.twig' as ui %}
{#
 # Shown by the service worker for a page it cannot load offline
 # (spec.md §7.15). Rendered signed out and cached once, so it has no
 # personal data; the fill-up form itself is cached separately.
 #}

{% block title %}{{ 'pwa.offline_title'|trans }} · {{ parent() }}{% endblock %}

{% block content %}
    <div class="page__stack page__stack--narrow">
        <section class="card empty" aria-labelledby="offline-heading">
            {{ ui.icon('cloud_off') }}
            <h1 id="offline-heading" class="empty__title">{{ 'pwa.offline_title'|trans }}</h1>
            <p>{{ 'pwa.offline_body'|trans }}</p>
            <div class="btn-row">
                <a class="btn btn--primary" href="{{ base_path() }}/fuel/new">{{ ui.icon('add') }}{{ 'nav.log_fill_up'|trans }}</a>
                <a class="btn" href="{{ base_path() }}/">{{ ui.icon('restart_alt') }}{{ 'pwa.retry'|trans }}</a>
            </div>
        </section>
    </div>
{% endblock %}
