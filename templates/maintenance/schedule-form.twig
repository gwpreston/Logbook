{% extends 'layout.twig' %}
{% import 'macros/ui.twig' as ui %}

{% set active_nav = 'garage' %}
{% set editing = schedule is not null %}
{% set heading = (editing ? 'maintenance.schedule.edit_title' : 'maintenance.schedule.add_title')|trans %}
{% set distance_symbol = ('units.symbol.' ~ prefs().distanceUnit.value)|trans %}

{% block title %}{{ heading }} · {{ vehicle.name() }} · {{ parent() }}{% endblock %}

{% block content %}
    <div class="page__stack page__stack--narrow">
        <a class="back-link" href="{{ url_for('maintenance.index', {id: vehicle.id}) }}">{{ ui.icon('chevron_left') }}{{ 'maintenance.title'|trans }} · {{ vehicle.name() }}</a>

        <header class="page-header">
            <div>
                <p class="page-header__eyebrow">{{ vehicle.name() }}</p>
                <h1 class="page-header__title">{{ heading }}</h1>
                <p class="page-header__lead">{{ 'maintenance.schedule.lead'|trans }}</p>
            </div>
        </header>

        {% block modal_body %}
        {% if modal %}<p class="modal-fragment__context">{{ vehicle.name() }}{% if vehicle.data.registration %} · {{ vehicle.data.registration }}{% endif %}</p>{% endif %}
        {% if errors is not empty %}
            <div class="alert alert--error" role="alert">{{ ui.icon('error') }}<span>{{ 'form.has_errors'|trans }}</span></div>
        {% endif %}

        <form class="form" method="post"
              action="{{ editing ? url_for('maintenance.schedules.edit', {id: vehicle.id, schedule: schedule.id}) : url_for('maintenance.schedules.create', {id: vehicle.id}) }}">
            {{ ui.csrf(csrf) }}

            <section class="card">
                {{ ui.input('title', 'maintenance.schedule.field.title'|trans, values, errors, {required: true, maxlength: 150, hint: 'maintenance.schedule.hint.title'|trans}) }}
                {{ ui.select('category', 'maintenance.field.category'|trans, values, errors,
                    categories|map(c => {value: c.value, label: ('maintenance.category.' ~ c.value)|trans}), {required: true}) }}
            </section>

            <fieldset class="card fieldset" aria-describedby="f-interval-hint">
                <legend class="card__title fieldset__legend">{{ 'maintenance.schedule.section.interval'|trans }}</legend>
                <p class="field__hint" id="f-interval-hint">{{ 'maintenance.schedule.hint.interval'|trans }}</p>
                <div class="form-row">
                    {{ ui.input('interval_distance', 'maintenance.schedule.field.interval_distance'|trans, values, errors, {type: 'number', optional: true, step: 'any', min: 0, inputmode: 'decimal', suffix: distance_symbol}) }}
                    {{ ui.input('interval_months', 'maintenance.schedule.field.interval_months'|trans, values, errors, {type: 'number', optional: true, step: 1, min: 1, max: 600, inputmode: 'numeric', suffix: 'maintenance.schedule.months_suffix'|trans}) }}
                </div>
            </fieldset>

            <fieldset class="card fieldset" aria-describedby="f-last-done-hint">
                <legend class="card__title fieldset__legend">{{ 'maintenance.schedule.section.last_done'|trans }}</legend>
                <p class="field__hint" id="f-last-done-hint">{{ 'maintenance.schedule.hint.last_done'|trans }}</p>
                <div class="form-row">
                    {{ ui.input('last_done_on', 'maintenance.schedule.field.last_done_on'|trans, values, errors, {type: 'date', optional: true}) }}
                    {{ ui.input('last_done_odometer', 'maintenance.schedule.field.last_done_odometer'|trans, values, errors, {type: 'number', optional: true, step: 'any', min: 0, inputmode: 'decimal', suffix: distance_symbol}) }}
                </div>
            </fieldset>

            <div class="btn-row">
                <button type="submit" class="btn btn--primary btn--lg">{{ ui.icon('check_circle') }}{{ (editing ? 'form.save' : 'maintenance.schedule.add_submit')|trans }}</button>
                <a data-modal-cancel class="btn btn--lg" href="{{ url_for('maintenance.index', {id: vehicle.id}) }}">{{ 'form.cancel'|trans }}</a>
                {% if editing %}
                    <a class="btn btn--lg btn--danger btn--push" href="{{ url_for('maintenance.schedules.delete', {id: vehicle.id, schedule: schedule.id}) }}">{{ ui.icon('delete') }}{{ 'form.delete'|trans }}</a>
                {% endif %}
            </div>
        </form>
        {% endblock %}
    </div>
{% endblock %}
