{#
 # The history, grouped (spec.md §7.19): the milestones without prices, then
 # service and repairs, inspections and certificates, and tyres, each newest
 # first, then the full timeline when asked for. Rows are the print view's
 # (macros/history.twig): work costs only with `costs=1`, milestone prices
 # never.
 #}
{% import 'macros/ui.twig' as ui %}
{% import 'macros/history.twig' as history %}
{% macro item(item, pack) -%}
    {% import 'macros/ui.twig' as ui %}
    {% import 'macros/history.twig' as history %}
    <li class="history-print__item">
        {{ history.row(item, {link: false, costs: item.milestone ? false : pack.options.costs, part_of: false}) }}
        {% set description = item.kind.value == 'maintenance' ? (pack.descriptions[item.entryId] ?? null) : null %}
        {% if description %}<p class="sale-pack__description">{{ description }}</p>{% endif %}
        {% set owner = item.filesOwner() %}
        {% set files = owner ? pack.attachments.of(owner, item.entryId) : [] %}
        {% if files is not empty %}
            <p class="history-print__files">{{ ui.icon('attach_file') }}{{ files|map(f => f.filename)|join(', ') }}</p>
        {% endif %}
    </li>
{%- endmacro %}
{% import _self as pack_ui %}
<section class="sale-pack__section sale-pack__history" aria-labelledby="sale-pack-history">
    {% include 'sale_pack/_running.twig' %}
    <h2 id="sale-pack-history" class="sale-pack__heading">{{ 'sale_pack.history.title'|trans }}</h2>
    {% if pack.milestones is not empty %}
        <ol class="list history-print__list">
            {% for item in pack.milestones %}{{ pack_ui.item(item, pack) }}{% endfor %}
        </ol>
    {% endif %}

    {% set groups = [
        {key: 'services', items: pack.services, on: pack.servicing is not null},
        {key: 'documents', items: pack.documents, on: pack.compliance},
        {key: 'tyres', items: pack.tyreChanges, on: feature_enabled('tyres')},
    ] %}
    {% for group in groups|filter(g => g.on) %}
        <h3 class="sale-pack__group">{{ ('sale_pack.history.' ~ group.key)|trans }}</h3>
        {% if group.items is empty %}
            <p class="muted">{{ 'sale_pack.history.none'|trans }}</p>
        {% else %}
            <ol class="list history-print__list">
                {% for item in group.items %}{{ pack_ui.item(item, pack) }}{% endfor %}
            </ol>
        {% endif %}
    {% endfor %}

    {# Incidents (Phase 27.1, *Include incidents*): what was damaged and who repaired it, nothing about the claim. #}
    {% if pack.incidents is not null %}
        <h3 class="sale-pack__group">{{ 'sale_pack.history.incidents'|trans }}</h3>
        {% if pack.incidents is empty %}
            <p class="muted">{{ 'sale_pack.history.none'|trans }}</p>
        {% else %}
            <ol class="list history-print__list">
                {% for incident in pack.incidents %}
                    <li class="history-print__item">
                        <div class="list__item">
                            <span class="list__icon">{{ ui.icon('car_crash') }}</span>
                            <span class="list__body">
                                <span class="list__title">{{ incident.type.labelKey()|trans }}</span>
                                <span class="list__meta">
                                    {{- incident.date|local_date -}}
                                    {%- if incident.damageAreas is not empty %} · {{ incident.damageAreas|map(a => a.labelKey()|trans)|join(', ') }}{% endif -%}
                                    {%- if incident.severity %} · {{ incident.severity.labelKey()|trans }}{% endif -%}
                                </span>
                                {% for repair in incident.repairs %}
                                    <span class="list__meta history-row__tyres">{{ ui.icon('build') }}{{ 'sale_pack.incident.repaired'|trans({title: repair.title, date: repair.date|local_date}) }}{% if repair.vendor %} · {{ repair.vendor }}{% endif %}</span>
                                {% endfor %}
                            </span>
                        </div>
                    </li>
                {% endfor %}
            </ol>
        {% endif %}
    {% endif %}

    {# Open issues (Phase 40.1, *Include open issues*): the owner's words, status and safety; no cause. #}
    {% if pack.openIssues is not null %}
        <h3 class="sale-pack__group">{{ 'sale_pack.history.issues'|trans }}</h3>
        <p class="muted no-print" role="note">{{ 'sale_pack.issues_notice'|trans }}</p>
        {% if pack.openIssues is empty %}
            <p class="muted">{{ 'sale_pack.history.none'|trans }}</p>
        {% else %}
            <ol class="list history-print__list">
                {% for issue in pack.openIssues %}
                    <li class="history-print__item">
                        <div class="list__item">
                            <span class="list__icon">{{ ui.icon('report') }}</span>
                            <span class="list__body">
                                <span class="list__title">{{ issue.data.title }}</span>
                                <span class="list__meta">
                                    {{- 'issue.noticed_on'|trans({date: issue.data.noticedOn|local_date}) -}}
                                    {%- if issue.data.odometerKm is not null %} · {{ issue.data.odometerKm|distance(0) }}{% endif %} · {{ issue.status().labelKey()|trans -}}
                                    {%- if issue.data.affectsSafety %} · {{ 'issue.affects_safety'|trans }}{% endif -%}
                                </span>
                            </span>
                        </div>
                    </li>
                {% endfor %}
            </ol>
        {% endif %}
    {% endif %}
</section>

{% if pack.timeline is not null %}
    <section class="sale-pack__section sale-pack__timeline" aria-labelledby="sale-pack-timeline">
        {% include 'sale_pack/_running.twig' %}
        <h2 id="sale-pack-timeline" class="sale-pack__heading">{{ 'sale_pack.history.timeline'|trans }}</h2>
        {% if pack.timeline is empty %}
            <p class="muted">{{ 'history.empty_title'|trans }}</p>
        {% else %}
            <ol class="list history-print__list">
                {% for item in pack.timeline %}{{ pack_ui.item(item, pack) }}{% endfor %}
            </ol>
        {% endif %}
    </section>
{% endif %}
