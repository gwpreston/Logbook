{% extends 'layout.twig' %}
{% import 'macros/ui.twig' as ui %}

{#
 # A vehicle's Sharing page (spec.md §7.21). The owner sees each share with
 # its level, Can see costs and Send me its reminders, and adds people by
 # username; a shared user sees their own share, their reminder choice and
 # Leave. Plain forms: everything works without JS.
 #}
{% set active_nav = 'garage' %}
{% set heading = 'sharing.title'|trans({name: vehicle.name()}) %}

{#
 # What a share allows (spec.md §7.21, Phase 46): its Can and Can't lines,
 # each list headed in words ("Sam can", "You can't"), so a screen reader
 # never depends on the icons. `person` is 'you' or 'they'.
 #}
{% macro summary(allows, person, name) -%}
    {% import 'macros/ui.twig' as ui %}
    {% for part in ['can', 'cannot'] %}
        {% set lines = part == 'can' ? allows.can() : allows.cannot() %}
        {% if lines is not empty %}
            <p class="share-summary__heading">{{ ('share_summary.' ~ part)|trans({person: person, name: name}) }}</p>
            <ul class="share-summary__list share-summary__list--{{ part }}">
                {% for line in lines %}
                    <li>{{ ui.icon(part == 'can' ? 'check_circle' : 'block') }}<span>{{ ('share_summary.lines.' ~ line.key)|trans(line.params|merge({person: person})) }}</span></li>
                {% endfor %}
            </ul>
        {% endif %}
    {% endfor %}
{%- endmacro %}

{#
 # A share's level and ticks, with quick picks (JS only: they only fill in
 # these controls) and the live summary: one per state the controls can be
 # in, the current one shown; Alpine shows the one that matches as they
 # change. Without JS the saved (or default) state's summary stays.
 #}
{% macro share_fields(values, levels, notify_label, states, name) -%}
    {% import 'macros/ui.twig' as ui %}
    {% set costs_ticked = (values.can_see_costs ?? '') == '1' %}
    {% set notify = (values.notify ?? '') == '1' %}
    {% set current = values.level ~ '-' ~ (costs_ticked ? 1 : 0) ~ '-' ~ (notify ? 1 : 0) %}
    <div class="share-fields" x-data="{ level: '{{ values.level|e('js') }}', costs: {{ costs_ticked ? 'true' : 'false' }}, notify: {{ notify ? 'true' : 'false' }}, get state() { return this.level + '-' + (this.costs ? 1 : 0) + '-' + (this.notify ? 1 : 0); }, pick(level, costs, notify) { this.level = level; this.costs = costs; this.notify = notify; } }">
        <div class="field share-picks" role="group" aria-label="{{ 'sharing.picks.label'|trans }}" hidden x-bind:hidden="false">
            <p class="field__label" aria-hidden="true">{{ 'sharing.picks.label'|trans }}</p>
            <div class="chip-row">
                <button type="button" class="btn btn--sm" x-on:click="pick('log', false, true)">{{ 'sharing.picks.driver'|trans }}</button>
                <button type="button" class="btn btn--sm" x-on:click="pick('manage', true, true)">{{ 'sharing.picks.co_owner'|trans }}</button>
                <button type="button" class="btn btn--sm" x-on:click="pick('view', false, false)">{{ 'sharing.picks.viewer'|trans }}</button>
            </div>
            <p class="field__hint">{{ 'sharing.picks.hint'|trans }}</p>
        </div>
        <fieldset class="field fieldset">
            <legend class="field__label">{{ 'sharing.level'|trans }}</legend>
            <div class="chip-row">
                {% for level in levels %}
                    <label class="chip">
                        <input type="radio" name="level" value="{{ level.value }}"{% if level.value == values.level %} checked{% endif %} required x-model="level">
                        <span>{{ ('sharing.levels.' ~ level.value)|trans }}</span>
                    </label>
                {% endfor %}
            </div>
            <p class="field__hint">{{ 'sharing.level_hint'|trans }}</p>
        </fieldset>
        <label class="toggle">
            <input type="checkbox" name="can_see_costs" value="1"{% if costs_ticked %} checked{% endif %} x-model="costs">
            <span class="toggle__text">
                <span class="toggle__title">{{ 'sharing.can_see_costs'|trans }}</span>
                <span class="toggle__hint">{{ 'sharing.can_see_costs_hint'|trans }}</span>
            </span>
        </label>
        <label class="toggle">
            <input type="checkbox" name="notify" value="1"{% if notify %} checked{% endif %} x-model="notify">
            <span class="toggle__text">
                <span class="toggle__title">{{ notify_label }}</span>
                <span class="toggle__hint">{{ 'sharing.notify_hint'|trans }}</span>
            </span>
        </label>
        <div class="share-summary" role="group" aria-label="{{ 'share_summary.label'|trans }}">
            {% for state, allows in states %}
                <div{% if state != current %} hidden{% endif %} x-bind:hidden="state !== '{{ state }}'">
                    {{ _self.summary(allows, 'they', name) }}
                </div>
            {% endfor %}
        </div>
    </div>
{%- endmacro %}

{% block title %}{{ heading }} · {{ parent() }}{% endblock %}

{% block content %}
    <div class="page__stack page__stack--narrow">
        <a class="back-link" href="{{ url_for('vehicles.show', {id: vehicle.id}) }}">{{ ui.icon('chevron_left') }}{{ vehicle.name() }}</a>

        <header class="page-header">
            <div>
                <h1 class="page-header__title">{{ heading }}</h1>
                <p class="page-header__lead">{{ (owns ? 'sharing.lead_owner' : 'sharing.lead_shared')|trans({owner: owner.displayName ?? ''}) }}</p>
            </div>
        </header>

        {% if owns %}
            <section class="card" aria-labelledby="shares-heading">
                <h2 id="shares-heading" class="card__title">{{ ui.icon('group') }}{{ 'sharing.list_heading'|trans }}</h2>
                {% if shares is empty %}
                    <p class="field__hint">{{ 'sharing.none'|trans }}</p>
                {% else %}
                    <ul class="list">
                        {% for row in shares %}
                            {% set share = row.share %}
                            <li class="share-row">
                                <form class="form" method="post" action="{{ url_for('vehicles.sharing.change', {id: vehicle.id, member: row.user.id, action: 'save'}) }}">
                                    {{ ui.csrf(csrf) }}
                                    <p class="list__title share-person">{{ ui.avatar(row.user) }}{{ row.user.displayName }} <span class="muted">({{ row.user.username }})</span>
                                        {% if not row.user.isActive() %}<span class="pill pill--soon">{{ 'users.status.disabled'|trans }}</span>{% endif %}</p>
                                    {{ _self.share_fields({
                                        level: share.level.value,
                                        can_see_costs: share.canSeeCosts ? '1' : '',
                                        notify: share.notify ? '1' : '',
                                    }, levels, 'sharing.notify_other'|trans, states, row.user.displayName) }}
                                    <div class="btn-row">
                                        <button type="submit" class="btn btn--primary">{{ ui.icon('save') }}{{ 'form.save'|trans }}<span class="visually-hidden">: {{ row.user.displayName }}</span></button>
                                        <button type="submit" class="btn btn--ghost" formaction="{{ url_for('vehicles.sharing.change', {id: vehicle.id, member: row.user.id, action: 'remove'}) }}">{{ ui.icon('person_remove') }}{{ 'sharing.remove'|trans }}<span class="visually-hidden">: {{ row.user.displayName }}</span></button>
                                    </div>
                                </form>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </section>

            <section class="card" aria-labelledby="add-heading">
                <h2 id="add-heading" class="card__title">{{ ui.icon('person_add') }}{{ 'sharing.add_heading'|trans }}</h2>
                <form class="form" method="post" action="{{ url_for('vehicles.sharing.add', {id: vehicle.id}) }}">
                    {{ ui.csrf(csrf) }}
                    {{ ui.input('username', 'sharing.username'|trans, values, errors, {required: true, maxlength: 64, autocomplete: 'off', hint: 'sharing.username_hint'|trans}) }}
                    {{ _self.share_fields(values, levels, 'sharing.notify_other'|trans, states, 'share_summary.someone'|trans) }}
                    <div class="btn-row">
                        <button type="submit" class="btn btn--primary">{{ ui.icon('person_add') }}{{ 'sharing.add'|trans }}</button>
                    </div>
                </form>
            </section>

            <details class="card share-levels nojs-only">
                <summary class="card__title">{{ ui.icon('info') }}{{ 'sharing.each_level'|trans }}</summary>
                <p class="field__hint">{{ 'sharing.each_level_hint'|trans }}</p>
                {% for allows in each_level %}
                    <h3 class="share-levels__level">{{ ('sharing.levels.' ~ allows.level.value)|trans }}</h3>
                    <div class="share-summary">{{ _self.summary(allows, 'they', 'share_summary.someone'|trans) }}</div>
                {% endfor %}
            </details>

            <section class="card" aria-labelledby="transfer-heading">
                <h2 id="transfer-heading" class="card__title">{{ ui.icon('swap_horiz') }}{{ 'sharing.transfer_heading'|trans }}</h2>
                <p>{{ 'sharing.transfer_lead'|trans }}</p>
                <div class="btn-row">
                    <a class="btn" href="{{ url_for('vehicles.transfer', {id: vehicle.id}) }}">{{ ui.icon('swap_horiz') }}{{ 'sharing.transfer'|trans }}</a>
                </div>
            </section>
        {% elseif mine %}
            <section class="card" aria-labelledby="mine-heading">
                <h2 id="mine-heading" class="card__title">{{ ui.icon('group') }}{{ 'sharing.your_access'|trans }}</h2>
                <p>{{ 'sharing.your_level'|trans({level: ('sharing.levels.' ~ mine.level.value)|trans, owner: owner.displayName ?? ''}) }}</p>
                <h3 class="share-levels__level">{{ 'sharing.what_you_can_do'|trans }}</h3>
                <div class="share-summary">{{ _self.summary(mine_allows, 'you', '') }}</div>
                <form class="form" method="post" action="{{ url_for('vehicles.sharing.mine', {id: vehicle.id, action: 'notify'}) }}">
                    {{ ui.csrf(csrf) }}
                    <label class="toggle">
                        <input type="checkbox" name="notify" value="1"{% if mine.notify %} checked{% endif %}>
                        <span class="toggle__text">
                            <span class="toggle__title">{{ 'sharing.notify_me'|trans }}</span>
                            <span class="toggle__hint">{{ 'sharing.notify_hint'|trans }}</span>
                        </span>
                    </label>
                    <div class="btn-row">
                        <button type="submit" class="btn btn--primary">{{ ui.icon('save') }}{{ 'form.save'|trans }}</button>
                    </div>
                </form>
            </section>
            <section class="card" aria-labelledby="leave-heading">
                <h2 id="leave-heading" class="card__title">{{ ui.icon('logout') }}{{ 'sharing.leave_heading'|trans }}</h2>
                <p>{{ 'sharing.leave_body'|trans({name: vehicle.name()}) }}</p>
                <form method="post" action="{{ url_for('vehicles.sharing.mine', {id: vehicle.id, action: 'leave'}) }}">
                    {{ ui.csrf(csrf) }}
                    <button type="submit" class="btn btn--danger">{{ ui.icon('logout') }}{{ 'sharing.leave'|trans }}</button>
                </form>
            </section>
        {% endif %}
    </div>
{% endblock %}
