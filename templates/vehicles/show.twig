{% extends 'layout.twig' %}
{% import 'macros/ui.twig' as ui %}
{% import 'macros/maintenance.twig' as maint %}
{% import 'macros/compliance.twig' as docs %}
{% import 'macros/history.twig' as history %}

{% set active_nav = 'garage' %}
{% set data = vehicle.data %}
{% set dash = '—' %}
{% set latest = odometer.latest() %}

{% block title %}{{ vehicle.name() }} · {{ parent() }}{% endblock %}

{% block content %}
    <div class="page__stack">
        {% include 'vehicles/_header.twig' with {active_tab: 'overview'} %}

        {% if vehicle.isArchived() %}
            <div class="alert alert--warning" role="status">{{ ui.icon('inventory_2') }}<span>{{ 'vehicle.archived_notice'|trans }}</span></div>
        {% endif %}

        <dl class="stats">
            {{ ui.stat('odometer.stat.current'|trans,
                latest ? latest.readingKm|distance : dash,
                latest ? 'odometer.stat.as_of'|trans({date: latest.recordedAt|instant_date}) : 'odometer.stat.none'|trans) }}
            {% if feature_enabled('fuel') %}
            {{ ui.stat((electric ? 'fuel.stat.average_ev' : 'fuel.stat.average')|trans,
                fuel_summary and fuel_summary.hasEconomy() ? fuel_summary.measuredDistanceKm|economy(fuel_summary.measuredVolume, electric) : dash,
                fuel_summary and fuel_summary.hasEconomy() ? 'fuel.stat.all_time'|trans : 'fuel.stat.need_two_full'|trans,
                fuel_summary and fuel_summary.hasEconomy() ? 'good' : '') }}
            {{ ui.stat((electric ? 'fuel.stat.cost_per_distance_ev' : 'fuel.stat.cost_per_distance')|trans,
                fuel_summary and fuel_summary.costPerKm() is not null ? fuel_summary.costPerKm()|per_distance(currency) : dash,
                (electric ? 'fuel.stat.charging_only' : 'fuel.stat.fuel_only')|trans) }}
            {{ ui.stat((electric ? 'fuel.stat.spend_ev' : 'fuel.stat.spend')|trans, fuel.isEmpty() ? dash : fuel.totalCost()|money(currency), 'fuel.stat.all_time'|trans) }}
            {% endif %}
        </dl>

        <div class="card-grid">
            {# The latest five of the History tab (spec.md §7.16). #}
            <section class="card" aria-labelledby="history-heading">
                <div class="card__header">
                    <h2 id="history-heading" class="card__title">{{ 'history.recent'|trans }}</h2>
                    <a class="card__link" href="{{ url_for('history.vehicle', {id: vehicle.id}) }}">{{ 'history.full'|trans }}</a>
                </div>
                {% if recent_history is empty %}
                    <div class="empty">
                        {{ ui.icon('history') }}
                        <p class="empty__title">{{ 'history.empty_title'|trans }}</p>
                    </div>
                {% else %}
                    <ul class="list">
                        {% for item in recent_history %}
                            <li>{{ history.row(item, {return_to: current_path}) }}</li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </section>

            {% if feature_enabled('maintenance') %}
            <section class="card" aria-labelledby="maintenance-heading">
                <div class="card__header">
                    <h2 id="maintenance-heading" class="card__title">{{ 'maintenance.due_title'|trans }}</h2>
                    <a class="card__link" href="{{ url_for('maintenance.index', {id: vehicle.id}) }}">{{ 'maintenance.view_all'|trans }}</a>
                </div>
                {% if schedules is empty %}
                    <div class="empty">
                        {{ ui.icon('event_repeat') }}
                        <p class="empty__title">{{ 'maintenance.schedule.empty_title'|trans }}</p>
                        <p>{{ 'maintenance.schedule.empty_body'|trans }}</p>
                    </div>
                {% else %}
                    <ul class="list">
                        {% for state in schedules %}
                            <li class="list__item">
                                <span class="list__icon">{{ ui.icon(state.schedule.data.category.icon()) }}</span>
                                <span class="list__body">
                                    <span class="list__title">{{ state.schedule.data.title }}</span>
                                    <span class="list__meta">{{ maint.next_due(state.schedule) }}</span>
                                </span>
                                <span class="list__end">{{ maint.due_pill(state.due) }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
                {% set last_service = maintenance.latest() %}
                {% if last_service %}
                    <p class="muted">{{ 'maintenance.last_logged'|trans({title: last_service.data.title, date: last_service.data.performedOn|local_date}) }}</p>
                {% endif %}
                {% if not vehicle.isArchived() %}
                    <div class="btn-row">
                        <a class="btn btn--primary" href="{{ url_for('maintenance.create', {id: vehicle.id}) }}" data-modal>{{ ui.icon('add') }}{{ 'maintenance.add'|trans }}</a>
                        <a class="btn" href="{{ url_for('maintenance.schedules.create', {id: vehicle.id}) }}" data-modal>{{ ui.icon('event_repeat') }}{{ 'maintenance.schedule.add'|trans }}</a>
                    </div>
                {% endif %}
            </section>
            {% endif %}

            {% if tyres is not null %}
            {% import 'macros/tyres.twig' as tyre_ui %}
            <section class="card" aria-labelledby="tyres-heading">
                <div class="card__header">
                    <h2 id="tyres-heading" class="card__title">{{ 'tyre.title'|trans }}</h2>
                    <a class="card__link" href="{{ url_for('tyres.index', {id: vehicle.id}) }}">{{ 'tyre.all'|trans }} →</a>
                </div>
                {% set fitted = tyres.fittedTyres() %}
                {% if fitted is empty %}
                    <p class="muted">{{ 'tyre.none_fitted'|trans }}</p>
                {% else %}
                    {% set km_left = tyres.soonestKmLeft() %}
                    {% if km_left is not null %}
                        <p class="tyre-soonest">{{ 'tyre.wear.soonest_left'|trans({distance: km_left|about_distance}) }}</p>
                    {% endif %}
                    <ul class="list">
                        {% for view in fitted %}
                            <li class="list__item">
                                <span class="list__icon" style="--tone: var(--c-maint)">{{ ui.icon('tire_repair') }}</span>
                                <span class="list__body">
                                    <span class="list__title">{{ ('tyre.position.' ~ view.tyre.position.value)|trans }} · {{ tyre_ui.name(view.tyre) }}</span>
                                    <span class="list__meta">{{ tyre_ui.age(view) }}{% if view.wear.latest %} · {{ tyre_ui.latest_depth(view) }}{% endif %}</span>
                                </span>
                                {{ tyre_ui.standing_flag(tyres.verdict.standing(view.tyre.id), view) }}
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </section>
            {% endif %}

            {% if feature_enabled('compliance') %}
            <section class="card" aria-labelledby="documents-heading">
                <div class="card__header">
                    <h2 id="documents-heading" class="card__title">{{ 'compliance.title'|trans }}</h2>
                    <a class="card__link" href="{{ url_for('compliance.index', {id: vehicle.id}) }}">{{ 'compliance.view_all'|trans }}</a>
                </div>
                {% if documents is empty %}
                    <div class="empty">
                        {{ ui.icon('verified_user') }}
                        <p class="empty__title">{{ 'compliance.empty_title'|trans }}</p>
                        <p>{{ 'compliance.empty_body'|trans }}</p>
                    </div>
                {% else %}
                    <ul class="list">
                        {% for state in documents %}
                            <li>
                                <a class="list__item" href="{{ url_for('compliance.edit', {id: vehicle.id, document: state.document.id}) }}" data-modal>
                                    <span class="list__icon">{{ ui.icon(state.document.data.type.icon()) }}</span>
                                    <span class="list__body">
                                        <span class="list__title">{{ docs.name(state.document) }}</span>
                                        <span class="list__meta">{{ docs.period(state.document) }}</span>
                                    </span>
                                    <span class="list__end">{{ docs.status_pill(state) }}</span>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                {% endif %}
                {% if not vehicle.isArchived() %}
                    <div class="btn-row">
                        <a class="btn" href="{{ url_for('compliance.create', {id: vehicle.id}) }}" data-modal>{{ ui.icon('add') }}{{ 'compliance.add'|trans }}</a>
                    </div>
                {% endif %}
            </section>
            {% endif %}

            <section class="card" aria-labelledby="details-heading">
                <h2 id="details-heading" class="card__title">{{ 'vehicle.section.details'|trans }}</h2>
                <dl class="details">
                    <div><dt>{{ 'vehicle.field.type'|trans }}</dt><dd>{{ ('vehicle.type.' ~ data.type.value)|trans }}</dd></div>
                    <div><dt>{{ 'vehicle.field.make'|trans }}</dt><dd>{{ data.make }}</dd></div>
                    <div><dt>{{ 'vehicle.field.model'|trans }}</dt><dd>{{ data.model }}</dd></div>
                    {% if data.variant %}<div><dt>{{ 'vehicle.field.variant'|trans }}</dt><dd>{{ data.variant }}</dd></div>{% endif %}
                    <div><dt>{{ 'vehicle.field.year'|trans }}</dt><dd>{{ data.year ?? dash }}</dd></div>
                    {% if data.firstRegisteredOn %}
                        <div>
                            <dt>{{ 'vehicle.field.first_registered_on'|trans }}</dt>
                            <dd>{{ data.firstRegisteredOn|local_date }}{% if age %} <span class="muted">({{ 'vehicle.age.label'|trans({age: age.labelKey()|trans({years: age.years, months: age.months})}) }})</span>{% endif %}</dd>
                        </div>
                    {% endif %}
                    <div><dt>{{ 'vehicle.field.registration'|trans }}</dt><dd>{{ data.registration ?? dash }}</dd></div>
                    <div><dt>{{ 'vehicle.field.vin'|trans }}</dt><dd class="tabular">{{ data.vin ?? dash }}</dd></div>
                    <div><dt>{{ 'vehicle.field.fuel_type'|trans }}</dt><dd>{{ ('vehicle.fuel.' ~ data.fuelType.value)|trans }}</dd></div>
                    <div>
                        <dt>{{ data.fuelType.capacityLabelKey()|trans }}</dt>
                        <dd class="tabular">{{ data.capacity is null ? dash : (data.fuelType.isElectric() ? data.capacity|energy : data.capacity|volume) }}</dd>
                    </div>
                    <div><dt>{{ 'vehicle.field.currency'|trans }}</dt><dd>{{ currency }} — {{ currency_name(currency) }}{% if data.currency is null %} <span class="muted">({{ 'vehicle.currency_inherited'|trans }})</span>{% endif %}</dd></div>
                    <div><dt>{{ 'vehicle.added'|trans }}</dt><dd>{{ vehicle.createdAt|local_datetime }}</dd></div>
                </dl>
            </section>

            {# Ownership (spec.md §7.1): hidden until there is a purchase, a sale or a valuation. #}
            {% if data.purchaseDate or data.purchasePrice is not null or data.saleDate or data.salePrice is not null or has_valuations %}
            {% set value = depreciation.current %}
            <section class="card" aria-labelledby="ownership-heading">
                <h2 id="ownership-heading" class="card__title">{{ 'vehicle.section.ownership'|trans }}</h2>
                <dl class="details">
                    {% if data.purchaseDate or data.purchasePrice is not null %}
                        <div><dt>{{ 'valuation.row.bought'|trans }}</dt><dd>{{ _self.dated(data.purchaseDate, data.purchasePrice, currency) }}{{ _self.paperwork(vehicle, 'purchase', paperwork) }}</dd></div>
                    {% endif %}
                    {% if value and value.kind.value == 'valuation' %}
                        <div><dt>{{ 'valuation.row.latest'|trans }}</dt><dd>{{ _self.dated(value.date, value.amount, currency) }}{% if value.source %} <span class="muted">· {{ value.source }}</span>{% endif %}</dd></div>
                    {% endif %}
                    {% if data.saleDate or data.salePrice is not null %}
                        <div><dt>{{ 'valuation.row.sold'|trans }}</dt><dd>{{ _self.dated(data.saleDate, data.salePrice, currency) }}{{ _self.paperwork(vehicle, 'sale', paperwork) }}</dd></div>
                    {% endif %}
                    {% if depreciation.change is not null %}
                        {% set change_amount = depreciation.change|trim('-', 'left')|money(currency) %}
                        <div>
                            <dt>{{ 'valuation.row.change'|trans }}</dt>
                            <dd class="tabular">
                                {%- if depreciation.fraction is null -%}
                                    {{ ((depreciation.isGain() ? 'valuation.change.up' : 'valuation.change.down'))|trans({amount: change_amount}) }}
                                {%- else -%}
                                    {{ ((depreciation.isGain() ? 'valuation.change.up_percent' : 'valuation.change.down_percent'))|trans({amount: change_amount, percent: depreciation.fraction|percent}) }}
                                {%- endif -%}
                            </dd>
                        </div>
                    {% endif %}
                    {% if depreciation.perYear is not null %}
                        <div><dt>{{ 'valuation.row.per_year'|trans }}</dt><dd class="tabular">{{ depreciation.perYear|money(currency) }}</dd></div>
                    {% endif %}
                    {% if depreciation.perKm is not null %}
                        <div><dt>{{ 'valuation.row.per_distance'|trans }}</dt><dd class="tabular">{{ depreciation.perKm|per_distance(currency) }}</dd></div>
                    {% endif %}
                </dl>
                {% if depreciation.staleMonths is not null %}
                    <p class="field__hint">{{ 'valuation.hint.stale'|trans({months: depreciation.staleMonths}) }}</p>
                {% elseif depreciation.state.value == 'no_purchase_price' %}
                    <p class="field__hint">{{ 'valuation.hint.no_purchase_price'|trans }}</p>
                {% elseif depreciation.state.value == 'no_value' %}
                    <p class="field__hint">{{ 'valuation.hint.no_value'|trans }}</p>
                {% endif %}
                {% if value_chart.hasData() %}
                    {{ ui.chart(value_chart, 'valuation.chart.label'|trans) }}
                    <table class="table chart-table">
                        <caption class="visually-hidden">{{ 'valuation.chart.label'|trans }}</caption>
                        <tbody>
                            {% for point in depreciation.points %}
                                <tr>
                                    <th scope="row">{{ point.date|local_date }} · {{ ('valuation.point.' ~ point.kind.value)|trans }}</th>
                                    <td class="table__num tabular">{{ point.amount|money(currency) }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                {% endif %}
                <div class="btn-row">
                    <a class="btn" href="{{ url_for('valuations.index', {id: vehicle.id}) }}">{{ 'valuation.link'|trans }}</a>
                    <a class="btn" href="{{ url_for('valuations.create', {id: vehicle.id}) }}" data-modal>{{ ui.icon('add') }}{{ 'valuation.add'|trans }}</a>
                </div>
            </section>
            {% endif %}

            {# Cost of ownership (spec.md §7.1, §7.7): core, hidden only without an ownership period. #}
            {% if ownership_cost %}
            {% import 'macros/ownership.twig' as own %}
            {% set cost = ownership_cost %}
            <section class="card" aria-labelledby="cost-heading">
                <h2 id="cost-heading" class="card__title">
                    {{- cost.isComplete() ? 'ownership.title'|trans : 'ownership.title_running'|trans({date: cost.period.from|local_date}) -}}
                </h2>
                <dl class="details">
                    <div><dt>{{ 'ownership.row.owned_for'|trans }}</dt><dd>{{ own.owned_for(cost) }}</dd></div>
                    {% if cost.distanceKm is not null %}
                        <div><dt>{{ 'ownership.row.distance'|trans }}</dt><dd class="tabular">{{ cost.distanceKm|distance }}</dd></div>
                    {% endif %}
                    <div>
                        <dt>{{ 'ownership.row.running'|trans }}</dt>
                        <dd>
                            <span class="tabular">{{ cost.running|money }}</span>
                            {% for group in cost.spentGroups() %}
                                <br><span class="muted">{{ ('expense.group.' ~ group.group.value)|trans }} <span class="tabular">{{ group.amount|money }}</span></span>
                            {% endfor %}
                        </dd>
                    </div>
                    {% if cost.isComplete() %}
                        <div><dt>{{ 'ownership.row.depreciation'|trans }}</dt><dd class="tabular">{{ own.depreciation(cost) }}</dd></div>
                        <div>
                            <dt>{{ 'ownership.row.total'|trans }}</dt>
                            <dd><strong class="tabular">{{ cost.total|money }}</strong> <span class="muted">({{ own.total_label(cost) }})</span></dd>
                        </div>
                    {% endif %}
                    {% if cost.perKm is not null %}
                        <div>
                            <dt>{{ 'ownership.row.per_distance'|trans }}</dt>
                            <dd><span class="tabular">{{ cost.perKm|per_distance(cost.currency) }}</span><br><span class="muted">{{ own.per_distance_parts(cost) }}</span></dd>
                        </div>
                    {% endif %}
                    {% if cost.perMonth is not null %}
                        <div>
                            <dt>{{ 'ownership.row.per_month'|trans }}</dt>
                            <dd><span class="tabular">{{ cost.perMonth|money }}</span><br><span class="muted">{{ own.per_month_parts(cost) }}</span></dd>
                        </div>
                    {% endif %}
                </dl>
                {% if not cost.isComplete() %}
                    <p class="field__hint">{{ (cost.depreciation.state.value == 'no_purchase_price' ? 'valuation.hint.no_purchase_price' : 'valuation.hint.no_value')|trans }}</p>
                {% endif %}
                {% if cost.isTooShort() %}
                    <p class="field__hint">{{ 'ownership.hint.too_short'|trans }}</p>
                {% elseif cost.mileageStartsOn() %}
                    <p class="field__hint">{{ 'ownership.hint.mileage_starts'|trans({date: cost.mileageStartsOn()|local_date}) }}</p>
                {% elseif cost.distanceKm is null %}
                    <p class="field__hint">{{ 'ownership.hint.no_distance'|trans }}</p>
                {% endif %}
                <div class="btn-row">
                    <a class="btn" href="{{ url_for('expenses.index', {id: vehicle.id}) }}">{{ 'expense.title'|trans }}</a>
                    {% if feature_enabled('reports') %}
                        <a class="btn" href="{{ url_for('reports.ownership', {}, {vehicle: vehicle.id}) }}">{{ 'ownership.report_link'|trans }}</a>
                    {% endif %}
                </div>
            </section>
            {% endif %}

        </div>
    </div>
{% endblock %}

{# A date and an amount, either of which may be missing: "14 Mar 2021 · £14,250". #}
{% macro dated(date, amount, currency) -%}
    {{- date ? date|local_date -}}
    {{- date and amount is not null ? ' · ' -}}
    {%- if amount is not null %}<span class="tabular">{{ amount|money(currency) }}</span>{% endif -%}
{%- endmacro %}

{# The purchase or sale paperwork beside its date: a paperclip with the count,
   opening the edit form where the files are listed (spec.md §7.1). #}
{% macro paperwork(vehicle, side, counts) -%}
    {%- import 'macros/attachments.twig' as paperclip -%}
    {%- set n = counts.of(side, vehicle.id) -%}
    {%- if n > 0 -%}
        {{ ' ' }}<a class="ownership-files" href="{{ url_for('vehicles.edit', {id: vehicle.id}) }}" data-modal title="{{ ('vehicle.paperwork_files.' ~ side)|trans({count: n}) }}">{{ paperclip.count(n) }}</a>
    {%- endif -%}
{%- endmacro %}
