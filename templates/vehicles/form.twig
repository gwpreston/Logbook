{% extends 'layout.twig' %}
{% import 'macros/ui.twig' as ui %}
{% import 'macros/attachments.twig' as files %}

{% set active_nav = 'garage' %}
{% set editing = vehicle is not null %}
{% set heading = editing ? 'vehicle.edit_title'|trans({name: vehicle.name()}) : 'vehicle.add_title'|trans %}
{% set volume_symbol = ('units.symbol.' ~ prefs().volumeUnit.value)|trans %}
{% set energy_symbol = 'units.symbol.kwh'|trans %}

{% block title %}{{ heading }} · {{ parent() }}{% endblock %}

{% block content %}
    <div class="page__stack page__stack--narrow">
        <a class="back-link" href="{{ editing ? url_for('vehicles.show', {id: vehicle.id}) : url_for('garage') }}">{{ ui.icon('chevron_left') }}{{ editing ? vehicle.name() : 'garage.title'|trans }}</a>

        <header class="page-header">
            <h1 class="page-header__title">{{ heading }}</h1>
        </header>

        {% block modal_body %}
        {% if errors is not empty %}
            <div class="alert alert--error" role="alert">{{ ui.icon('error') }}<span>{{ 'form.has_errors'|trans }}</span></div>
        {% endif %}

        <form class="form" method="post" enctype="multipart/form-data"
              action="{{ editing ? url_for('vehicles.edit', {id: vehicle.id}) : url_for('vehicles.create') }}"
              x-data="{
                  fuel: '{{ (values.fuel_type ?? 'petrol')|e('js') }}',
                  grade: '{{ (values.default_grade ?? '')|e('js') }}',
                  families: {{ grade_families|json_encode }},
                  capacityLabels: {{ capacity_labels|map(key => key|trans)|json_encode }},
                  gradeFamily() { return this.families[this.fuel] ?? null; },
                  init() { this.$watch('fuel', this.dropUnfittingGrade.bind(this)); },
                  dropUnfittingGrade() {
                      var group = this.grade === '' ? null : this.$refs.grades.querySelector('option[value=&quot;' + this.grade + '&quot;]').parentElement;
                      if (group !== null &amp;&amp; group.dataset.family !== this.gradeFamily()) { this.grade = ''; }
                  },
              }">
            {{ ui.csrf(csrf) }}
            {{ ui.return_field(return_to) }}

            <section class="card" aria-labelledby="basics-heading">
                <h2 id="basics-heading" class="card__title">{{ 'vehicle.section.basics'|trans }}</h2>

                {% set type_options = [] %}
                {% for type in types %}
                    {% set type_options = type_options|merge([{value: type.value, label: ('vehicle.type.' ~ type.value)|trans, icon: type.icon()}]) %}
                {% endfor %}
                {{ ui.chips('type', 'vehicle.field.type'|trans, values, errors, type_options, {required: true}) }}

                <div class="form-row">
                    {{ ui.input('make', 'vehicle.field.make'|trans, values, errors, {required: true, maxlength: 100, autocomplete: 'off'}) }}
                    {{ ui.input('model', 'vehicle.field.model'|trans, values, errors, {required: true, maxlength: 100, autocomplete: 'off'}) }}
                </div>
                <div class="form-row">
                    {{ ui.input('variant', 'vehicle.field.variant'|trans, values, errors, {optional: true, maxlength: 100, autocomplete: 'off', hint: 'vehicle.hint.variant'|trans}) }}
                    {{ ui.input('nickname', 'vehicle.field.nickname'|trans, values, errors, {optional: true, maxlength: 100, hint: 'vehicle.hint.nickname'|trans}) }}
                </div>
                <div class="form-row">
                    {{ ui.input('year', 'vehicle.field.year'|trans, values, errors, {type: 'number', optional: true, inputmode: 'numeric', min: first_year, step: 1, hint: 'vehicle.hint.year'|trans}) }}
                    {{ ui.input('first_registered_on', 'vehicle.field.first_registered_on'|trans, values, errors, {type: 'date', optional: true, min: first_registration, max: last_registration, hint: 'vehicle.hint.first_registered_on'|trans}) }}
                </div>
                <div class="form-row">
                    {{ ui.input('registration', 'vehicle.field.registration'|trans, values, errors, {optional: true, maxlength: 20, autocomplete: 'off'}) }}
                    {{ ui.input('vin', 'vehicle.field.vin'|trans, values, errors, {optional: true, maxlength: 40, autocomplete: 'off', hint: 'vehicle.hint.vin'|trans}) }}
                </div>

                {% set fuel_options = [] %}
                {% for fuel in fuel_types %}
                    {% set fuel_options = fuel_options|merge([{value: fuel.value, label: ('vehicle.fuel.' ~ fuel.value)|trans}]) %}
                {% endfor %}
                <div class="form-row">
                    <div class="field">
                        <label class="field__label" for="f-fuel_type">{{ 'vehicle.field.fuel_type'|trans }}</label>
                        <select class="select" id="f-fuel_type" name="fuel_type" required x-model="fuel"{{ ui.described_by('fuel_type', errors, true) }}>
                            {% for option in fuel_options %}
                                <option value="{{ option.value }}"{% if option.value == (values.fuel_type ?? '') %} selected{% endif %}>{{ option.label }}</option>
                            {% endfor %}
                        </select>
                        {# Both kinds of hybrid explained up front, so the hint
                           is right for any choice with or without JS. #}
                        <p class="field__hint" id="f-fuel_type-hint">{{ 'vehicle.fuel_hint.hybrid'|trans }} {{ 'vehicle.fuel_hint.phev'|trans }}</p>
                        {{ ui.field_error(errors, 'fuel_type') }}
                    </div>
                    <div class="field">
                        <label class="field__label" for="f-capacity"><span x-text="capacityLabels[fuel] ?? capacityLabels.petrol">{{ (capacity_labels[values.fuel_type ?? 'petrol'] ?? capacity_labels.petrol)|trans }}</span> <span class="field__optional">{{ 'form.optional'|trans }}</span></label>
                        <div class="input-group">
                            <input class="input" id="f-capacity" name="capacity" type="number" step="any" min="0" inputmode="decimal" value="{{ values.capacity ?? '' }}"{{ ui.described_by('capacity', errors, true) }}>
                            <span class="input-group__suffix" aria-hidden="true" x-text="fuel === 'ev' ? '{{ energy_symbol|e('js') }}' : '{{ volume_symbol|e('js') }}'">{{ (values.fuel_type ?? '') == 'ev' ? energy_symbol : volume_symbol }}</span>
                        </div>
                        <p class="field__hint" id="f-capacity-hint">{{ 'vehicle.hint.capacity'|trans({unit: volume_symbol}) }}</p>
                        {{ ui.field_error(errors, 'capacity') }}
                    </div>
                </div>
                {# Default grade: every family's grades without JS (the server
                   drops one that does not fit the fuel type); with JS only the
                   fitting family, and none for LPG / other. #}
                <div class="field" x-show="gradeFamily() !== null">
                    <label class="field__label" for="f-default_grade">{{ 'vehicle.field.default_grade'|trans }} <span class="field__optional">{{ 'form.optional'|trans }}</span></label>
                    <select class="select" id="f-default_grade" name="default_grade" x-model="grade" x-ref="grades"{{ ui.described_by('default_grade', errors, true) }}>
                        <option value="">{{ 'vehicle.default_grade.none'|trans }}</option>
                        {% for family, grades in grade_groups %}
                            <optgroup label="{{ ('fuel.fuel.' ~ family)|trans }}" data-family="{{ family }}" :disabled="gradeFamily() !== '{{ family }}'" :hidden="gradeFamily() !== '{{ family }}'">
                                {% for grade in grades %}
                                    <option value="{{ grade.value }}"{% if grade.value == (values.default_grade ?? '') %} selected{% endif %}>{{ grade.labelKey()|trans }}</option>
                                {% endfor %}
                            </optgroup>
                        {% endfor %}
                    </select>
                    <p class="field__hint" id="f-default_grade-hint">{{ 'vehicle.hint.default_grade'|trans }}</p>
                    {{ ui.field_error(errors, 'default_grade') }}
                </div>
                {% if editing %}
                    {# The current odometer is the latest reading in the
                       mileage log; it is changed there, never here. #}
                    <dl class="field">
                        <dt class="field__label">{{ 'vehicle.field.current_odometer'|trans }}</dt>
                        <dd class="current-reading">
                            {% if current_reading %}
                                <span class="tabular">{{ current_reading.readingKm|distance }}</span>
                                <span class="muted">{{ 'odometer.stat.as_of'|trans({date: current_reading.recordedAt|instant_date}) }}</span>
                            {% else %}
                                <span class="muted">{{ 'vehicle.no_readings'|trans }}</span>
                            {% endif %}
                            <a href="{{ url_for('odometer.create', {id: vehicle.id}) }}" data-modal>{{ 'odometer.add'|trans }}</a>
                        </dd>
                        <dd class="field__hint">{{ 'vehicle.hint.current_odometer_edit'|trans }}</dd>
                    </dl>
                {% else %}
                    <div class="form-row">
                        {{ ui.input('current_odometer', 'vehicle.field.current_odometer'|trans, values, errors, {type: 'number', optional: true, step: 'any', min: 0, inputmode: 'decimal', suffix: ('units.symbol.' ~ prefs().distanceUnit.value)|trans, hint: 'vehicle.hint.current_odometer'|trans}) }}
                        {{ ui.input('current_odometer_on', 'vehicle.field.current_odometer_on'|trans, values, errors, {type: 'date', optional: true, min: first_registration, max: last_registration, hint: 'vehicle.hint.current_odometer_on'|trans}) }}
                    </div>
                {% endif %}
            </section>

            <section class="card" aria-labelledby="photo-heading">
                <h2 id="photo-heading" class="card__title">{{ 'vehicle.section.photo'|trans }}</h2>
                <div class="photo-field">
                    {% if editing %}{{ ui.vehicle_photo(vehicle, 'vehicle-photo--thumb') }}{% endif %}
                    <div class="field">
                        <label class="field__label" for="f-photo">{{ (editing and vehicle.hasPhoto() ? 'vehicle.field.photo_replace' : 'vehicle.field.photo')|trans }} <span class="field__optional">{{ 'form.optional'|trans }}</span></label>
                        <input class="input input--file" id="f-photo" name="photo" type="file" accept="image/jpeg,image/png,image/webp"{{ ui.described_by('photo', errors, true) }}>
                        <p class="field__hint" id="f-photo-hint">{{ 'vehicle.hint.photo'|trans({max: max_upload_mb}) }}</p>
                        {{ ui.field_error(errors, 'photo') }}
                    </div>
                </div>
                {% if editing and vehicle.hasPhoto() %}
                    <label class="checkbox">
                        <input type="checkbox" name="remove_photo" value="1"{% if (values.remove_photo ?? '') == '1' %} checked{% endif %}>
                        <span>{{ 'vehicle.field.remove_photo'|trans }}</span>
                    </label>
                {% endif %}
            </section>

            <section class="card" aria-labelledby="money-heading">
                <h2 id="money-heading" class="card__title">{{ 'vehicle.section.ownership'|trans }}</h2>

                {% set currency_choices = [{value: '', label: 'vehicle.currency_default'|trans({currency: default_currency})}]|merge(currency_options) %}
                {{ ui.select('currency', 'vehicle.field.currency'|trans, values, errors, currency_choices, {hint: 'vehicle.hint.currency'|trans}) }}

                <div class="form-row">
                    {{ ui.input('purchase_date', 'vehicle.field.purchase_date'|trans, values, errors, {type: 'date', optional: true}) }}
                    {{ ui.input('purchase_price', 'vehicle.field.purchase_price'|trans, values, errors, {type: 'number', optional: true, step: 'any', min: 0, inputmode: 'decimal'}) }}
                </div>
                {# Paperwork belongs to the purchase and the sale, and shows on
                   their milestones, so it needs their dates (spec.md §7.12).
                   Both inputs share one limit per save. #}
                {% set paperwork_hint = 'vehicle.hint.paperwork'|trans({files: max_upload_files, max: max_upload_mb}) %}
                {{ files.input(vehicle, purchase_files, errors, max_upload_mb, max_upload_files, {field: 'purchase_attachments', label: 'vehicle.field.purchase_paperwork'|trans, hint: paperwork_hint, group: 'paperwork'}) }}
                <div class="form-row">
                    {{ ui.input('sale_date', 'vehicle.field.sale_date'|trans, values, errors, {type: 'date', optional: true}) }}
                    {{ ui.input('sale_price', 'vehicle.field.sale_price'|trans, values, errors, {type: 'number', optional: true, step: 'any', min: 0, inputmode: 'decimal'}) }}
                </div>
                {{ files.input(vehicle, sale_files, errors, max_upload_mb, max_upload_files, {field: 'sale_attachments', label: 'vehicle.field.sale_paperwork'|trans, hint: paperwork_hint, group: 'paperwork'}) }}
            </section>

            <div class="btn-row">
                <button type="submit" class="btn btn--primary btn--lg">{{ ui.icon('check_circle') }}{{ (editing ? 'form.save' : 'vehicle.add_submit')|trans }}</button>
                <a data-modal-cancel class="btn btn--lg" href="{{ return_to ?: (editing ? url_for('vehicles.show', {id: vehicle.id}) : url_for('garage')) }}">{{ 'form.cancel'|trans }}</a>
            </div>
        </form>
        {% endblock %}
    </div>
{% endblock %}
