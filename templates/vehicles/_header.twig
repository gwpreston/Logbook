{#
 # Vehicle page header shared by the vehicle's tabs (spec.md §7.2, §8
 # *Vehicle header*): back link and the Edit / Prepare for sale (§7.19) /
 # Sharing (§7.21) / Archive (Restore) / Delete actions, in the same place on
 # every tab, each only for those allowed it; the hero; and the tab bar. Each
 # tab is its own URL, so tabs work without JS and survive a hard refresh.
 # The name looks the same on every tab: the page's <h1> on Overview, a <p>
 # elsewhere, where the tab's own <h1> is visually hidden.
 #
 # Expects: vehicle, active_tab ('overview' | 'history' | 'odometer' | 'trips' | 'fuel' |
 # 'maintenance' | 'tyres' | 'compliance' | 'incidents' | 'finance' | 'expenses').
 #}
{% import 'macros/ui.twig' as ui %}
{% import 'macros/vehicles.twig' as vehicle_ui %}
{% set data = vehicle.data %}
{# Finance (spec.md §7.32 *Finance tab*): Manage with costs, the module on. #}
{% set tabs = [
    {route: 'vehicles.show', key: 'overview', icon: 'dashboard', label: 'vehicle.tab.overview'},
    {route: 'history.vehicle', key: 'history', icon: 'history', label: 'vehicle.tab.history'},
    {route: 'odometer.index', key: 'odometer', icon: 'speed', label: 'vehicle.tab.odometer'},
    {route: 'trips.index', key: 'trips', icon: 'route', label: 'vehicle.tab.trips', feature: 'trips'},
    {route: 'fuel.index', key: 'fuel', icon: data.fuelType.isElectric() ? 'ev_station' : 'local_gas_station', label: 'vehicle.tab.fuel', feature: 'fuel'},
    {route: 'maintenance.index', key: 'maintenance', icon: 'build', label: 'vehicle.tab.maintenance', feature: 'maintenance'},
    {route: 'tyres.index', key: 'tyres', icon: 'tire_repair', label: 'vehicle.tab.tyres', feature: 'tyres'},
    {route: 'compliance.index', key: 'compliance', icon: 'description', label: 'vehicle.tab.compliance', feature: 'compliance'},
    {route: 'incidents.index', key: 'incidents', icon: 'car_crash', label: 'vehicle.tab.incidents', feature: 'incidents'},
    {route: 'finance.index', key: 'finance', icon: 'account_balance', label: 'vehicle.tab.finance', shown: finance_menu(vehicle) is not null},
    {route: 'expenses.index', key: 'expenses', icon: 'payments', label: 'vehicle.tab.expenses'},
]|filter(tab => (tab.feature is not defined or feature_enabled(tab.feature)) and (tab.shown ?? true)) %}

<div class="toolbar">
    <a class="back-link" href="{{ url_for('garage', {}, vehicle.isArchived() ? {archived: '1'} : {}) }}">{{ ui.icon('chevron_left') }}{{ 'garage.title'|trans }}</a>
    <div class="btn-row vehicle-actions">
        {% if can_vehicle(vehicle, 'manage') %}
            <a class="btn" href="{{ url_for('vehicles.edit', {id: vehicle.id}) }}" data-modal>{{ ui.icon('edit') }}{{ 'form.edit'|trans }}</a>
            <a class="btn" href="{{ url_for('sale_pack.show', {id: vehicle.id}) }}">{{ ui.icon('sell') }}{{ 'sale_pack.prepare'|trans }}</a>
        {% endif %}
        <a class="btn" href="{{ url_for('vehicles.sharing', {id: vehicle.id}) }}">{{ ui.icon('group') }}{{ 'sharing.menu'|trans }}</a>
        {% if not can_vehicle(vehicle, 'own') %}
        {% elseif vehicle.isArchived() %}
            <form method="post" action="{{ url_for('vehicles.restore', {id: vehicle.id}) }}">
                {{ ui.csrf(csrf) }}
                <button type="submit" class="btn">{{ ui.icon('unarchive') }}{{ 'vehicle.restore'|trans }}</button>
            </form>
        {% elseif total_loss_offered(vehicle) or finance_archive_offered(vehicle) %}
            {# A settled write-off or a finance agreement: the confirm page (spec.md §7.29 *Total loss*, §7.32 *Archive page*). #}
            <a class="btn" href="{{ url_for('vehicles.archive', {id: vehicle.id}) }}" data-modal>{{ ui.icon('archive') }}{{ 'vehicle.archive'|trans }}</a>
        {% else %}
            <form method="post" action="{{ url_for('vehicles.archive', {id: vehicle.id}) }}">
                {{ ui.csrf(csrf) }}
                <button type="submit" class="btn">{{ ui.icon('archive') }}{{ 'vehicle.archive'|trans }}</button>
            </form>
        {% endif %}
        {% if can_vehicle(vehicle, 'own') %}
            <a class="btn btn--danger" href="{{ url_for('vehicles.delete', {id: vehicle.id}) }}">{{ ui.icon('delete') }}{{ 'form.delete'|trans }}</a>
        {% endif %}
    </div>
</div>

<header class="vehicle-hero">
    {{ ui.vehicle_photo(vehicle, 'vehicle-photo--hero') }}
    <div class="vehicle-hero__text">
        <div class="vehicle-card__tags">
            {% if data.registration %}<span class="plate">{{ data.registration }}</span>{% endif %}
            <span class="pill">{{ ('vehicle.fuel.' ~ data.fuelType.value)|trans }}</span>
            {% if vehicle.isArchived() and (vehicle.isWrittenOff() or vehicle.isReturned()) %}
                <span class="pill pill--soon">{{ ui.icon(vehicle.isReturned() ? 'key_off' : 'car_crash') }}{{ vehicle_ui.disposal(vehicle) }}</span>
            {% elseif vehicle.isArchived() %}
                <span class="pill pill--soon">{{ ui.icon('inventory_2') }}{{ 'vehicle.archived_on'|trans({date: vehicle.archivedAt|instant_date}) }}</span>
            {% endif %}
            {% set written_off = write_off(vehicle) %}
            {% if written_off %}<span class="pill pill--overdue" title="{{ 'incident.field.write_off'|trans }}">{{ ui.icon('car_crash') }}{{ written_off.labelKey()|trans }}</span>{% endif %}
        </div>
        {% if active_tab == 'overview' %}
            <h1 class="vehicle-hero__name">{{ vehicle.name() }}</h1>
        {% else %}
            <p class="vehicle-hero__name">{{ vehicle.name() }}</p>
        {% endif %}
        <p class="muted">{{ vehicle.description() }}</p>
    </div>
</header>

<nav class="tabs" data-vehicle-tabs aria-label="{{ 'vehicle.tab.label'|trans({name: vehicle.name()}) }}">
    {% for tab in tabs %}
        <a class="tabs__link" href="{{ url_for(tab.route, {id: vehicle.id}) }}"{% if tab.key == active_tab %} aria-current="page"{% endif %}>{{ ui.icon(tab.icon) }}{{ tab.label|trans }}</a>
    {% endfor %}
</nav>
