{#
 # Toolbar of a vehicle's list tab (spec.md §7.2): the tab's title, its
 # <h1>, visually hidden (§8 *Vehicle header*); Export CSV, Import CSV and the add button right-aligned, the same
 # on every tab. Add buttons open in the modal on desktop (spec.md §5).
 #
 # Expects: vehicle, title, module (CSV module name),
 #          add: {route, label, icon?, ability? (default 'log')} or null,
 #          print (optional, default false): a Print button (spec.md §8
 #          *Printing reports*; the Fuel and Mileage tabs),
 #          export (optional, default true): false leaves Export CSV to the
 #          tab itself (the Trips tab's card header), keeping Import CSV.
 #}
{% import 'macros/ui.twig' as ui %}
{% import 'macros/expenses.twig' as exp %}
<div class="toolbar list-toolbar">
    <h1 class="visually-hidden">{{ title }}</h1>
    <div class="btn-row list-toolbar__actions">
        {% if print|default(false) %}{{ ui.print_button() }}{% endif %}
        {% if export|default(true) %}{{ exp.export_link(vehicle, module) }}{% else %}{{ exp.import_csv(vehicle, module) }}{% endif %}
        {% if add|default(null) and not vehicle.isArchived() and can_vehicle(vehicle, add.ability ?? 'log') %}
            <a class="btn btn--primary" href="{{ url_for(add.route, {id: vehicle.id}) }}" data-modal>{{ ui.icon(add.icon ?? 'add') }}{{ add.label }}</a>
        {% endif %}
    </div>
</div>
