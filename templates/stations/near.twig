{% extends 'layout.twig' %}
{% import 'macros/ui.twig' as ui %}
{% import 'macros/fuel_prices.twig' as fp %}

{#
 # Cheapest near me (spec.md §7.34): a GET form that works without JS. With
 # JS, *My current location* asks the browser for the position when the form
 # is sent (js/stations.js, [data-near-form]); it is used for this search and
 # never stored. Rows are ordered by effective cost; each opens the sum
 # against the nearest station selling the grade.
 #}
{% set active_nav = 'stations' %}

{% block title %}{{ 'fuel_prices.near.title'|trans }} · {{ parent() }}{% endblock %}

{% block content %}
    <div class="page__stack">
        <a class="back-link" href="{{ url_for('stations.index') }}">{{ ui.icon('chevron_left') }}{{ 'stations.title'|trans }}</a>

        <header class="page-header">
            <div>
                <h1 class="page-header__title">{{ 'fuel_prices.near.title'|trans }}</h1>
                <p class="page-header__lead">{{ 'fuel_prices.near.lead'|trans }}</p>
            </div>
        </header>

        {% if vehicles is empty %}
            <section class="card"><p class="muted">{{ 'fuel_prices.near.no_vehicles'|trans }}</p></section>
        {% else %}
            <form class="card form" method="get" action="{{ url_for('stations.near') }}" data-near-form
                  data-finding="{{ 'stations.locate_finding'|trans }}" data-failed="{{ 'fuel_prices.near.locate_failed'|trans }}">
                <div class="form-row form-row--3">
                    <div class="field">
                        <label class="field__label" for="f-from">{{ 'fuel_prices.near.from'|trans }}</label>
                        <select class="select" id="f-from" name="from" aria-describedby="f-from-hint">
                            <option value="here" data-here hidden{% if from == 'here' %} selected{% endif %}>{{ 'fuel_prices.near.here'|trans }}</option>
                            {% if places is not empty %}
                                <optgroup label="{{ 'fuel_prices.near.places'|trans }}">
                                    {% for place in places %}
                                        <option value="place:{{ place.id }}"{% if from == 'place:' ~ place.id %} selected{% endif %}>{{ place.data.name }}</option>
                                    {% endfor %}
                                </optgroup>
                            {% endif %}
                            {% if stations is not empty %}
                                <optgroup label="{{ 'fuel_prices.near.stations'|trans }}">
                                    {% for station in stations %}
                                        <option value="station:{{ station.id }}"{% if from == 'station:' ~ station.id %} selected{% endif %}>{{ station.data.name }}</option>
                                    {% endfor %}
                                </optgroup>
                            {% endif %}
                        </select>
                        <p class="field__hint" id="f-from-hint" data-near-status aria-live="polite">{{ 'fuel_prices.near.here_hint'|trans }}</p>
                        <input type="hidden" name="lat" value="{{ position.lat ?? '' }}" data-near-lat>
                        <input type="hidden" name="lng" value="{{ position.lng ?? '' }}" data-near-lng>
                    </div>
                    <div class="field">
                        <label class="field__label" for="f-vehicle">{{ 'fuel_prices.near.vehicle'|trans }}</label>
                        <select class="select" id="f-vehicle" name="vehicle">
                            {% for v in vehicles %}
                                <option value="{{ v.id }}"{% if vehicle and v.id == vehicle.id %} selected{% endif %}>{{ v.name() }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="field">
                        <label class="field__label" for="f-grade">{{ 'fuel_prices.near.grade'|trans }}</label>
                        <select class="select" id="f-grade" name="grade">
                            {% for g in grades %}
                                <option value="{{ g.value }}"{% if grade and g == grade %} selected{% endif %}>{{ g.labelKey()|trans }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
                <div class="form-row form-row--3">
                    <div class="field">
                        <label class="field__label" for="f-radius">{{ 'fuel_prices.near.radius'|trans }}</label>
                        <select class="select" id="f-radius" name="radius">
                            {% for r in radii %}
                                <option value="{{ r }}"{% if r == radius %} selected{% endif %}>{{ ('fuel_prices.near.radius_' ~ user.preferences.distanceUnit.value)|trans({count: r}) }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="field">
                        <label class="field__label" for="f-sort">{{ 'fuel_prices.near.sort'|trans }}</label>
                        <select class="select" id="f-sort" name="sort">
                            {% for option in ['effective', 'price', 'distance'] %}
                                <option value="{{ option }}"{% if sort.value == option %} selected{% endif %}>{{ ('fuel_prices.near.sort_' ~ option)|trans }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="field">
                        <label class="toggle">
                            <input type="checkbox" name="older" value="1"{% if older %} checked{% endif %}>
                            <span class="toggle__text">
                                <span class="toggle__title">{{ 'fuel_prices.near.older'|trans }}</span>
                                <span class="toggle__hint">{{ 'fuel_prices.near.older_hint'|trans }}</span>
                            </span>
                        </label>
                    </div>
                </div>
                <div class="btn-row">
                    <button type="submit" class="btn btn--primary">{{ ui.icon('search') }}{{ 'fuel_prices.near.search'|trans }}</button>
                </div>
            </form>

            {% if needs_position %}
                <div class="alert alert--info" role="status" data-needs-position>{{ ui.icon('info') }}<span>{{ 'fuel_prices.near.needs_position'|trans }}</span></div>
            {% endif %}

            {% if result %}
                {% set profile = result.profile %}
                <section class="card" aria-labelledby="near-results" data-near-results>
                    <h2 id="near-results" class="card__title">
                        {{- 'fuel_prices.near.results'|trans({grade: result.grade.shortLabelKey()|trans, radius: result.radiusKm|distance(0), from: origin.label ?? 'fuel_prices.near.your_location'|trans}) -}}
                    </h2>
                    <p class="field__hint" data-near-assumptions>
                        {{- 'fuel_prices.near.usual_fill'|trans({volume: profile.usualFill|volume(1)}) -}}
                        {%- if profile.fillAssumed %} ({{ 'fuel_prices.near.assumed'|trans }}){% endif %} ·
                        {% if profile.hasEconomy() -%}
                            {{ 'fuel_prices.near.economy'|trans({economy: profile.economyKm|consumption(profile.economyLitres)}) }}{% if profile.economyAllTime %} ({{ 'fuel_prices.near.all_time'|trans }}){% endif %}
                        {%- else -%}
                            {{ 'fuel_prices.near.no_economy'|trans }}
                        {%- endif -%}
                    </p>
                    {% if result.rows is empty %}
                        <p class="muted" data-near-empty>{{ 'fuel_prices.near.none'|trans({grade: result.grade.shortLabelKey()|trans, radius: result.radiusKm|distance(0)}) }}</p>
                    {% else %}
                        <div class="table-wrap">
                            <table class="table near-table">
                                <caption class="visually-hidden">{{ 'fuel_prices.near.caption'|trans }}</caption>
                                <thead>
                                    <tr>
                                        <th scope="col">{{ 'fuel_prices.near.col.station'|trans }}</th>
                                        <th scope="col" class="table__num">{{ 'fuel_prices.near.col.distance'|trans }}</th>
                                        <th scope="col">{{ 'fuel_prices.near.col.listed'|trans }}</th>
                                        <th scope="col" class="table__num">{{ 'fuel_prices.near.col.effective'|trans }}</th>
                                        <th scope="col">{{ 'fuel_prices.near.col.saves'|trans }}</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for row in result.rows %}
                                        {% set ps = row.providerStation %}
                                        <tr data-near-row="{{ ps.ref() }}">
                                            <th scope="row">
                                                {% if row.station %}
                                                    <a href="{{ url_for('stations.show', {station: row.station.id}) }}">{{ row.station.data.name }}</a>
                                                {% else %}
                                                    {{ ps.data.name }}
                                                {% endif %}
                                                {% if ps.data.brand and ps.data.brand != ps.data.name %}<span class="muted"> · {{ ps.data.brand }}</span>{% endif %}
                                                {% if not row.station %}
                                                    <form method="post" action="{{ url_for('stations.near.add') }}" class="near-table__add">
                                                        {{ ui.csrf(csrf) }}
                                                        <input type="hidden" name="ref" value="{{ ps.ref() }}">
                                                        <button type="submit" class="btn btn--ghost">{{ ui.icon('add') }}{{ 'fuel_prices.near.add_station'|trans }}<span class="visually-hidden"> {{ ps.data.name }}</span></button>
                                                    </form>
                                                {% endif %}
                                            </th>
                                            <td class="table__num tabular">{{ row.cost.km|distance(1) }}</td>
                                            <td>{{ fp.listed(row.listed, currency) }}</td>
                                            <td class="table__num tabular">{{ 'fuel_prices.near.effective'|trans({amount: row.cost.total|money(currency), volume: row.cost.fill|volume(1)}) }}</td>
                                            <td>
                                                {% if row.isNearest() %}
                                                    <span class="pill">{{ 'fuel_prices.near.nearest'|trans }}</span>
                                                {% else %}
                                                    {% set w = row.worthIt %}
                                                    <details class="near-sum" data-worth-it>
                                                        <summary>{{ w.actualSaving|price_saving(currency) }}</summary>
                                                        <p>
                                                            {{ (w.priceDifference starts with '-' ? 'fuel_prices.worth.fuel_saving_more' : 'fuel_prices.worth.fuel_saving')|trans({amount: w.fuelSaving|signed_money(currency), volume: row.cost.fill|volume(1), difference: (w.priceDifference|trim('-', 'left'))|unit_price(currency, false, true)}) }}
                                                            · {{ 'fuel_prices.worth.extra_distance'|trans({straight: w.extraKm|distance(1), road: w.extraRoadKm|distance(1)}) }}
                                                            · {% if profile.hasEconomy() %}{{ 'fuel_prices.worth.fuel_for_that'|trans({amount: w.fuelForThat|signed_money(currency), economy: profile.economyKm|consumption(profile.economyLitres)}) }}{% else %}{{ 'fuel_prices.worth.no_economy'|trans }}{% endif %}
                                                            · <strong>{{ (w.isWorthIt() ? 'fuel_prices.worth.worth_it' : 'fuel_prices.worth.not_worth_it')|trans({amount: w.actualSaving|signed_money(currency)}) }}</strong>
                                                        </p>
                                                    </details>
                                                {% endif %}
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                        {% if result.total > result.rows|length %}<p class="muted">{{ 'fuel_prices.near.capped'|trans({shown: result.rows|length, total: result.total}) }}</p>{% endif %}
                    {% endif %}
                    <p class="field__hint">{{ 'fuel_prices.near.hint'|trans }}</p>
                    <p class="field__hint" data-near-sync>{{ result.lastSync ? 'fuel_prices.near.synced'|trans({when: result.lastSync|local_datetime}) : 'fuel_prices.settings.sync.never'|trans }}</p>
                    {{ fp.attribution(provider) }}
                </section>
            {% endif %}
        {% endif %}
    </div>
{% endblock %}
