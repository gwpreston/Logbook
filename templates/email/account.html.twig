<!doctype html>
<html lang="{{ html_lang() }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ mail.subject }}</title>
</head>
<body style="margin:0;padding:24px;background:#f4f5f7;color:#1c1f24;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:1.5">
<div style="max-width:520px;margin:0 auto;background:#ffffff;border-radius:12px;padding:24px">
<p style="margin:0 0 16px;font-weight:700;font-size:17px">{{ 'app.name'|trans }}</p>
{% for paragraph in mail.paragraphs %}
<p style="margin:0 0 16px">{{ paragraph }}</p>
{% endfor %}
{% if mail.link %}
<p style="margin:0 0 16px"><a href="{{ mail.link }}" style="display:inline-block;padding:12px 18px;border-radius:10px;background:#1f5fd6;color:#ffffff;font-weight:700;text-decoration:none">{{ mail.linkLabel ?? mail.link }}</a></p>
<p style="margin:0 0 16px;font-size:13px;color:#5b6270;word-break:break-all">{{ mail.link }}</p>
{% endif %}
{% for paragraph in mail.after %}
<p style="margin:0 0 16px;font-size:13px;color:#5b6270">{{ paragraph }}</p>
{% endfor %}
</div>
</body>
</html>
