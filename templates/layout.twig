{% import 'macros/ui.twig' as ui %}
{#
 # Primary navigation. Each entry: route name, translation key, icon, and the
 # `active_nav` value that marks it current. Later phases add Garage,
 # Reminders, Reports and Settings here (gated by feature toggles).
 #}
{% set nav_items = [
    {route: 'home', label: 'nav.dashboard', icon: 'space_dashboard', key: 'home'},
] %}
{% set current_nav = active_nav|default('') %}
<!doctype html>
<html lang="{{ html_lang() }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#f3f5f8" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0a111c" media="(prefers-color-scheme: dark)">
    <title>{% block title %}{{ 'app.name'|trans }}{% endblock %}</title>
    <link rel="icon" type="image/png" href="{{ asset('images/logbook-mark.png') }}">
    <link rel="apple-touch-icon" href="{{ asset('images/logbook-mark.png') }}">
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    {# Sets data-theme before first paint; everything else is deferred. #}
    <script src="{{ asset('js/theme.js') }}"></script>
    {# Vendored libraries: progressive enhancement only; every core flow works without JS. #}
    <script defer src="{{ asset('vendor/sortable.min.js') }}"></script>
    <script defer src="{{ asset('vendor/chart.umd.min.js') }}"></script>
    <script defer src="{{ asset('js/app.js') }}"></script>
    <script defer src="{{ asset('vendor/alpine.min.js') }}"></script>
    {% block head %}{% endblock %}
</head>
<body>
    <a class="skip-link" href="#main">{{ 'nav.skip_to_content'|trans }}</a>

    <div class="app">
        {# Wide screens (>= 960px): sidebar. Hidden on narrow screens. #}
        <aside class="sidebar">
            {{ ui.brand() }}

            {% block primary_action %}{% endblock %}

            <nav aria-label="{{ 'nav.label'|trans }}">
                <ul class="nav-list">
                    {% for item in nav_items %}
                        <li>
                            <a class="nav-link" href="{{ url_for(item.route) }}"{% if current_nav == item.key %} aria-current="page"{% endif %}>
                                {{ ui.icon(item.icon) }}
                                <span class="nav-link__label">{{ item.label|trans }}</span>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </nav>

            {% block sidebar %}{% endblock %}

            <div class="sidebar__footer">
                {{ ui.theme_toggle('btn sidebar__theme') }}
            </div>
        </aside>

        <div class="app__main">
            {# Narrow screens: sticky top bar. Hidden on wide screens. #}
            <header class="topbar">
                {{ ui.brand() }}
                {{ ui.theme_toggle('icon-btn', true) }}
                {% block topbar_actions %}{% endblock %}
            </header>

            <main id="main" class="page" tabindex="-1">
                {% block content %}{% endblock %}
            </main>

            <footer class="app-footer">
                <p>{{ 'footer.self_hosted'|trans }}</p>
            </footer>
        </div>
    </div>

    {# Narrow screens: bottom tab bar. Hidden on wide screens. #}
    <nav class="bottom-nav" aria-label="{{ 'nav.label'|trans }}">
        <ul class="bottom-nav__list">
            {% for item in nav_items %}
                <li>
                    <a class="bottom-nav__link" href="{{ url_for(item.route) }}"{% if current_nav == item.key %} aria-current="page"{% endif %}>
                        <span class="bottom-nav__icon">{{ ui.icon(item.icon) }}</span>
                        <span>{{ item.label|trans }}</span>
                    </a>
                </li>
            {% endfor %}
        </ul>
    </nav>
</body>
</html>
