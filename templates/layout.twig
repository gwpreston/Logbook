{% import 'macros/ui.twig' as ui %}
{#
 # App shell. Signed in: sidebar (wide) / top bar + bottom tab bar (narrow),
 # with the primary navigation. Signed out (setup, sign-in, error pages for
 # visitors): a slim top bar only.
 #
 # Primary navigation entries: route name, translation key, icon, and the
 # `active_nav` value that marks it current. Reminders and Reports are left
 # out when their module is switched off (spec.md §7.10). The bottom bar
 # shows the first four entries with the "+" (the Log entry chooser) in the
 # middle, as in the design; Settings is then reached from the top bar.
 #
 # Modal requests (View sets `modal`; spec.md §5) get only the page's
 # `modal_body` block, titled by its `heading`. A page without one is
 # rendered in full, and the script then opens it as a page.
 #}
{% set signed_in = user is not null %}
{% if modal|default(false) and block('modal_body') is defined %}
<div class="modal-fragment" data-modal-fragment data-modal-title="{{ heading|default(block('title')) }}">
    {{ block('modal_body') }}
</div>
{% else %}
{% set sidebar = signed_in ? sidebar(user) : null %}
{% set due_total = sidebar and sidebar.counts.enabled ? sidebar.counts.total() : 0 %}
{% set nav_items = [
    {route: 'home', label: 'nav.dashboard', icon: 'space_dashboard', key: 'home'},
    {route: 'garage', label: 'nav.garage', icon: 'garage', key: 'garage'},
] %}
{% if signed_in and feature_enabled('reminders') %}
    {% set nav_items = nav_items|merge([{route: 'reminders.index', label: 'nav.reminders', icon: 'notifications', key: 'reminders', badge: due_total}]) %}
{% endif %}
{% if signed_in and feature_enabled('reports') %}
    {% set nav_items = nav_items|merge([{route: 'reports.index', label: 'nav.reports', icon: 'bar_chart', key: 'reports'}]) %}
{% endif %}
{% set nav_items = nav_items|merge([{route: 'settings', label: 'nav.settings', icon: 'settings', key: 'settings'}]) %}
{% set bottom_items = nav_items|slice(0, 4) %}
{% set current_nav = active_nav|default('') %}
{# The vehicle whose pages are open, highlighted in the sidebar list. #}
{% set current_vehicle_id = current_nav == 'garage' ? (vehicle.id ?? null) : null %}
{% set theme = signed_in ? user.preferences.theme.value : null %}
{% set accent = signed_in ? user.preferences.accent.value : 'blue' %}
<!doctype html>
<html lang="{{ html_lang() }}" data-base="{{ base_path() }}" data-accent="{{ accent }}"{% if theme %} data-theme-pref="{{ theme }}"{% endif %}{% if theme and theme != 'system' %} data-theme="{{ theme }}"{% endif %}>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#f3f5f8" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#0a111c" media="(prefers-color-scheme: dark)">
    <title>{% block title %}{{ 'app.name'|trans }}{% endblock %}</title>
    <link rel="icon" type="image/png" href="{{ asset('images/logbook-mark.png') }}">
    <link rel="apple-touch-icon" href="{{ asset('images/apple-touch-icon.png') }}">
    <link rel="manifest" href="{{ url_for('pwa.manifest') }}">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="{{ 'app.name'|trans }}">
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    {# Sets data-theme before first paint; everything else is deferred. #}
    <script src="{{ asset('js/theme.js') }}"></script>
    {# Vendored libraries: progressive enhancement only; every core flow works without JS. #}
    <script defer src="{{ asset('vendor/sortable.min.js') }}"></script>
    <script defer src="{{ asset('vendor/chart.umd.min.js') }}"></script>
    <script defer src="{{ asset('js/file-drop.js') }}"></script>
    <script defer src="{{ asset('js/first-inspection.js') }}"></script>
    <script defer src="{{ asset('js/trip-form.js') }}"></script>
    <script defer src="{{ asset('js/app.js') }}"></script>
    <script defer src="{{ asset('vendor/alpine.min.js') }}"></script>
    {% block head %}{% endblock %}
</head>
<body>
    <a class="skip-link" href="#main">{{ 'nav.skip_to_content'|trans }}</a>

    <div class="app{{ signed_in ? '' : ' app--signed-out' }}">
        {% if signed_in %}
            {# Wide screens (>= 960px): sidebar. Hidden on narrow screens. #}
            <aside class="sidebar">
                {{ ui.brand() }}

                {% block primary_action %}
                    <a class="btn btn--primary btn--block" href="{{ url_for('log.chooser') }}" data-modal{% if current_nav == 'log' %} aria-current="page"{% endif %}>{{ ui.icon('add') }}{{ 'nav.log_entry'|trans }}</a>
                {% endblock %}

                <nav aria-label="{{ 'nav.label'|trans }}">
                    <ul class="nav-list">
                        {% for item in nav_items %}
                            <li>
                                <a class="nav-link" href="{{ url_for(item.route) }}"{% if current_nav == item.key %} aria-current="page"{% endif %}>
                                    {{ ui.icon(item.icon) }}
                                    <span class="nav-link__label">{{ item.label|trans }}</span>
                                    {% if item.badge|default(0) > 0 %}
                                        <span class="nav-link__badge" aria-hidden="true">{{ item.badge }}</span>
                                        <span class="visually-hidden">{{ 'nav.needs_attention'|trans({count: item.badge}) }}</span>
                                    {% endif %}
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                </nav>

                {% if sidebar.vehicles is not empty %}
                    <nav class="sidebar__section" aria-labelledby="sidebar-vehicles">
                        <h2 class="section-label" id="sidebar-vehicles">{{ 'nav.vehicles'|trans }}</h2>
                        <ul class="nav-list">
                            {% for listed in sidebar.vehicles %}
                                <li>
                                    <a class="nav-link nav-link--vehicle" href="{{ url_for('vehicles.show', {id: listed.id}) }}"{% if current_vehicle_id == listed.id %} aria-current="true"{% endif %}>
                                        {{ ui.icon(listed.data.type.icon()) }}
                                        <span class="nav-link__label">{{ listed.name() }}</span>
                                        {% if sidebar.counts.enabled %}{{ ui.status_dot(sidebar.counts.forVehicle(listed.id)) }}{% endif %}
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    </nav>
                {% endif %}

                {% block sidebar %}{% endblock %}

                <div class="sidebar__footer">
                    {{ ui.theme_toggle('btn sidebar__theme', false, true, csrf, current_path) }}
                    <div class="sidebar__account">
                        <span class="sidebar__user">{{ ui.icon('person') }}<span>{{ user.displayName }}</span></span>
                        <form method="post" action="{{ url_for('logout') }}">
                            {{ ui.csrf(csrf) }}
                            <button type="submit" class="btn btn--ghost sidebar__logout">{{ ui.icon('logout') }}{{ 'auth.sign_out'|trans }}</button>
                        </form>
                    </div>
                    <p class="sidebar__version" data-app-version>{{ 'app.version'|trans({version: app_version()}) }}</p>
                </div>
            </aside>
        {% endif %}

        <div class="app__main">
            {# Narrow screens (and signed-out pages): top bar. #}
            <header class="topbar">
                {{ ui.brand() }}
                {{ ui.theme_toggle('icon-btn', true, signed_in, csrf, current_path) }}
                {% if signed_in and 'settings' not in bottom_items|map(i => i.key) %}
                    <a class="icon-btn" href="{{ url_for('settings') }}"{% if current_nav == 'settings' %} aria-current="page"{% endif %}>{{ ui.icon('settings') }}<span class="visually-hidden">{{ 'nav.settings'|trans }}</span></a>
                {% endif %}
                {% block topbar_actions %}{% endblock %}
            </header>

            <main id="main" class="page" tabindex="-1">
                {% if flashes is not empty %}
                    <div class="flashes">{{ ui.flashes(flashes) }}</div>
                {% endif %}
                {% if signed_in and proxy and proxy.kind == 'link_offer' %}
                    {# Header sign-in (spec.md §7.9): a signed-in user meets an unlinked proxy account. #}
                    <div class="alert alert--info prompt-bar" role="status" data-proxy-link-offer>
                        {{ ui.icon('link') }}
                        <span>{{ 'proxy.link_offer'|trans({name: proxy.name}) }}</span>
                        <span class="prompt-bar__actions">
                            <form method="post" action="{{ url_for('proxy.link') }}">
                                {{ ui.csrf(csrf) }}
                                {{ ui.return_field(current_path) }}
                                <button type="submit" class="btn btn--primary btn--sm">{{ ui.icon('link') }}{{ 'proxy.link'|trans }}</button>
                            </form>
                        </span>
                    </div>
                {% endif %}
                {% if signed_in and feature_enabled('fuel') %}
                    {# Fill-ups saved offline, waiting to be sent (js/app.js; spec.md §7.15). #}
                    <section class="card outbox" data-offline-outbox hidden aria-labelledby="outbox-heading"
                             data-text-queued="{{ 'pwa.queued'|trans }}" data-text-waiting="{{ 'pwa.waiting'|trans }}"
                             data-text-pending="{{ 'pwa.pending'|trans }}" data-text-sent="{{ 'pwa.sent'|trans }}"
                             data-text-rejected="{{ 'pwa.rejected'|trans }}" data-text-review="{{ 'pwa.review'|trans }}"
                             data-text-discard="{{ 'pwa.discard'|trans }}" data-text-signed-out="{{ 'pwa.signed_out'|trans }}">
                        <h2 id="outbox-heading" class="card__title">{{ ui.icon('cloud_off') }}{{ 'pwa.outbox_title'|trans }}</h2>
                        <p data-outbox-status role="status"></p>
                        <ul class="outbox__list" data-outbox-list></ul>
                    </section>
                {% endif %}
                {% block content %}{% endblock %}
            </main>

            <footer class="app-footer">
                <p>{{ 'footer.self_hosted'|trans }}</p>
            </footer>
        </div>
    </div>

    {% if signed_in %}
        {# Narrow screens: bottom tab bar. Hidden on wide screens. #}
        <nav class="bottom-nav" aria-label="{{ 'nav.label'|trans }}">
            <ul class="bottom-nav__list">
                {% for item in bottom_items %}
                    {% if loop.index == 3 %}
                        <li>
                            <a class="bottom-nav__link bottom-nav__link--fab" href="{{ url_for('log.chooser') }}"{% if current_nav == 'log' %} aria-current="page"{% endif %}>
                                <span class="bottom-nav__icon">{{ ui.icon('add') }}</span>
                                <span class="visually-hidden">{{ 'nav.log_entry'|trans }}</span>
                            </a>
                        </li>
                    {% endif %}
                    <li>
                        <a class="bottom-nav__link" href="{{ url_for(item.route) }}"{% if current_nav == item.key %} aria-current="page"{% endif %}>
                            <span class="bottom-nav__icon">{{ ui.icon(item.icon) }}</span>
                            <span>{{ item.label|trans }}</span>
                            {% if item.badge|default(0) > 0 %}
                                <span class="bottom-nav__badge" aria-hidden="true">{{ item.badge }}</span>
                                <span class="visually-hidden">{{ 'nav.needs_attention'|trans({count: item.badge}) }}</span>
                            {% endif %}
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </nav>

        {# Desktop entry forms open here (js/app.js; spec.md §5). #}
        <dialog class="modal" data-modal-dialog aria-labelledby="modal-title">
            <div class="modal__header">
                <h2 class="modal__title" id="modal-title" data-modal-title></h2>
                <button type="button" class="icon-btn modal__close" data-modal-close>{{ ui.icon('close') }}<span class="visually-hidden">{{ 'modal.close'|trans }}</span></button>
            </div>
            <div class="modal__body" data-modal-body></div>
        </dialog>
    {% endif %}
</body>
</html>
{% endif %}
