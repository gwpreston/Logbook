{% extends 'layout.twig' %}
{% import 'macros/ui.twig' as ui %}

{% set active_nav = 'settings' %}

{% block title %}{{ 'backup.title'|trans }} · {{ parent() }}{% endblock %}

{% block content %}
    <div class="page__stack page__stack--narrow">
        <a class="back-link" href="{{ url_for('settings') }}">{{ ui.icon('chevron_left') }}{{ 'settings.title'|trans }}</a>

        <header class="page-header">
            <div>
                <h1 class="page-header__title">{{ 'backup.title'|trans }}</h1>
                <p class="page-header__lead">{{ 'backup.lead'|trans }}</p>
            </div>
        </header>

        {% if not available %}
            <div class="alert alert--warning" role="status">{{ ui.icon('warning') }}<span>{{ 'backup.unavailable'|trans }}</span></div>
        {% endif %}

        <section class="card" aria-labelledby="download-heading">
            <h2 id="download-heading" class="card__title">{{ 'backup.download_heading'|trans }}</h2>
            <p>{{ 'backup.download_intro'|trans }}</p>
            {% if available %}
                <div class="btn-row">
                    <a class="btn btn--primary" href="{{ url_for('backup.download') }}" download>{{ ui.icon('download') }}{{ 'backup.download'|trans }}</a>
                </div>
            {% endif %}
            <p class="field__hint">{{ 'backup.download_hint'|trans }}</p>
        </section>

        <section class="card" aria-labelledby="scheduled-heading" id="scheduled-backups">
            <h2 id="scheduled-heading" class="card__title">{{ 'backup.scheduled.heading'|trans }}</h2>
            {% if scheduled is empty %}
                <p class="muted">{{ 'backup.scheduled.none'|trans }}</p>
            {% else %}
                <ul class="list">
                    {% for file in scheduled %}
                        <li>
                            <a class="list__item" href="{{ url_for('backup.file', {name: file.name}) }}" download>
                                <span class="list__icon">{{ ui.icon('backup') }}</span>
                                <span class="list__body">
                                    <span class="list__title">{{ file.created_at|local_datetime }}</span>
                                    <span class="list__meta">{{ file.name }} · {{ file.size|file_size }}</span>
                                </span>
                                {{ ui.icon('download', 'list__trail') }}
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            {% endif %}
            {% if can_instance('run_jobs') %}
                <p class="field__hint"><a href="{{ url_for('settings.jobs') }}#job-backup">{{ 'backup.scheduled.settings_link'|trans }}</a></p>
            {% endif %}
        </section>

        {% if can_instance('restore') %}
        <section class="card" aria-labelledby="restore-heading">
            <h2 id="restore-heading" class="card__title">{{ 'backup.restore_heading'|trans }}</h2>
            <div class="alert alert--warning" role="note">{{ ui.icon('warning') }}<span>{{ 'backup.restore_warning'|trans }}</span></div>
            {% if error %}
                <div class="alert alert--error" role="alert" id="f-backup-error">{{ ui.icon('error') }}<span>{{ trans(error.key, error.params) }}</span></div>
            {% endif %}
            {% if available %}
                <form class="form" method="post" enctype="multipart/form-data" action="{{ url_for('backup.restore') }}">
                    {{ ui.csrf(csrf) }}
                    <div class="field">
                        <label class="field__label" for="f-backup">{{ 'backup.file'|trans }}</label>
                        {% set native %}<input class="input input--file" id="f-backup" name="backup" type="file" accept=".zip,application/zip" required aria-describedby="f-backup-hint{{ error ? ' f-backup-error' }}"{% if error %} aria-invalid="true"{% endif %}>{% endset %}
                        {{ ui.file_drop(native, {max_mb: max_restore_mb, type_message: 'not_zip'}) }}
                        <p class="field__hint" id="f-backup-hint">{{ 'backup.file_hint'|trans({max: max_restore_mb}) }}</p>
                    </div>
                    <div class="btn-row">
                        <button type="submit" class="btn">{{ ui.icon('upload_file') }}{{ 'backup.check'|trans }}</button>
                    </div>
                </form>
            {% endif %}
            <p class="field__hint">{{ 'backup.safety_note'|trans({path: backup_path}) }}</p>
        </section>
        {% endif %}

        <section class="card card--quiet" aria-labelledby="cli-heading">
            <h2 id="cli-heading" class="card__title">{{ 'backup.cli_heading'|trans }}</h2>
            <p>{{ 'backup.cli_intro'|trans }}</p>
            <pre class="code-block"><code>php bin/backup.php create
php bin/backup.php restore logbook-backup.zip --yes</code></pre>
        </section>
    </div>
{% endblock %}
