{% extends 'layout.twig' %}
{% import 'macros/ui.twig' as ui %}
{#
 # Restore, step 2: what the backup holds, and an explicit confirmation
 # (works without JS). Expects: manifest (Service\Backup\BackupManifest),
 # token, not_confirmed (posted without ticking the box).
 #}

{% set active_nav = 'settings' %}

{% block title %}{{ 'backup.confirm_title'|trans }} · {{ parent() }}{% endblock %}

{% block content %}
    <div class="page__stack page__stack--narrow">
        <a class="back-link" href="{{ url_for('backup.index') }}">{{ ui.icon('chevron_left') }}{{ 'backup.title'|trans }}</a>

        <section class="card" aria-labelledby="confirm-heading">
            <h1 id="confirm-heading" class="card__title card__title--lg">{{ 'backup.confirm_title'|trans }}</h1>
            <dl class="details details--compact">
                <div><dt>{{ 'backup.made'|trans }}</dt><dd>{{ manifest.createdAt|local_datetime }}</dd></div>
                <div><dt>{{ 'backup.version'|trans }}</dt><dd>{{ manifest.appVersion }}</dd></div>
                <div><dt>{{ 'backup.contents.users'|trans }}</dt><dd class="tabular">{{ manifest.rows('users')|number }}</dd></div>
                <div><dt>{{ 'backup.contents.vehicles'|trans }}</dt><dd class="tabular">{{ manifest.rows('vehicles')|number }}</dd></div>
                <div><dt>{{ 'backup.contents.fuel'|trans }}</dt><dd class="tabular">{{ manifest.rows('fuel_entries')|number }}</dd></div>
                <div><dt>{{ 'backup.contents.odometer'|trans }}</dt><dd class="tabular">{{ manifest.rows('odometer_readings')|number }}</dd></div>
                <div><dt>{{ 'backup.contents.maintenance'|trans }}</dt><dd class="tabular">{{ manifest.rows('maintenance_entries')|number }}</dd></div>
                <div><dt>{{ 'backup.contents.documents'|trans }}</dt><dd class="tabular">{{ manifest.rows('compliance_documents')|number }}</dd></div>
                <div><dt>{{ 'backup.contents.expenses'|trans }}</dt><dd class="tabular">{{ manifest.rows('expense_entries')|number }}</dd></div>
                <div><dt>{{ 'backup.contents.files'|trans }}</dt><dd class="tabular">{{ manifest.files|number }}</dd></div>
            </dl>

            <div class="alert alert--warning" role="note">{{ ui.icon('warning') }}<span>{{ 'backup.confirm_warning'|trans }}</span></div>
            {% if manifest.rows('api_keys') > 0 %}
                <div class="alert alert--info" role="note">{{ ui.icon('info') }}<span>{{ 'backup.api_keys_notice'|trans }}</span></div>
            {% endif %}

            <form class="form" method="post" action="{{ url_for('backup.restore.confirm', {token: token}) }}">
                {{ ui.csrf(csrf) }}
                {% if not_confirmed %}
                    <div class="alert alert--error" role="alert" id="f-confirm-error">{{ ui.icon('error') }}<span>{{ 'backup.confirm_required'|trans }}</span></div>
                {% endif %}
                <label class="toggle">
                    <input type="checkbox" name="confirm" value="1" required{% if not_confirmed %} aria-invalid="true" aria-describedby="f-confirm-error"{% endif %}>
                    <span class="toggle__text">
                        <span class="toggle__title">{{ 'backup.confirm_label'|trans }}</span>
                        <span class="toggle__hint">{{ 'backup.confirm_hint'|trans }}</span>
                    </span>
                </label>
                <div class="btn-row">
                    <button type="submit" class="btn btn--danger-solid">{{ ui.icon('history') }}{{ 'backup.restore'|trans }}</button>
                    <a class="btn btn--ghost" href="{{ url_for('backup.index') }}">{{ 'form.cancel'|trans }}</a>
                </div>
            </form>
        </section>
    </div>
{% endblock %}
