{% extends 'layout.twig' %}
{% import 'macros/ui.twig' as ui %}
{% import 'macros/tyres.twig' as tyres %}

{#
 # Edit a tyre's description (spec.md §7.17): never its state or position,
 # which change only through a tyre change.
 #}
{% set active_nav = 'garage' %}
{% set heading = 'tyre.edit_title'|trans %}
{% set season_options = [{value: '', label: 'tyre.field.season_none'|trans}]|merge(seasons|map(s => {value: s.value, label: ('tyre.season.' ~ s.value)|trans})) %}

{% block title %}{{ heading }} · {{ vehicle.name() }} · {{ parent() }}{% endblock %}

{% block content %}
    <div class="page__stack page__stack--narrow">
        <a class="back-link" href="{{ url_for('tyres.index', {id: vehicle.id}) }}">{{ ui.icon('chevron_left') }}{{ 'tyre.title'|trans }} · {{ vehicle.name() }}</a>

        <header class="page-header">
            <div>
                <p class="page-header__eyebrow">{{ vehicle.name() }} · {{ ('tyre.status.' ~ tyre.status.value)|trans }}{% if tyre.position %} · {{ ('tyre.position.' ~ tyre.position.value)|trans }}{% endif %}</p>
                <h1 class="page-header__title">{{ heading }}</h1>
            </div>
        </header>

        {% block modal_body %}
        {% if errors is not empty %}
            <div class="alert alert--error" role="alert">{{ ui.icon('error') }}<span>{{ 'form.has_errors'|trans }}</span></div>
        {% endif %}

        <form class="form" method="post" action="{{ url_for('tyres.edit', {id: vehicle.id, tyre: tyre.id}) }}">
            {{ ui.csrf(csrf) }}
            {{ ui.return_field(return_to) }}

            <section class="card">
                <div class="form-row">
                    {{ ui.input('brand', 'tyre.field.brand'|trans, values, errors, {optional: true, maxlength: 60}) }}
                    {{ ui.input('model', 'tyre.field.model'|trans, values, errors, {optional: true, maxlength: 60}) }}
                </div>
                <div class="form-row">
                    {{ ui.input('size', 'tyre.field.size'|trans, values, errors, {optional: true, maxlength: 30, hint: 'tyre.hint.size'|trans}) }}
                    {{ ui.select('season', 'tyre.field.season'|trans, values, errors, season_options) }}
                </div>
                {{ ui.input('dot', 'tyre.field.dot'|trans, values, errors, {optional: true, maxlength: 4, inputmode: 'numeric', placeholder: '2323', hint: 'tyre.hint.dot'|trans}) }}
                <div class="field">
                    <label class="field__label" for="f-notes">{{ 'tyre.field.notes'|trans }} <span class="field__optional">{{ 'form.optional'|trans }}</span></label>
                    <textarea class="textarea" id="f-notes" name="notes" rows="3" maxlength="500"{{ ui.described_by('notes', errors, false) }}>{{ values.notes ?? '' }}</textarea>
                    {{ ui.field_error(errors, 'notes') }}
                </div>
            </section>

            <div class="btn-row">
                <button type="submit" class="btn btn--primary btn--lg">{{ ui.icon('check_circle') }}{{ 'form.save'|trans }}</button>
                <a data-modal-cancel class="btn btn--lg" href="{{ return_to ?: url_for('tyres.index', {id: vehicle.id}) }}">{{ 'form.cancel'|trans }}</a>
                <a class="btn btn--lg btn--danger btn--push" href="{{ url_for('tyres.delete', {id: vehicle.id, tyre: tyre.id}) }}" data-modal>{{ ui.icon('delete') }}{{ 'form.delete'|trans }}</a>
            </div>
        </form>
        {% endblock %}
    </div>
{% endblock %}
