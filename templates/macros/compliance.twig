{#
 # Compliance fragments. Import with: {% import 'macros/compliance.twig' as docs %}
 #}

{# A document's name: its title, else its type. #}
{% macro name(document) -%}
    {{ document.data.title ?? ('compliance.type.' ~ document.data.type.value)|trans }}
{%- endmacro %}

{# Status pill for a Service\Compliance\DocumentState. #}
{% macro status_pill(state) -%}
    {% import 'macros/ui.twig' as ui %}
    {% set status = state.status.value %}
    {% set data = state.document.data %}
    <span class="pill{{ state.status.tone() ? ' pill--' ~ state.status.tone() }}">
        {%- if status == 'expired' -%}
            {{ ui.icon('warning') }}{{ 'compliance.status.expired'|trans({days: -state.daysLeft}) }}
        {%- elseif status == 'expiring' or status == 'valid' -%}
            {{ ('compliance.status.' ~ status)|trans({days: state.daysLeft}) }}
        {%- elseif status == 'upcoming' -%}
            {{ 'compliance.status.upcoming'|trans({date: data.startOn|local_date}) }}
        {%- else -%}
            {{ ('compliance.status.' ~ status)|trans }}
        {%- endif -%}
    </span>
{%- endmacro %}

{# The vehicle's first MOT before its first certificate (a
   Service\Compliance\FirstInspectionDue; spec.md §7.5), as a list row with
   the due badge rules of documents, linking to the edit form for those who
   may change it. #}
{% macro first_inspection_row(due, vehicle) -%}
    {% import 'macros/ui.twig' as ui %}
    {% set editable = can_vehicle(vehicle, 'manage') and not vehicle.isArchived() %}
    {% set status = due.status.value %}
    <li>
        {% if editable %}<a class="list__item" href="{{ url_for('vehicles.edit', {id: vehicle.id}) }}">{% else %}<div class="list__item">{% endif %}
            <span class="list__icon">{{ ui.icon('fact_check') }}</span>
            <span class="list__body">
                <span class="list__title">{{ 'compliance.first_inspection.title'|trans }}</span>
                <span class="list__meta">{{ 'compliance.first_inspection.due'|trans({date: due.dueOn|local_date}) }}</span>
            </span>
            <span class="list__end">
                <span class="pill{{ due.status.tone() ? ' pill--' ~ due.status.tone() }}">
                    {%- if status == 'overdue' -%}
                        {{ ui.icon('warning') }}{{ 'reminders.when.overdue'|trans({days: -due.daysLeft}) }}
                    {%- elseif status == 'due' -%}
                        {{ 'reminders.when.due_in'|trans({days: due.daysLeft}) }}
                    {%- else -%}
                        {{ 'reminders.status.upcoming'|trans }}
                    {%- endif -%}
                </span>
            </span>
        {% if editable %}</a>{% else %}</div>{% endif %}
    </li>
{%- endmacro %}

{# The validity period: "1 Mar 2026 – 28 Feb 2027", "Expires 28 Feb 2027", … #}
{% macro period(document) -%}
    {% set data = document.data %}
    {%- if data.startOn and data.expiryOn -%}
        {{ 'compliance.period.both'|trans({start: data.startOn|local_date, expiry: data.expiryOn|local_date}) }}
    {%- elseif data.expiryOn -%}
        {{ 'compliance.period.expiry'|trans({expiry: data.expiryOn|local_date}) }}
    {%- elseif data.startOn -%}
        {{ 'compliance.period.start'|trans({start: data.startOn|local_date}) }}
    {%- else -%}
        {{ 'compliance.period.none'|trans }}
    {%- endif -%}
{%- endmacro %}

{# One document (a DocumentState) as a card-like row: name and status, who
   issued it and its number, the period and cost, its files, and edit /
   renew actions. #}
{% macro row(state, vehicle, currency, attachments) -%}
    {% import 'macros/ui.twig' as ui %}
    {% import 'macros/attachments.twig' as files %}
    {% import _self as docs %}
    {% set document = state.document %}
    {% set data = document.data %}
    {% set editable = can_change(vehicle, document.createdBy) %}
    <li class="document">
        <div class="list__item">
            <span class="list__icon">{{ ui.icon(data.type.icon()) }}</span>
            <span class="list__body">
                {% if editable %}
                    <a class="list__title" href="{{ url_for('compliance.edit', {id: vehicle.id, document: document.id}) }}" data-modal>{{ docs.name(document) }}</a>
                {% else %}
                    <span class="list__title">{{ docs.name(document) }}</span>
                {% endif %}
                {% if data.title %}<span class="list__meta">{{ ('compliance.type.' ~ data.type.value)|trans }}</span>{% endif %}
                {% if data.provider or data.reference %}
                    <span class="list__meta">
                        {{- data.provider ?? '' }}{% if data.provider and data.reference %} · {% endif %}{% if data.reference %}<span class="tabular">{{ data.reference }}</span>{% endif -%}
                    </span>
                {% endif %}
                <span class="list__meta">{{ docs.period(document) }}
                    {%- if data.odometerKm is not null %} · <span class="tabular">{{ 'compliance.odometer_shown'|trans({reading: data.odometerKm|distance}) }}</span>{% endif -%}
                </span>
                {{ ui.added_by(vehicle, document.createdBy) }}
            </span>
            <span class="list__end">
                {{ docs.status_pill(state) }}
                {{ files.count(attachments) }}
                {% if data.cost != '0.000' and can_see_amount(vehicle, document.createdBy) %}<span class="list__amount tabular">{{ data.cost|money(currency) }}</span>{% endif %}
            </span>
        </div>
        {% if attachments is not empty %}
            <ul class="attachment-list attachment-list--inset">
                {% for attachment in attachments %}
                    {{ files.item(vehicle, attachment, false) }}
                {% endfor %}
            </ul>
        {% endif %}
        {% if not vehicle.isArchived() and can_vehicle(vehicle, 'log') %}
            <div class="btn-row document__actions">
                {% if editable %}
                    <a class="btn btn--soft" href="{{ url_for('compliance.edit', {id: vehicle.id, document: document.id}) }}" data-modal>{{ ui.icon('edit') }}{{ 'form.edit'|trans }}<span class="visually-hidden">: {{ docs.name(document) }}</span></a>
                {% endif %}
                {% if data.type.isSuperseded() and state.status.value in ['expired', 'expiring', 'valid'] %}
                    <a class="btn btn--soft" href="{{ url_for('compliance.create', {id: vehicle.id}, {type: data.type.value}) }}" data-modal>{{ ui.icon('event_repeat') }}{{ 'compliance.renew'|trans }}<span class="visually-hidden">: {{ docs.name(document) }}</span></a>
                {% endif %}
            </div>
        {% endif %}
    </li>
{%- endmacro %}
