{#
 # Tyre fragments (spec.md §7.17). Import with:
 # {% import 'macros/tyres.twig' as tyres %}
 #}

{# "Michelin Primacy 4", else the size, else "a tyre" (as messages name it). #}
{% macro name(tyre) -%}
    {%- set name = tyre.data.name() -%}
    {{- name != '' ? name : (tyre.data.size ?? 'tyre.unnamed'|trans) -}}
{%- endmacro %}

{# The season badge; nothing when not specified. #}
{% macro season(tyre) -%}
    {%- if tyre.data.season %}<span class="pill tyre-season tyre-season--{{ tyre.data.season.value }}">{{ ('tyre.season.' ~ tyre.data.season.value)|trans }}</span>{% endif -%}
{%- endmacro %}

{# "3 yrs 4 mo" from the DOT date, or "Age not known". #}
{% macro age(view) -%}
    {%- if view.age -%}
        {{- 'tyre.age'|trans({age: view.age.labelKey()|trans({years: view.age.years, months: view.age.months})}) -}}
    {%- else -%}
        {{- 'tyre.age_unknown'|trans -}}
    {%- endif -%}
{%- endmacro %}

{# "12,400 mi", or "12,400 mi since 3 Oct 2026" when counted from the tyres already on the vehicle. #}
{% macro distance(view) -%}
    {%- if view.since -%}
        {{- 'tyre.since'|trans({distance: view.distance.km|distance, date: view.since|local_date}) -}}
    {%- else -%}
        {{- view.distance.km|distance -}}
    {%- endif -%}
    {%- if view.distance.flagged %} <span class="tyre-flag" title="{{ 'tyre.flag_label'|trans }}">{% import 'macros/ui.twig' as ui %}{{ ui.icon('warning') }}<span class="visually-hidden">{{ 'tyre.flag_label'|trans }}</span></span>{% endif -%}
{%- endmacro %}

{# "4.2 mm on 3 Jun 2026": the latest measured depth, or nothing. #}
{% macro latest_depth(view) -%}
    {%- if view.wear.latest -%}
        {{- 'tyre.depth.measured'|trans({depth: view.wear.latest.treadMm|depth, date: view.wear.latest.doneOn|local_date}) -}}
    {%- endif -%}
{%- endmacro %}

{# "about 3.4 mm now · about 6,000 mi left · around Mar 2027": always an estimate; nothing when not known. #}
{% macro estimate(view) -%}
    {%- set wear = view.wear -%}
    {%- if wear.isKnown() -%}
        {%- set parts = ['tyre.wear.depth_now'|trans({depth: wear.depthNowMm|depth}), 'tyre.wear.left'|trans({distance: wear.kmLeft|about_distance})] -%}
        {%- if wear.wearOutOn %}{% set parts = parts|merge(['tyre.wear.around'|trans({month: wear.wearOutOn|local_month})]) %}{% endif -%}
        {{- parts|join(' · ') -}}
    {%- endif -%}
{%- endmacro %}

{#
 # A tyre's flags (spec.md §7.17): due or overdue for wear or age, and the
 # legal minimum, measured or estimated. Status colours, never colour alone:
 # each has an icon and its words.
 #}
{% macro standing_flag(standing, view) -%}
    {% import 'macros/ui.twig' as ui %}
    {%- if standing and standing.status.value in ['overdue', 'soon'] -%}
        <span class="pill pill--{{ standing.status.tone() }}">{{ ui.icon('warning') }}{{ ('tyre.flag.' ~ standing.reason ~ '_' ~ standing.status.value)|trans }}</span>
    {%- endif -%}
    {%- if view.wear.legal -%}
        <span class="pill pill--overdue">{{ ui.icon('error') }}{{ ('tyre.flag.legal_' ~ view.wear.legal.value)|trans }}</span>
    {%- endif -%}
{%- endmacro %}

{# The tab's badge: the tyres judged as one, as the tyre reminder judges them. #}
{% macro verdict_badge(verdict) -%}
    {% import 'macros/ui.twig' as ui %}
    {%- if verdict.isJudgeable() -%}
        <span class="pill{{ verdict.status.tone() ? ' pill--' ~ verdict.status.tone() }}" data-testid="tyre-verdict">
            {%- if verdict.status.value != 'ok' %}{{ ui.icon('warning') }}{% endif -%}
            {{- ('tyre.verdict.' ~ verdict.status.value)|trans -}}
        </span>
    {%- endif -%}
{%- endmacro %}

{#
 # One position of the Current tyres grid (spec.md §7.17, Phase 33.3): the
 # position and its pill, the latest measured depth (never an assumed one),
 # the tread bar once there are two measurements, the tyre, then when it was
 # fitted, the distance and the estimate. Plain HTML, reads well to a screen
 # reader: the bar is decorative, the depth says it in words.
 #}
{% macro position_card(position, view, vehicle, flags = []) -%}
    {% import _self as tyres %}
    {% import 'macros/ui.twig' as ui %}
    <article class="tyre-card{{ view ? '' : ' tyre-card--empty' }}{{ position.value == 'spare' ? ' tyre-card--spare' }}" aria-labelledby="tyre-pos-{{ position.value }}">
        <div class="tyre-card__head">
            <h3 class="tyre-card__position" id="tyre-pos-{{ position.value }}">{{ ('tyre.position.' ~ position.value)|trans }}</h3>
            {% if not view %}
                <span class="pill">{{ 'tyre.empty_position'|trans }}</span>
            {% elseif flags is not empty %}
                {% set top = flags|first %}
                <span class="pill pill--{{ top.tone }}" data-testid="tyre-pill">{{ ui.icon(top.icon) }}{{ ('tyre.flag.' ~ top.key)|trans }}</span>
            {% endif %}
        </div>
        {% if view %}
            {% set tyre = view.tyre %}
            {% set wear = view.wear %}
            {% set tone = flags is not empty ? (flags|first).tone : '' %}
            {% if wear.latest %}
                <p class="tyre-card__depth{{ tone ? ' tyre-card__depth--' ~ tone }}">
                    <span class="visually-hidden">{{ 'tyre.field.tread'|trans }}: </span><span class="tyre-card__depth-value tabular">{{ wear.latest.treadMm|depth }}</span>
                    <span class="tyre-card__checked">{{ 'tyre.checked'|trans({date: wear.latest.doneOn|local_date}) }}</span>
                </p>
                {% set fill = wear.barPercent() %}
                {% if fill is not null %}
                    <span class="bar tyre-card__bar{{ tone ? ' tyre-card__bar--' ~ tone }}" aria-hidden="true" data-testid="tyre-bar">{% if fill > 0 %}<span class="bar__fill" style="--w: {{ fill }}%"></span>{% endif %}</span>
                {% endif %}
            {% else %}
                <p class="tyre-card__depth tyre-card__depth--none muted">{{ 'tyre.not_measured'|trans }}</p>
            {% endif %}
            <div class="tyre-card__tyre">
                <p class="tyre-card__name">
                    {%- if vehicle.isArchived() -%}
                        {{ tyres.name(tyre) }}
                    {%- else -%}
                        <a href="{{ url_for('tyres.edit', {id: vehicle.id, tyre: tyre.id}) }}" data-modal>{{ tyres.name(tyre) }}</a>
                    {%- endif %}
                    {{ tyres.season(tyre) }}
                </p>
                <p class="tyre-card__meta">
                    {%- if tyre.data.size %}<span class="tabular">{{ tyre.data.size }}</span> · {% endif -%}
                    {{ tyres.age(view) }}
                </p>
            </div>
            <div class="tyre-card__foot">
                <p class="tabular">
                    {#- "Fitted" (the first fitting) with the tyre's whole distance; "since" for a tyre recorded as already on. -#}
                    {%- if view.fittedOn -%}
                        {{ 'tyre.fitted_on'|trans({month: view.fittedOn|local_month}) }} · {{ 'tyre.covered'|trans({distance: view.distance.km|distance}) }}
                    {%- elseif view.since -%}
                        {{ 'tyre.covered_since'|trans({distance: view.distance.km|distance, date: view.since|local_date}) }}
                    {%- else -%}
                        {{ 'tyre.covered'|trans({distance: view.distance.km|distance}) }}
                    {%- endif -%}
                    {%- if view.distance.flagged %} <span class="tyre-flag" title="{{ 'tyre.flag_label'|trans }}">{{ ui.icon('warning') }}<span class="visually-hidden">{{ 'tyre.flag_label'|trans }}</span></span>{% endif -%}
                </p>
                {% if wear.isKnown() %}
                    <p class="tyre-card__estimate"><span class="visually-hidden">{{ 'tyre.field.estimate'|trans }}: </span>{{ tyres.estimate(view) }}</p>
                {% endif %}
                {% if flags|length > 1 %}
                    <p class="tyre-card__flags">
                        {%- for flag in flags|slice(1) -%}
                            <span class="pill pill--{{ flag.tone }}">{{ ui.icon(flag.icon) }}{{ ('tyre.flag.' ~ flag.key)|trans }}</span>
                        {%- endfor -%}
                    </p>
                {% endif %}
            </div>
        {% endif %}
    </article>
{%- endmacro %}

{# A stored or retired tyre as a list row. #}
{% macro tyre_row(view, vehicle, currency, standing = null) -%}
    {% import 'macros/ui.twig' as ui %}
    {% import _self as tyres %}
    {% set tyre = view.tyre %}
    <li class="list__item">
        <span class="list__icon" style="--tone: var(--c-maint)">{{ ui.icon('tire_repair') }}</span>
        <span class="list__body">
            <span class="list__title">
                {%- if vehicle.isArchived() -%}
                    {{ tyres.name(tyre) }}
                {%- else -%}
                    <a href="{{ url_for('tyres.edit', {id: vehicle.id, tyre: tyre.id}) }}" data-modal>{{ tyres.name(tyre) }}</a>
                {%- endif %}
                {{ tyres.season(tyre) }}
            </span>
            <span class="list__meta">
                {%- set parts = [] -%}
                {%- if tyre.data.size %}{% set parts = parts|merge([tyre.data.size]) %}{% endif -%}
                {%- if tyre.isRetired() and view.retiredOn %}{% set parts = parts|merge(['tyre.retired_on'|trans({date: view.retiredOn|local_date})]) %}{% endif -%}
                {%- if tyre.isRetired() and tyre.retiredReason %}{% set parts = parts|merge([('tyre.reason.' ~ tyre.retiredReason.value)|trans]) %}{% endif -%}
                {%- set parts = parts|merge([tyres.age(view)]) -%}
                {%- if view.wear.latest %}{% set parts = parts|merge([tyres.latest_depth(view)]) %}{% endif -%}
                {{- parts|join(' · ') -}}
            </span>
            {% if not tyre.isRetired() %}{{ tyres.standing_flag(standing, view) }}{% endif %}
        </span>
        <span class="list__end">
            <span class="list__delta tabular">{{ tyre.isRetired() and not view.since ? 'tyre.lifetime'|trans({distance: view.distance.km|distance}) : tyres.distance(view) }}</span>
            {% if view.costPerKm is not null and can_see_costs(vehicle) %}<span class="list__amount tabular">{{ view.costPerKm|per_thousand_distance(currency) }}</span>{% endif %}
        </span>
    </li>
{%- endmacro %}

{# A tyre change as a list row: kind, summary, odometer and the linked record's cost. #}
{% macro change_row(item, vehicle, currency, return_to = null) -%}
    {% import 'macros/ui.twig' as ui %}
    {% set change = item.change %}
    <li class="list__item">
        <span class="list__icon" style="--tone: var(--c-maint)">{{ ui.icon(change.kind.icon()) }}</span>
        <span class="list__body">
            <span class="list__title">
                {%- if can_change(vehicle, change.createdBy) -%}
                    <a href="{{ url_for('tyres.changes.edit', {id: vehicle.id, change: change.id}, return_to ? {return: return_to} : {}) }}" data-modal>{{ ('tyre.kind_short.' ~ change.kind.value)|trans }}</a>
                {%- else -%}
                    {{ ('tyre.kind_short.' ~ change.kind.value)|trans }}
                {%- endif -%}
            </span>
            <span class="list__meta"><time datetime="{{ change.data.doneOn|date('Y-m-d', 'UTC') }}">{{ change.data.doneOn|local_date }}</time> · {{ trans(item.summary.message, item.summary.parameters) }}</span>
            {{ ui.added_by(vehicle, change.createdBy) }}
        </span>
        <span class="list__end">
            {% if change.data.odometerKm is not null %}<span class="list__delta tabular">{{ change.data.odometerKm|distance }}</span>{% endif %}
            {% if item.record and can_see_amount(vehicle, item.record.createdBy) %}
                <a class="list__amount tabular" href="{{ url_for('maintenance.edit', {id: vehicle.id, entry: item.record.id}) }}" data-modal title="{{ 'tyre.record'|trans }}: {{ item.record.data.title }}">{{ item.record.data.cost|money(currency) }}</a>
            {% endif %}
        </span>
    </li>
{%- endmacro %}

{# The tyre changes a vehicle can record, for the toolbar menu. #}
{% macro change_links(vehicle, kinds, except = []) -%}
    {% import 'macros/ui.twig' as ui %}
    <ul class="menu__list">
        {% for kind in kinds|filter(k => k.value not in except) %}
            <li><a class="menu__item" href="{{ url_for('tyres.change', {id: vehicle.id, kind: kind.value}) }}" data-modal>{{ ui.icon(kind.icon()) }}{{ ('tyre.kind.' ~ kind.value)|trans }}</a></li>
        {% endfor %}
    </ul>
{%- endmacro %}
