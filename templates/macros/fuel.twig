{#
 # Fuel fragments. Import with: {% import 'macros/fuel.twig' as fuel_ui %}
 #}

{# The pump / charger style badge of a fill-up's grade (spec.md §8): a
   shape per family plus the short label; the full label is its accessible
   name. LPG has no grades but still gets its rhombus; no grade recorded (or
   another fuel) shows nothing. #}
{% macro badge(fuel, grade) -%}
    {% set shape = fuel.badgeShape() %}
    {% if shape and (grade or fuel.value == 'lpg') %}
        {% set short = grade ? grade.shortLabelKey()|trans : ('fuel.fuel.' ~ fuel.value)|trans %}
        {% set long = grade ? grade.labelKey()|trans : ('fuel.fuel.' ~ fuel.value)|trans %}
        <span class="grade-badge grade-badge--{{ shape }}" title="{{ long }}">
            <span class="grade-badge__shape" aria-hidden="true"></span>
            <span class="grade-badge__text" aria-hidden="true">{{ short }}</span>
            <span class="visually-hidden">{{ long }}</span>
        </span>
    {%- endif %}
{%- endmacro %}

{# The Fuel tab's *By grade* card (a Service\Fuel\GradeBreakdown, spec.md
   §7.3). Liquid fuel: fills, volume, average price and — with at least two
   segments burned on one grade — an indicative economy. Electricity: share
   of energy and cost per kWh per charging type, then the blended cost. #}
{% macro grade_card(breakdown, currency, electric, verdicts = []) -%}
    {% import _self as fuel_ui %}
    {% set dash = '—' %}
    {% set title = (electric ? 'fuel.grades.title_ev' : 'fuel.grades.title')|trans %}
    <section class="card" aria-labelledby="grades-{{ breakdown.kind.value }}">
        <h3 id="grades-{{ breakdown.kind.value }}" class="card__title">{{ title }}</h3>
        <div class="table-wrap">
            <table class="table">
                <caption class="visually-hidden">{{ title }}</caption>
                <thead>
                    <tr>
                        <th scope="col">{{ (electric ? 'fuel.grades.column.type' : 'fuel.grades.column.grade')|trans }}</th>
                        {% if electric %}
                            <th scope="col" class="table__num">{{ 'fuel.grades.column.share'|trans }}</th>
                            <th scope="col" class="table__num">{{ 'fuel.grades.column.cost_per_kwh'|trans }}</th>
                            <th scope="col" class="table__num">{{ 'fuel.grades.column.per_distance'|trans({unit: prefs().distanceUnit.value}) }}</th>
                            <th scope="col" class="table__num">{{ 'fuel.grades.column.energy'|trans }}</th>
                        {% else %}
                            <th scope="col" class="table__num">{{ 'fuel.grades.column.fills'|trans }}</th>
                            <th scope="col" class="table__num">{{ 'fuel.grades.column.volume'|trans }}</th>
                            <th scope="col" class="table__num">{{ 'fuel.grades.column.price'|trans }}</th>
                        {% endif %}
                        <th scope="col" class="table__num">{{ (electric ? 'fuel.grades.column.efficiency' : 'fuel.grades.column.economy')|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in breakdown.rows %}
                        {% set price = row.averagePricePerUnit() %}
                        <tr>
                            <th scope="row">
                                {%- if row.grade -%}
                                    {{ fuel_ui.badge(row.grade.family(), row.grade) }}
                                {%- else -%}
                                    <span class="muted">{{ 'fuel.grade_not_recorded'|trans }}</span>
                                {%- endif -%}
                            </th>
                            {% if electric %}
                                <td class="table__num tabular">{{ 'fuel.grades.share'|trans({share: row.share()}) }}</td>
                                <td class="table__num tabular">{{ price is null ? dash : price|unit_price(currency, true) }}</td>
                                {% set per_km = breakdown.costPerKm(row) %}
                                <td class="table__num tabular">{{ per_km is null ? dash : per_km|per_distance(currency) }}</td>
                                <td class="table__num tabular">{{ row.volume|quantity(true, 0) }}</td>
                            {% else %}
                                <td class="table__num tabular">{{ row.fills|number }}</td>
                                <td class="table__num tabular">{{ row.volume|quantity(false, 0) }}</td>
                                <td class="table__num tabular">{{ price is null ? dash : price|unit_price(currency, false) }}</td>
                            {% endif %}
                            <td class="table__num table__note tabular">
                                {%- if row.hasEconomy() -%}
                                    {{ row.measuredDistanceKm|economy(row.measuredVolume, electric) }}
                                {%- elseif row.grade -%}
                                    <span class="muted">{{ 'fuel.grades.not_enough'|trans }}</span>
                                {%- else -%}
                                    {{ dash }}
                                {%- endif -%}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
                {% if electric and breakdown.blendedPricePerUnit() is not null %}
                    <tfoot>
                        <tr>
                            <th scope="row">{{ 'fuel.grades.blended'|trans }}</th>
                            <td class="table__num tabular">{{ 'fuel.grades.share'|trans({share: 1}) }}</td>
                            <td class="table__num tabular"><strong>{{ breakdown.blendedPricePerUnit()|unit_price(currency, true) }}</strong></td>
                            {% set blended_per_km = breakdown.blendedCostPerKm() %}
                            <td class="table__num tabular">{{ blended_per_km is null ? dash : blended_per_km|per_distance(currency) }}</td>
                            <td class="table__num tabular">{{ breakdown.totalVolume|quantity(true, 0) }}</td>
                            <td></td>
                        </tr>
                    </tfoot>
                {% endif %}
            </table>
        </div>
        {% set compared = verdicts|filter(v => v.status.value != 'single_grade') %}
        {% if compared is not empty %}
            <h4 class="grade-verdicts__title">{{ 'fuel.verdict.title'|trans }}</h4>
            <ul class="grade-verdicts">
                {% for verdict in compared %}
                    {% set grade = verdict.grade.shortLabelKey()|trans %}
                    {% set reference = verdict.reference.shortLabelKey()|trans %}
                    <li>
                        {% if verdict.isOk() %}
                            {% set cost = verdict.cost() %}
                            {% set price = verdict.price() %}
                            {% set used = verdict.fuelUsed() %}
                            <p><strong>{{ 'fuel.verdict.cost'|trans({grade: grade, reference: reference, direction: cost.direction, percent: cost.fraction(), unit: prefs().distanceUnit.value}) }}</strong></p>
                            <p class="tabular">{{ 'fuel.verdict.parts'|trans({price: price.direction, price_percent: price.fraction(), volume: prefs().volumeUnit.value, used: used.direction, used_percent: used.fraction()}) }}</p>
                            <p class="field__hint">{{ 'fuel.verdict.basis'|trans({grade: grade, reference: reference, grade_tanks: verdict.gradeSegments, reference_tanks: verdict.referenceSegments, pairs: verdict.pairs}) }}</p>
                        {% elseif verdict.status.value == 'not_enough_economy' %}
                            <p>{{ 'fuel.verdict.not_enough_economy'|trans({grade: grade, reference: reference}) }}</p>
                        {% else %}
                            <p>{{ 'fuel.verdict.not_enough_prices'|trans({grade: grade, reference: reference}) }}</p>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        {% endif %}
        <p class="field__hint">{{ 'fuel.grades.hint'|trans }}</p>
    </section>
{%- endmacro %}

{# The economy check's short mark beside a fill-up's economy (a
   Service\Fuel\SegmentCheck, spec.md §7.3): an icon and text, never colour
   alone. Shows nothing for a segment that is normal or not checked. #}
{% macro check_mark(check) -%}
    {% import 'macros/ui.twig' as ui %}
    {% if check and check.isFlagged() %}
        <span class="economy-check economy-check--flag">{{ ui.icon('warning') }}{{ ('fuel.check.short.' ~ check.verdict.value)|trans }}</span>
    {%- elseif check and check.isConfirmedFlag() %}
        <span class="economy-check economy-check--confirmed">{{ ui.icon('check') }}{{ 'fuel.check.short.confirmed'|trans }}</span>
    {%- endif %}
{%- endmacro %}

{# The full economy check of a flagged (or confirmed) segment: how far from
   usual in fuel used, the likely cause (or the pair's shared fill-up), links
   to the fill-ups to check and the *Looks right* / *Undo* form. Nothing is
   changed for the owner but the confirmation. opts: id (for
   aria-describedby), csrf, return_to, on_edit (hides "Edit this fill-up"). #}
{% macro check_flag(check, vehicle, opts = {}) -%}
    {% import 'macros/ui.twig' as ui %}
    {% set fill = check.fill %}
    {% set entry = fill.entry %}
    {% set electric = entry.data.fuel.isElectric() %}
    {% set other = check.otherEntry() %}
    {% set params = {
        percent: check.difference()|percent,
        economy: fill.segment.distanceKm|economy(fill.segment.volume, electric),
        usual: '100'|economy(check.baseline, electric),
    } %}
    <div class="economy-check__body"{% if opts.id ?? null %} id="{{ opts.id }}"{% endif %}>
        {% if check.isFlagged() %}
            <p class="economy-check__headline">{{ ui.icon('warning') }}<span>{{ ('fuel.check.' ~ check.verdict.value)|trans(params) }}</span></p>
            {% if check.pairShared %}
                <p>{{ (check.pairNormal ? 'fuel.check.pair_normal' : 'fuel.check.pair')|trans({date: check.pairShared.data.filledAt|instant_date}) }}</p>
            {% else %}
                <p>{{ ('fuel.check.hint.' ~ check.verdict.value)|trans }}</p>
            {% endif %}
        {% else %}
            <p class="economy-check__headline">{{ ui.icon('check') }}<span>{{ 'fuel.check.confirmed_note'|trans(params) }}</span></p>
        {% endif %}
        <div class="economy-check__actions">
            {% if check.isFlagged() %}
                {% if not (opts.on_edit ?? false) %}
                    <a class="btn btn--sm" href="{{ url_for('fuel.edit', {id: vehicle.id, entry: entry.id}) }}" data-modal>{{ ui.icon('edit') }}{{ 'fuel.check.edit_this'|trans }}</a>
                {% endif %}
                {% if other %}
                    <a class="btn btn--sm" href="{{ url_for('fuel.edit', {id: vehicle.id, entry: other.id}) }}" data-modal>{{ ui.icon('edit') }}{{ 'fuel.check.edit_other'|trans({date: other.data.filledAt|instant_date}) }}</a>
                {% endif %}
            {% endif %}
            <form method="post" action="{{ url_for('fuel.economy', {id: vehicle.id, entry: entry.id}) }}">
                {{ ui.csrf(opts.csrf ?? null) }}
                {{ ui.return_field(opts.return_to ?? '') }}
                {% if check.isFlagged() %}
                    <button type="submit" class="btn btn--sm btn--soft">{{ ui.icon('check') }}{{ 'fuel.check.looks_right'|trans }}</button>
                {% else %}
                    <input type="hidden" name="undo" value="1">
                    <button type="submit" class="btn btn--sm">{{ ui.icon('undo') }}{{ 'fuel.check.undo'|trans }}</button>
                {% endif %}
            </form>
        </div>
    </div>
{%- endmacro %}

{# One fill-up (a Service\Fuel\FillEconomy) as a list row linking to its edit
   page: when, odometer · volume · price, total, and the economy of the
   full-to-full segment it closes (or why there is none). A flagged or
   confirmed economy check (opts.check) adds its mark beside the economy and
   the full check in a disclosure under the row (a sibling of the link, so
   its links and form are reachable from the keyboard; works without JS).
   opts: check, csrf, return_to. #}
{% macro row(fill, vehicle, currency, files = 0, opts = {}) -%}
    {% import 'macros/ui.twig' as ui %}
    {% import 'macros/attachments.twig' as paperclip %}
    {% import _self as fuel_ui %}
    {% set data = fill.entry.data %}
    {% set electric = data.fuel.isElectric() %}
    {% set status = fill.status.value %}
    {% set check = opts.check ?? null %}
    {% set shown = check and (check.isFlagged() or check.isConfirmedFlag()) %}
    {% set check_id = 'check-' ~ fill.entry.id %}
    <li{% if shown %} class="list__group"{% endif %}>
        <a class="list__item" href="{{ url_for('fuel.edit', {id: vehicle.id, entry: fill.entry.id}) }}" data-modal>
            <span class="list__icon">{{ ui.icon(electric ? 'ev_station' : 'local_gas_station') }}</span>
            <span class="list__body">
                <span class="list__title">{{ data.filledAt|local_datetime }} {{ fuel_ui.badge(data.fuel, data.grade) }}</span>
                <span class="list__meta tabular">
                    {{- data.odometerKm|distance }} · {{ data.volume|quantity(electric) }} · {{ data.pricePerUnit|unit_price(currency, electric) -}}
                    {%- if data.station %} · {{ data.station }}{% endif -%}
                </span>
                {% if fill.followsGap() %}
                    <span class="list__meta list__meta--note">{{ ui.icon('info') }}{{ 'fuel.status.after_gap'|trans }}</span>
                {% endif %}
            </span>
            <span class="list__end">
                <span class="list__amount tabular">{{ data.totalCost|money(currency) }}</span>
                {% if fill.segment %}
                    <span class="economy tabular"{% if shown %} aria-describedby="{{ check_id }}"{% endif %}>{{ fill.segment.distanceKm|economy(fill.segment.volume, electric) }}</span>
                    {% if shown %}{{ fuel_ui.check_mark(check) }}{% endif %}
                {% else %}
                    <span class="economy economy--none">{{ ('fuel.status.' ~ status ~ (electric ? '_ev' : ''))|trans }}</span>
                {% endif %}
                {{ paperclip.count(files) }}
            </span>
        </a>
        {% if shown %}
            <details class="economy-check__details"{% if opts.open ?? false %} open{% endif %}>
                <summary>{{ (check.isFlagged() ? 'fuel.check.what_to_check' : 'fuel.check.checked_summary')|trans }}</summary>
                {{ fuel_ui.check_flag(check, vehicle, {id: check_id, csrf: opts.csrf ?? null, return_to: opts.return_to ?? ''}) }}
            </details>
        {% endif %}
    </li>
{%- endmacro %}
