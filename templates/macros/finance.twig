{#
 # Finance agreement fragments (spec.md §7.32). Import with:
 # {% import 'macros/finance.twig' as fin %}
 #}

{# "PCP · Toyota Financial Services" #}
{% macro name(agreement) -%}
    {{ agreement.type().labelKey()|trans }} · {{ agreement.data.lender }}
{%- endmacro %}

{# The status pill: active, or how it ended. #}
{% macro status(agreement) -%}
    <span class="pill{{ agreement.status.value == 'active' ? ' pill--valid' : '' }}">{{ agreement.status.labelKey()|trans }}</span>
{%- endmacro %}

{# "18 of 48 payments remaining", with the optional final payment beside. #}
{% macro remaining(figures) -%}
    {{- 'finance.payments_remaining'|trans({remaining: figures.schedule.remaining(), total: figures.schedule.numberOfPayments}) -}}
    {%- if figures.optionalFinal %} {{ 'finance.plus_optional_final'|trans({amount: figures.optionalFinal.amount|money(figures.remainingToPay.currency)}) }}{% endif -%}
{%- endmacro %}

{# The settlement: the lender's quote while valid, else the labelled estimate. #}
{% macro settlement(settlement) -%}
    {%- if settlement.quote -%}
        {{ 'finance.settlement_quoted'|trans({amount: settlement.amount|money, quoted: settlement.quote.quotedOn|local_date, until: settlement.quote.validUntil|local_date}) }}
    {%- else -%}
        <span class="tabular">{{ settlement.amount|money }}</span> <span class="pill pill--soon">{{ 'finance.estimate'|trans }}</span>
    {%- endif -%}
{%- endmacro %}

{# "Positive equity £2,140" / "Negative equity £1,380". #}
{% macro equity(equity) -%}
    {{ (equity.isPositive() ? 'finance.equity_positive' : 'finance.equity_negative')|trans({amount: equity.magnitude()|money}) }}
{%- endmacro %}

{# The mileage position in the agreement's unit (spec.md §7.32 *Mileage*):
   "On track for 31,200 mi against 30,000. About £108 in excess mileage at
   £0.09 a mile.", "On track to finish 2,400 mi under the allowance.", or
   the distance so far without a projection. #}
{% macro mileage(position, currency) -%}
    {%- set unit = position.unit -%}
    {%- if position.projectedKm is not null and position.isOver() -%}
        {%- set sentence = 'finance.mileage.over'|trans({projected: position.projectedKm|about_distance(unit), allowance: position.allowanceKm|distance(0, unit)}) -%}
        {{ sentence }}
        {%- if position.excessCharge %} {{ 'finance.mileage.charge'|trans({charge: position.excessCharge|money(null, 0), rate: position.chargePerUnit|mileage_rate(currency), unit: ('finance.mileage.unit.' ~ unit.value)|trans}) }}{% endif -%}
    {%- elseif position.projectedKm is not null -%}
        {{ 'finance.mileage.under'|trans({under: position.underKm()|about_distance(unit)}) }}
    {%- elseif position.distanceKm is not null -%}
        {{ 'finance.mileage.so_far'|trans({distance: position.distanceKm|distance(0, unit), allowance: position.allowanceKm|distance(0, unit)}) }}
    {%- else -%}
        {{ 'finance.mileage.no_readings'|trans({allowance: position.allowanceKm|distance(0, unit)}) }}
    {%- endif -%}
{%- endmacro %}
