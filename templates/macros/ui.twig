{#
 # Shared UI fragments. Import with: {% import 'macros/ui.twig' as ui %}
 #}

{# Decorative icon from the vendored Material Symbols sprite (assets/vendor/icons.svg).
   Names must be listed in bin/vendor-assets.mjs. Give the surrounding control
   its own accessible name; the icon is hidden from assistive tech. #}
{% macro icon(name, class = '') -%}
    <svg class="icon{{ class ? ' ' ~ class }}" aria-hidden="true" focusable="false"><use href="{{ asset('vendor/icons.svg') }}#{{ name }}"></use></svg>
{%- endmacro %}

{# A person's avatar (spec.md §7.9 *Avatars*, Phase 33.1): their picture, or
   their initials on a colour taken from their id. `user` is a User; size
   is 'xs' (20 px, "added by"), 'sm' (32 px, lists) or 'md' (48 px, Settings). Decorative: the name
   is always shown beside it. #}
{% macro avatar(user, size = 'sm') -%}
    {% if user.avatarPath %}
        <img class="avatar avatar--{{ size }}" src="{{ url_for('users.avatar', {member: user.id}, {v: user.avatarUpdatedAt ? user.avatarUpdatedAt|date('U') : '0'}) }}" alt="" width="{{ {xs: 20, sm: 32, md: 48}[size] }}" height="{{ {xs: 20, sm: 32, md: 48}[size] }}" loading="lazy" decoding="async">
    {% else %}
        {% set words = user.displayName|trim|split(' ')|filter(w => w != '') %}
        {% set initials = (words|first|default(user.username))|slice(0, 1) ~ (words|length > 1 ? (words|last)|slice(0, 1) : '') %}
        <span class="avatar avatar--{{ size }} avatar--tone-{{ user.id % 6 }}" aria-hidden="true">{{ initials|upper }}</span>
    {% endif %}
{%- endmacro %}

{# Brand lock-up: mark + two-tone wordmark, linking to the dashboard. #}
{% macro brand() -%}
    <a class="brand" href="{{ url_for('home') }}">
        <img class="brand__mark" src="{{ asset('images/logbook-mark.png') }}" alt="" width="256" height="242">
        <span class="brand__wordmark"><span class="visually-hidden">{{ 'app.name'|trans }}</span><span aria-hidden="true">{{ 'brand.wordmark_lead'|trans }}<span class="brand__wordmark-tail">{{ 'brand.wordmark_tail'|trans }}</span></span></span>
    </a>
{%- endmacro %}

{# The signed-out pages' brand, centred above their card (spec.md §7.9
   *Signed-out pages*). Hidden by CSS when signed in: the sidebar has one. #}
{% macro auth_brand() -%}
    <p class="auth__brand">
        <img class="auth__mark" src="{{ asset('images/logbook-mark.png') }}" alt="" width="256" height="242">
        <span class="brand__wordmark auth__wordmark"><span class="visually-hidden">{{ 'app.name'|trans }}</span><span aria-hidden="true">{{ 'brand.wordmark_lead'|trans }}<span class="brand__wordmark-tail">{{ 'brand.wordmark_tail'|trans }}</span></span></span>
    </p>
{%- endmacro %}

{# A live checklist of the app's own password rules under a new-password
   pair (spec.md §7.9 *Signed-out pages*); JS only, the server still
   decides. `password` and `confirm` are the two fields' names. #}
{% macro password_rules(password, confirm) -%}
    {% import _self as ui %}
    <ul class="password-rules" data-password-rules data-password="{{ password }}" data-confirm="{{ confirm }}" data-met="{{ 'auth.rules.met'|trans }}" data-unmet="{{ 'auth.rules.unmet'|trans }}" hidden>
        <li data-rule="length" data-min="8">{{ ui.icon('radio_button_unchecked', 'password-rules__off') }}{{ ui.icon('check_circle', 'password-rules__on') }}<span>{{ 'auth.rules.length'|trans({min: 8}) }}</span><span class="visually-hidden" data-rule-state></span></li>
        <li data-rule="match">{{ ui.icon('radio_button_unchecked', 'password-rules__off') }}{{ ui.icon('check_circle', 'password-rules__on') }}<span>{{ 'auth.rules.match'|trans }}</span><span class="visually-hidden" data-rule-state></span></li>
    </ul>
{%- endmacro %}

{# Theme toggle; hidden until js/theme.js enables it. `compact` = icon only.
   Signed in, it is a small form that saves the preference (theme.js fills in
   the value); signed out, theme.js remembers the choice per browser. #}
{% macro theme_toggle(class = 'btn', compact = false, signed_in = false, csrf = null, return_to = '') -%}
    {% import _self as ui %}
    {% set button %}
        <button type="{{ signed_in ? 'submit' : 'button' }}" class="{{ class }}" data-theme-toggle hidden>
            <span class="theme-toggle__to-dark">{{ ui.icon('dark_mode') }}<span{% if compact %} class="visually-hidden"{% endif %}>{{ 'theme.to_dark'|trans }}</span></span>
            <span class="theme-toggle__to-light">{{ ui.icon('light_mode') }}<span{% if compact %} class="visually-hidden"{% endif %}>{{ 'theme.to_light'|trans }}</span></span>
        </button>
    {% endset %}
    {% if signed_in %}
        <form method="post" action="{{ url_for('settings.theme') }}" class="theme-toggle-form" data-theme-form>
            {{ ui.csrf(csrf) }}
            <input type="hidden" name="theme" value="system" data-theme-value>
            <input type="hidden" name="return_to" value="{{ return_to }}">
            {{ button }}
        </form>
    {% else %}
        {{ button }}
    {% endif %}
{%- endmacro %}

{# Hidden CSRF fields; put inside every POST form. #}
{% macro csrf(csrf) -%}
    {% if csrf %}
        <input type="hidden" name="{{ csrf.name_key }}" value="{{ csrf.name }}">
        <input type="hidden" name="{{ csrf.value_key }}" value="{{ csrf.value }}">
    {% endif %}
{%- endmacro %}

{# Keeps the page a form was opened from (a validated `return`, spec.md §5),
   so saving goes back there. #}
{% macro return_field(return_to) -%}
    {% if return_to %}<input type="hidden" name="return" value="{{ return_to }}">{% endif %}
{%- endmacro %}

{# A drop zone around a file input (spec.md §7.12, Phase 21.1): `input` is
   the plain <input type="file"> markup, which stays as it is and works
   without JS; js/file-drop.js adds the drop target, the list of chosen
   files and the announcements. opts: max_mb (the size limit checked before
   submitting), type_message (the `upload.file.*` key for a wrong type,
   default not_a_document). Whether it takes several files comes from the
   input's own `multiple`. #}
{% macro file_drop(input, opts = {}) -%}
    {% set multiple = ' multiple' in (input ~ '') %}
    {% set strings = {
        prompt: (multiple ? 'upload.drop.prompt' : 'upload.drop.prompt_one')|trans,
        choose: (multiple ? 'upload.drop.choose' : 'upload.drop.choose_one')|trans,
        over: 'upload.drop.over'|trans,
        remove_label: 'upload.drop.remove_label'|trans,
        remove: 'upload.drop.remove'|trans({name: '{name}'}),
        removed: 'upload.drop.removed'|trans({name: '{name}'}),
        added_one: 'upload.drop.added_one'|trans({count: '{count}'}),
        added_other: 'upload.drop.added_other'|trans({count: '{count}'}),
        chosen: 'upload.drop.chosen'|trans({name: '{name}'}),
        type: ('upload.file.' ~ (opts.type_message ?? 'not_a_document'))|trans({name: '{name}'}),
        size: 'upload.file.too_large'|trans({name: '{name}', max: opts.max_mb ?? 0}),
        b: 'units.file.b'|trans({value: '{value}'}),
        kb: 'units.file.kb'|trans({value: '{value}'}),
        mb: 'units.file.mb'|trans({value: '{value}'}),
    } %}
    <div class="file-drop" data-file-drop data-file-drop-max-mb="{{ opts.max_mb ?? 0 }}" data-file-drop-strings="{{ strings|json_encode }}">
        {{- input -}}
    </div>
{%- endmacro %}

{# Error message for a field, from the `errors` map a form Action passes in. #}
{% macro field_error(errors, name) -%}
    {% set error = errors[name] ?? null %}
    {% if error %}<p class="field__error" id="f-{{ name }}-error">{{ trans(error.key, error.params) }}</p>{% endif %}
{%- endmacro %}

{# aria attributes linking an input to its hint, a scan's note (pass values) and error. #}
{% macro described_by(name, errors, hint, values = null) -%}
    {% import _self as ui %}
    {% set ids = [] %}
    {% if hint %}{% set ids = ids|merge(['f-' ~ name ~ '-hint']) %}{% endif %}
    {% if values is not null and ui.has_scan_note(name, values)|trim == '1' %}{% set ids = ids|merge(['f-' ~ name ~ '-scan']) %}{% endif %}
    {% if errors[name] ?? null %}{% set ids = ids|merge(['f-' ~ name ~ '-error']) %}{% endif %}
    {% if ids is not empty %} aria-describedby="{{ ids|join(' ') }}"{% endif %}{% if errors[name] ?? null %} aria-invalid="true"{% endif %}
{%- endmacro %}

{# "from your message" beside a field an Ask draft filled in (spec.md §7.26 *Edit*),
   "from the file, check" beside one a scan filled in (§7.27). #}
{% macro from_message(name, values) -%}
    {% if name in ((values._from_message ?? '')|split(',')) %} <span class="field__from-message">{{ 'ask.draft.from_message'|trans }}</span>{% endif %}
    {%- if name in ((values._from_file ?? '')|split(',')) %} <span class="field__from-message field__from-file">{{ 'scan.from_file'|trans }}</span>{% endif %}
{%- endmacro %}

{# Under a field a scan touched (spec.md §7.27): the words its value came
   from, the date to check, why it was left empty, or a suggestion. #}
{% macro scan_note(name, values) -%}
    {% import _self as ui %}
    {% set evidence = values['_evidence:' ~ name] ?? null %}
    {% set check = values['_check:' ~ name] ?? null %}
    {% set problem = values['_problem:' ~ name] ?? null %}
    {% set hint = values['_hint:' ~ name] ?? null %}
    {% if evidence or check or problem or hint %}
        <div class="field__scan" id="f-{{ name }}-scan">
            {% if evidence %}<p class="field__evidence">{{ ui.icon('receipt_long') }}<span><span class="visually-hidden">{{ 'scan.evidence_label'|trans }} </span>“{{ evidence }}”</span></p>{% endif %}
            {% if check %}<p class="field__check">{{ ui.icon('warning') }}<span>{{ check }}</span></p>{% endif %}
            {% if problem %}<p class="field__check">{{ ui.icon('warning') }}<span>{{ problem }}</span></p>{% endif %}
            {% if hint %}<p class="field__hint">{{ hint }}</p>{% endif %}
        </div>
    {% endif %}
{%- endmacro %}

{# Whether a scan left a note under the field (for aria-describedby). #}
{% macro has_scan_note(name, values) -%}
    {{- (values['_evidence:' ~ name] ?? values['_check:' ~ name] ?? values['_problem:' ~ name] ?? values['_hint:' ~ name] ?? null) ? '1' : '' -}}
{%- endmacro %}

{# Label + input + hint + error.
   opts: type, required, optional (shows "optional"), hint, autocomplete, inputmode,
         step, min, max, maxlength, suffix (unit shown after the input), placeholder, readonly #}
{% macro input(name, label, values, errors, opts = {}) -%}
    {% import _self as ui %}
    {% set hint = opts.hint ?? null %}
    <div class="field">
        <label class="field__label" for="f-{{ name }}">{{ label }}{% if opts.optional ?? false %} <span class="field__optional">{{ 'form.optional'|trans }}</span>{% endif %}{{ ui.from_message(name, values) }}</label>
        {% set reveal = (opts.type ?? 'text') == 'password' %}
        {% if opts.suffix ?? null %}<div class="input-group">{% endif %}
        {% if reveal %}<div class="input-reveal">{% endif %}
        <input class="input" id="f-{{ name }}" name="{{ name }}" type="{{ opts.type ?? 'text' }}"
            {%- if opts.type ?? 'text' != 'password' %} value="{{ values[name] ?? '' }}"{% endif %}
            {%- if opts.required ?? false %} required{% endif %}
            {%- if opts.autocomplete ?? null %} autocomplete="{{ opts.autocomplete }}"{% endif %}
            {%- if opts.inputmode ?? null %} inputmode="{{ opts.inputmode }}"{% endif %}
            {%- if opts.step ?? null %} step="{{ opts.step }}"{% endif %}
            {%- if (opts.min ?? null) is not null %} min="{{ opts.min }}"{% endif %}
            {%- if (opts.max ?? null) is not null %} max="{{ opts.max }}"{% endif %}
            {%- if opts.maxlength ?? null %} maxlength="{{ opts.maxlength }}"{% endif %}
            {%- if opts.placeholder ?? null %} placeholder="{{ opts.placeholder }}"{% endif %}
            {%- if opts.readonly ?? false %} readonly{% endif %}
            {{- ui.described_by(name, errors, hint, values) }}>
        {% if reveal %}
            {# Show / hide (spec.md §7.9): added by JS, so without it this is a plain field. #}
            <button type="button" class="input-reveal__btn" data-password-reveal aria-controls="f-{{ name }}" aria-pressed="false" hidden>{{ ui.icon('visibility', 'input-reveal__show') }}{{ ui.icon('visibility_off', 'input-reveal__hide') }}<span class="visually-hidden">{{ 'auth.password_reveal'|trans }}</span></button>
        </div>
        {% endif %}
        {% if opts.suffix ?? null %}<span class="input-group__suffix" aria-hidden="true">{{ opts.suffix }}</span></div>{% endif %}
        {% if hint %}<p class="field__hint" id="f-{{ name }}-hint">{{ hint }}</p>{% endif %}
        {{ ui.scan_note(name, values) }}
        {{ ui.field_error(errors, name) }}
    </div>
{%- endmacro %}

{# Label + select + error. options: list of {value, label}. #}
{% macro select(name, label, values, errors, options, opts = {}) -%}
    {% import _self as ui %}
    {% set hint = opts.hint ?? null %}
    {% set current = values[name] ?? '' %}
    <div class="field">
        <label class="field__label" for="f-{{ name }}">{{ label }}{{ ui.from_message(name, values) }}</label>
        <select class="select" id="f-{{ name }}" name="{{ name }}"{% if opts.required ?? false %} required{% endif %}{{ ui.described_by(name, errors, hint, values) }}>
            {% for option in options %}
                <option value="{{ option.value }}"{% if option.value == current %} selected{% endif %}>{{ option.label }}</option>
            {% endfor %}
        </select>
        {% if hint %}<p class="field__hint" id="f-{{ name }}-hint">{{ hint }}</p>{% endif %}
        {{ ui.scan_note(name, values) }}
        {{ ui.field_error(errors, name) }}
    </div>
{%- endmacro %}

{# Time-zone picker grouped by region (FormOptions::timezones()). #}
{% macro timezone_select(values, errors, groups, detect = false) -%}
    {% import _self as ui %}
    {% set current = values.timezone ?? '' %}
    <div class="field">
        <label class="field__label" for="f-timezone">{{ 'prefs.timezone'|trans }}</label>
        <select class="select" id="f-timezone" name="timezone" required{% if detect %} data-detect-timezone{% endif %}{{ ui.described_by('timezone', errors, true) }}>
            {% for region, zones in groups %}
                <optgroup label="{{ region }}">
                    {% for zone in zones %}
                        <option value="{{ zone }}"{% if zone == current %} selected{% endif %}>{{ zone|replace({'_': ' '}) }}</option>
                    {% endfor %}
                </optgroup>
            {% endfor %}
        </select>
        <p class="field__hint" id="f-timezone-hint">{{ 'prefs.timezone_hint'|trans }}</p>
        {{ ui.field_error(errors, 'timezone') }}
    </div>
{%- endmacro %}

{# A group of radio chips. options: list of {value, label, icon?}. #}
{% macro chips(name, legend, values, errors, options, opts = {}) -%}
    {% import _self as ui %}
    {% set current = values[name] ?? '' %}
    <fieldset class="field fieldset"{% if errors[name] ?? null %} aria-describedby="f-{{ name }}-error"{% endif %}>
        <legend class="field__label">{{ legend }}</legend>
        {# `segmented`: one control of a few options (System / Light / Dark), as the prototype draws the theme. #}
        <div class="{{ (opts.segmented ?? false) ? 'segmented' : 'chip-row' }}">
            {% for option in options %}
                <label class="{{ (opts.segmented ?? false) ? 'segmented__option' : 'chip' }}">
                    <input type="radio" name="{{ name }}" value="{{ option.value }}"{% if option.value == current %} checked{% endif %}{% if opts.required ?? false %} required{% endif %}{% if opts.data ?? null %} {{ opts.data }}{% endif %}>
                    {% if option.icon ?? null %}{{ ui.icon(option.icon) }}{% endif %}
                    <span>{{ option.label }}</span>
                </label>
            {% endfor %}
        </div>
        {% if opts.hint ?? null %}<p class="field__hint">{{ opts.hint }}</p>{% endif %}
        {{ ui.field_error(errors, name) }}
    </fieldset>
{%- endmacro %}

{# "Added by" (spec.md §7.21) under an entry someone else added, once the
   vehicle has anyone on it but its owner; nothing otherwise. #}
{% macro added_by(vehicle, created_by) -%}
    {% import _self as ui %}
    {% set by = added_by(vehicle, created_by) %}
    {% if by is not null %}
        {% set author = by == '' ? null : added_by_user(vehicle, created_by) %}
        <span class="list__meta added-by">{{ author ? ui.avatar(author, 'xs') : ui.icon('person') }}{{ by == '' ? 'sharing.added_by_former'|trans : 'sharing.added_by'|trans({name: by}) }}</span>
    {% endif %}
{%- endmacro %}

{# Under a fleet cost figure (spec.md §7.21): how many vehicles it leaves
   out because they are shared without costs; nothing when none. #}
{% macro costs_excluded_note() -%}
    {% import _self as ui %}
    {% set excluded = costs_excluded() %}
    {% if excluded > 0 %}<p class="field__hint costs-excluded">{{ ui.icon('info') }}{{ 'sharing.excludes'|trans({count: excluded}) }}</p>{% endif %}
{%- endmacro %}

{# Flash messages queued with Session::flash(). #}
{% macro flashes(flashes) -%}
    {% import _self as ui %}
    {% for flash in flashes %}
        <div class="alert alert--{{ flash.type }}" role="{{ flash.type == 'error' ? 'alert' : 'status' }}">
            {{ ui.icon(flash.type == 'success' ? 'check_circle' : (flash.type == 'error' ? 'error' : (flash.type == 'warning' ? 'warning' : 'info'))) }}
            <span>{{ trans(flash.key, flash.params) }}</span>
        </div>
    {% endfor %}
{%- endmacro %}

{# Vehicle photo, or a striped placeholder with the vehicle-type icon. #}
{% macro vehicle_photo(vehicle, class = '') -%}
    {% import _self as ui %}
    <div class="vehicle-photo{{ class ? ' ' ~ class }}">
        {% if vehicle.hasPhoto() %}
            <img src="{{ url_for('vehicles.photo', {id: vehicle.id}, {v: vehicle.photoVersion()}) }}" alt="{{ 'vehicle.photo_alt'|trans({name: vehicle.name()}) }}" loading="lazy">
        {% else %}
            <span class="vehicle-photo__placeholder">{{ ui.icon(vehicle.data.type.icon()) }}</span>
        {% endif %}
    </div>
{%- endmacro %}

{# A registration as a number plate (spec.md §8 *Registration plate*): size
   'sm' (lists, pickers, over a photo) or 'md' (cards, the vehicle header);
   style 'gb' or 'neutral', the owner's, from plate_style(vehicle). Nothing
   for a blank registration. The band is hidden from screen readers and
   from copying, so both get the registration only. #}
{% macro plate(registration, size = 'sm', style = 'neutral') -%}
    {%- set text = plate_text(registration) -%}
    {%- set style = style == 'gb' ? 'gb' : 'neutral' -%}
    {%- if text != '' -%}
        <span class="plate plate--{{ size == 'md' ? 'md' : 'sm' }} plate--{{ style }}"{% if text|length > 10 %} title="{{ text }}"{% endif %}>
            {%- if style == 'gb' %}<span class="plate__band" aria-hidden="true">UK</span>{% endif -%}
            <span class="plate__text">{{ text }}</span></span>
    {%- endif -%}
{%- endmacro %}

{# What a vehicle's due count means, in words: "2 overdue, 1 due soon" or
   "All up to date". `count` is a Service\Reminder\VehicleDueCount. #}
{% macro due_text(count) -%}
    {%- set parts = [] -%}
    {%- if count.overdue > 0 %}{% set parts = parts|merge(['nav.status.overdue'|trans({count: count.overdue})]) %}{% endif -%}
    {%- if count.due > 0 %}{% set parts = parts|merge(['nav.status.due'|trans({count: count.due})]) %}{% endif -%}
    {{- parts is empty ? 'nav.status.ok'|trans : parts|join(', ') -}}
{%- endmacro %}

{# Status dot (red / amber / green) with its meaning as a tooltip and for
   screen readers: never colour alone (spec.md §8). #}
{% macro status_dot(count) -%}
    {% import _self as ui %}
    {% set text = ui.due_text(count) %}
    <span class="status-dot status-dot--{{ count.tone() }}" title="{{ text }}" aria-hidden="true"></span><span class="visually-hidden">{{ text }}</span>
{%- endmacro %}

{# "N due" badge (overdue + due soon; red when any is overdue); nothing at zero. #}
{% macro due_badge(count, class = '') -%}
    {% import _self as ui %}
    {% if count.total() > 0 %}
        <span class="due-badge due-badge--{{ count.tone() }}{{ class ? ' ' ~ class }}" title="{{ ui.due_text(count) }}">{{ 'garage.due_count'|trans({count: count.total()}) }}</span>
    {% endif %}
{%- endmacro %}

{# A stacked bar of cost parts (spec.md §7.7, §7.35): `parts` is a list of
   {part, percent}, each part with a colour token (part.color()). Hidden
   from assistive technology: the legend beside it carries the figures. #}
{% macro cost_bar(parts, class = '') -%}
    {%- if parts is not empty -%}
        <div class="stack-bar{{ class ? ' ' ~ class }}" aria-hidden="true">
            {%- for segment in parts -%}
                <span class="stack-bar__part" style="--w: {{ segment.percent|round(1) }}%; --swatch: var(--{{ segment.part.color() }})"></span>
            {%- endfor -%}
        </div>
    {%- endif -%}
{%- endmacro %}

{# Figure tile: label, big value, optional caption. `tone`: '', 'good'. #}
{% macro stat(label, value, sub = '', tone = '') -%}
    <div class="stat{{ tone ? ' stat--' ~ tone }}">
        <dt class="stat__label">{{ label }}</dt>
        <dd class="stat__value tabular">{{ value }}</dd>
        {% if sub %}<dd class="stat__sub">{{ sub }}</dd>{% endif %}
    </div>
{%- endmacro %}

{# A LineChart drawn by js/app.js with Chart.js. Hidden without JS: every
   chart sits next to a list with the same figures. #}
{% macro chart(chart, label) -%}
    <div class="chart">
        <canvas data-chart="{{ chart|json_encode }}" role="img" aria-label="{{ label }}"></canvas>
    </div>
{%- endmacro %}

{# A LineChart's figures as a table (spec.md §8 *Printing reports*): for a
   chart whose page has no table of its own. Print-only: the screen keeps
   the chart and the page's own list. #}
{% macro chart_table(chart, label) -%}
    <div class="table-wrap print-only">
        <table class="table chart-print-table">
            <caption class="chart-print-table__unit">{{ label }} · {{ chart.unitLabel() }}</caption>
            <thead>
                <tr>
                    <th scope="col">{{ 'print.chart_date'|trans }}</th>
                    {% for series in chart.seriesLabels() %}
                        <th scope="col" class="table__num">{{ series }}</th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody>
                {% for row in chart.rows() %}
                    <tr>
                        <th scope="row">{{ chart.hasCalendarDates() ? row.at|local_date : row.at|instant_date }}</th>
                        {% for value in row.values %}
                            <td class="table__num tabular">{{ value is null ? '—' : value|chart_value(chart.decimals(), chart.currency()) }}</td>
                        {% endfor %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{%- endmacro %}

{# The Print button (History's print view, the sale pack, the report pages;
   spec.md §8 *Printing reports*): js/app.js shows it and calls
   window.print(); without JS it stays hidden and the browser's own Print
   does the same. primary: false where printing isn't the page's main
   action (the Finance tab). #}
{% macro print_button(primary = true) -%}
    {% import _self as ui %}
    <button type="button" class="btn{{ primary ? ' btn--primary' }}" data-print hidden>{{ ui.icon('print') }}{{ 'history.print'|trans }}</button>
{%- endmacro %}

{# Previous / next links for a Support\View\Pagination. `query` keeps other
   parameters (e.g. a filter) on the links. #}
{% macro pagination(pagination, route, params, query = {}) -%}
    {% import _self as ui %}
    {% if pagination.pages() > 1 %}
        <nav class="pagination" aria-label="{{ 'pagination.label'|trans }}">
            {% if pagination.hasPrevious() %}
                <a class="btn" rel="prev" href="{{ url_for(route, params, query|merge(pagination.page > 2 ? {page: pagination.page - 1} : {})) }}">{{ ui.icon('chevron_left') }}{{ 'pagination.newer'|trans }}</a>
            {% endif %}
            <span class="pagination__status muted">{{ 'pagination.status'|trans({first: pagination.first(), last: pagination.last(), total: pagination.total}) }}</span>
            {% if pagination.hasNext() %}
                <a class="btn" rel="next" href="{{ url_for(route, params, query|merge({page: pagination.page + 1})) }}">{{ 'pagination.older'|trans }}{{ ui.icon('chevron_right') }}</a>
            {% endif %}
        </nav>
    {% endif %}
{%- endmacro %}
